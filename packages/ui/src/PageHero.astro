---
/**
 * Full-bleed photo hero with overlay title — the website's page hero
 * (see apps/website/src/pages/growkits.astro). Redesign: Fraunces headline,
 * Bricolage text, ink border. Pass the image as the default
 * slot (give it class="hero-image") and optional buttons in slot="actions".
 */
interface Props {
  /** Sachliche, keyword-haltige Überschrift (die H1 der Seite) */
  title: string;
  /**
   * Optionaler großer Spruch. Dann wird `title` als kleine Eyebrow-Zeile
   * (weiterhin die H1) und der Spruch groß als <p> gesetzt (SEO-Muster).
   */
  headline?: string;
  subtitle?: string;
  as?: "h1" | "h2";
  /** Lower hero for listing pages where content should be visible quickly */
  compact?: boolean;
}

const { title, headline, subtitle, as: Tag = "h1", compact = false } = Astro.props;
---
<section class:list={["hero", { compact }]}>
  <slot />
  <div class="hero-overlay">
    {
      headline ? (
        <>
          <Tag class="hero-eyebrow eyebrow">{title}</Tag>
          <p class="hero-title">{headline}</p>
        </>
      ) : (
        <Tag class="hero-title">{title}</Tag>
      )
    }
    {subtitle && <p class="hero-subtitle">{subtitle}</p>}
    {Astro.slots.has("actions") && (
      <div class="hero-actions">
        <slot name="actions" />
      </div>
    )}
  </div>
</section>

<style>
  .hero {
    position: relative;
    width: calc(100vw - var(--scrollbar-width, 0px));
    height: min(70vh, 640px);
    min-height: 360px;
    margin-left: calc(50% - (100vw - var(--scrollbar-width, 0px)) / 2);
    margin-top: -1.5rem;
    overflow: hidden;
    border-bottom: 3px solid var(--color-ink);
  }

  .hero.compact {
    height: min(40vh, 380px);
    min-height: 260px;
  }

  .hero::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.55) 0%,
      rgba(0, 0, 0, 0.15) 40%,
      transparent 70%
    );
    pointer-events: none;
    z-index: 1;
  }

  .hero :global(.hero-image) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 2;
    padding: 3rem 2rem;
    text-align: center;
  }

  .hero-eyebrow {
    margin: 0 auto 0.6rem;
    color: var(--color-accent-light);
    font-size: 0.875rem;
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.5);
  }

  .hero-title {
    max-width: 16ch;
    margin: 0 auto 0.6rem;
    font-family: var(--font-display);
    font-weight: 900;
    font-variation-settings: "SOFT" 100, "WONK" 1;
    font-size: clamp(2.5rem, 7vw, 5.5rem);
    line-height: 0.92;
    color: #fff;
    text-wrap: balance;
    text-shadow: 0 2px 14px rgba(0, 0, 0, 0.45);
  }

  .hero-subtitle {
    max-width: 550px;
    margin: 0 auto;
    font-size: clamp(1rem, 1.5vw, 1.2rem);
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.95);
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.45);
  }

  .hero-actions {
    margin-top: 1.5rem;
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  /* Secondary buttons need a solid background on top of the photo */
  .hero-actions :global(.btn--secondary),
  .hero-actions :global(.btn-outline) {
    background: var(--color-cream);
  }

  @media (max-width: 768px) {
    .hero {
      margin-top: -1rem;
    }

    .hero-overlay {
      padding: 2rem 1rem;
    }
  }
</style>
