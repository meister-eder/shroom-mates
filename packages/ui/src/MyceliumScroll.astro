---
/**
 * Mycelium that grows in from both page edges while scrolling (Redesign 2026,
 * prototype "Myzel-Faden"): white strands with a soft periwinkle glow, drawn
 * progressively via stroke-dashoffset. Sits behind the page content (z-index
 * -1), so dark bands cover it. Static (fully grown) with reduced motion.
 *
 *   <MyceliumScroll />
 */
---

<div class="myceli" data-myceli aria-hidden="true"></div>

<style is:global>
  /* own stacking context so z-index -1 sits above the body background, below the content */
  main:has(> .myceli) {
    position: relative;
    z-index: 0;
  }
</style>

<style>
  .myceli {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 0;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
  }

  .myceli :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }

  @media (max-width: 768px) {
    .myceli {
      opacity: 0.7;
    }
  }
</style>

<script>
  const NS = "http://www.w3.org/2000/svg";
  const rnd = (i: number) => {
    const v = Math.sin(i * 91.7 + 17.3) * 43758.5453;
    return v - Math.floor(v);
  };
  const clamp = (v: number) => Math.max(0, Math.min(1, v));

  type Strand = { el: SVGPathElement; t: number };

  function build(root: HTMLElement) {
    const host = root.parentElement as HTMLElement;
    const W = host.clientWidth;
    const H = host.scrollHeight;
    const sx = W / 1440;
    root.style.height = `${H}px`;
    root.innerHTML = "";

    const svg = document.createElementNS(NS, "svg");
    svg.setAttribute("viewBox", `0 0 ${W} ${H}`);
    svg.setAttribute("preserveAspectRatio", "none");
    svg.innerHTML =
      '<defs><filter id="myc" x="-5%" y="-2%" width="110%" height="104%"><feTurbulence type="fractalNoise" baseFrequency="0.012 0.02" numOctaves="3" seed="7" result="n"/><feDisplacementMap in="SourceGraphic" in2="n" scale="26" xChannelSelector="R" yChannelSelector="G"/></filter></defs>';
    const glow = document.createElementNS(NS, "g");
    glow.setAttribute("fill", "none");
    glow.setAttribute("stroke", "#9fa2f7");
    glow.setAttribute("stroke-linecap", "round");
    glow.setAttribute("opacity", ".35");
    const g = document.createElementNS(NS, "g");
    g.setAttribute("filter", "url(#myc)");
    g.setAttribute("fill", "none");
    g.setAttribute("stroke", "#fff");
    g.setAttribute("stroke-linecap", "round");
    svg.append(glow, g);
    root.append(svg);

    const strands: Strand[] = [];
    const add = (d: string, w: number, t: number) => {
      const mk = (parent: SVGElement, width: number) => {
        const p = document.createElementNS(NS, "path");
        p.setAttribute("d", d);
        p.setAttribute("pathLength", "1");
        p.setAttribute("stroke-width", String(width));
        p.setAttribute("stroke-dasharray", "1 1");
        p.setAttribute("stroke-dashoffset", "1");
        parent.append(p);
        return p;
      };
      const a = mk(glow, w * 5);
      const b = mk(g, w);
      strands.push({ el: a, t }, { el: b, t });
    };

    const walk = (x: number, y: number, ang: number, n: number, seg: number, id: number, w: number, t: number, depth: number) => {
      let d = `M${x.toFixed(0)} ${y.toFixed(0)}`;
      let px = x;
      let py = y;
      let a = ang;
      for (let k = 0; k < n; k++) {
        a += (rnd(id * 13 + k * 7) - 0.5) * 1.3;
        const len = seg * (0.7 + rnd(id * 5 + k) * 0.6) * sx;
        const nx = px + Math.cos(a) * len;
        const ny = py + Math.sin(a) * len;
        d += ` Q${((px + nx) / 2 + (rnd(id + k) - 0.5) * 30).toFixed(0)} ${((py + ny) / 2 + (rnd(id * 3 + k) - 0.5) * 30).toFixed(0)} ${nx.toFixed(0)} ${ny.toFixed(0)}`;
        if (depth < 2 && k >= 1 && k < n - 1 && rnd(id * 17 + k * 3) > 0.45) {
          walk(nx, ny, a + (rnd(id + k * 11) > 0.5 ? 0.9 : -0.9), Math.max(2, n - k), seg * 0.8, id * 31 + k + 1, Math.max(0.6, w * 0.65), t + 0.012 * (k + 1), depth + 1);
        }
        px = nx;
        py = ny;
      }
      add(d, w, t);
    };

    const count = Math.max(8, Math.round(H / 115));
    for (let k = 0; k < count; k++) {
      const left = k % 2 === 0;
      const y0 = 120 + k * (H - 240) / count + rnd(k) * 50;
      walk(
        left ? -20 : W + 20,
        y0,
        left ? 0.15 + rnd(k + 3) * 0.5 : Math.PI - 0.15 - rnd(k + 3) * 0.5,
        7,
        85,
        k + 1,
        1.6 + rnd(k + 8) * 0.9,
        Math.max(0, y0 / H - 0.03),
        0,
      );
    }
    return strands;
  }

  function init() {
    const root = document.querySelector<HTMLElement>("[data-myceli]");
    if (!root) return;
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    let strands = build(root);
    let frame = 0;
    const draw = () => {
      frame = 0;
      const host = root.parentElement as HTMLElement;
      const H = host.scrollHeight;
      const top = host.getBoundingClientRect().top + window.scrollY;
      const p = reduce ? 1 : (window.scrollY + innerHeight * 0.75 - top) / H;
      for (const s of strands) {
        s.el.setAttribute("stroke-dashoffset", (1 - clamp((p - s.t) / 0.07)).toFixed(3));
      }
    };
    const schedule = () => {
      if (!frame) frame = requestAnimationFrame(draw);
    };
    addEventListener("scroll", schedule, { passive: true });
    addEventListener("resize", () => {
      strands = build(root);
      schedule();
    });
    // images load late and change the page height
    addEventListener("load", () => {
      strands = build(root);
      schedule();
    });
    draw();
  }

  document.addEventListener("astro:page-load", init);
  if (document.readyState !== "loading") init();
  else document.addEventListener("DOMContentLoaded", init);
</script>
