---
/**
 * Mycelium that grows behind the page while scrolling (Redesign 2026,
 * prototype "Myzel-Faden"): a main cord snaking down the page with a hyphal
 * network sprouting from it. A deterministic growth simulation
 * (src/mycelium/grow.ts) runs once per page width; its segments are revealed
 * as the scroll position moves the growth front down the page and are drawn
 * incrementally into canvas tiles that only exist near the viewport. A
 * viewport-sized overlay highlights the growing tips at the front.
 *
 * Sits behind the page content (z-index -1), so opaque bands cover it. Growth
 * never recedes when scrolling back up. With reduced motion the network is
 * shown fully grown without animation.
 *
 *   <MyceliumScroll />
 */
---

<div class="myceli" data-myceli aria-hidden="true"></div>

<style is:global>
  /* own stacking context so z-index -1 sits above the body background, below the content */
  main:has(> .myceli) {
    position: relative;
    z-index: 0;
  }
</style>

<style>
  .myceli {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 0;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
    contain: strict;
  }

  .myceli :global(canvas) {
    position: absolute;
    left: 0;
    display: block;
    width: 100%;
  }

  .myceli :global(canvas.myceli__tips) {
    top: 0;
    z-index: 1;
    will-change: transform;
  }
</style>

<script>
  import { grow, type Network } from "./mycelium/grow";
  import { drawEntries, drawTips } from "./mycelium/render";

  const TILE = 640; // CSS px per canvas tile
  const KEEP = 1.0; // viewports around the visible area that keep their tiles

  type Tile = {
    top: number;
    h: number;
    idx: Int32Array; // entry ids touching this tile, sorted by key
    keys: Float32Array;
    canvas: HTMLCanvasElement | null;
    ctx: CanvasRenderingContext2D | null;
    drawn: number; // idx[0..drawn) are on the canvas
  };

  function lowerBound(keys: Float32Array, v: number) {
    let lo = 0;
    let hi = keys.length;
    while (lo < hi) {
      const m = (lo + hi) >> 1;
      if (keys[m]! <= v) lo = m + 1;
      else hi = m;
    }
    return lo;
  }

  function init() {
    const root = document.querySelector<HTMLElement>("[data-myceli]");
    if (!root || root.dataset.ready) return;
    root.dataset.ready = "1";
    const host = root.parentElement as HTMLElement;
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const dpr = Math.min(2, window.devicePixelRatio || 1);

    let net: Network | null = null;
    let tiles: Tile[] = [];
    let builtW = 0;
    let builtH = 0;
    let target = 0; // furthest front position reached (page px inside main)
    let shown = 0; // animated front position
    let frame = 0;
    let tipCanvas: HTMLCanvasElement | null = null;

    // the simulation runs in a worker when possible (falls back to the main thread)
    let worker: Worker | null = null;
    let reqId = 0;
    const makeWorker = () => {
      try {
        worker = new Worker(new URL("./mycelium/worker.ts", import.meta.url), { type: "module" });
        worker.onmessage = (ev: MessageEvent<{ id: number; net: Network }>) => {
          if (ev.data.id === reqId) install(ev.data.net);
        };
        worker.onerror = () => {
          worker?.terminate();
          worker = null;
          build();
        };
      } catch {
        worker = null;
      }
    };

    const build = () => {
      const W = host.clientWidth;
      const H = host.scrollHeight;
      if (!W || !H) return;
      builtW = W;
      builtH = H;
      const compact = W < 760;
      if (worker) worker.postMessage({ id: ++reqId, W, H, compact });
      else install(grow(W, H, { compact }));
    };

    const install = (n: Network) => {
      const { H } = n;
      net = n;
      root.style.height = `${H}px`;
      root.replaceChildren();
      tipCanvas = null;
      if (!reduce) {
        tipCanvas = document.createElement("canvas");
        tipCanvas.className = "myceli__tips";
        root.append(tipCanvas);
      }

      // distribute entries over tiles (bbox + glow padding)
      const count = Math.ceil(H / TILE);
      const lists: number[][] = Array.from({ length: count }, () => []);
      const { pos, width, key } = n;
      for (let e = 0; e < n.count; e++) {
        const pad = width[e]! / 2 + 4;
        const y1 = Math.min(pos[e * 4 + 1]!, pos[e * 4 + 3]!) - pad;
        const y2 = Math.max(pos[e * 4 + 1]!, pos[e * 4 + 3]!) + pad;
        const a = Math.max(0, Math.floor(y1 / TILE));
        const b = Math.min(count - 1, Math.floor(y2 / TILE));
        for (let t = a; t <= b; t++) lists[t]!.push(e);
      }
      tiles = lists.map((list, i) => {
        const idx = Int32Array.from(list);
        const keys = new Float32Array(idx.length);
        for (let j = 0; j < idx.length; j++) keys[j] = key[idx[j]!]!;
        return { top: i * TILE, h: Math.min(TILE, H - i * TILE), idx, keys, canvas: null, ctx: null, drawn: 0 };
      });
      schedule();
    };

    const frontFromScroll = () => {
      const top = host.getBoundingClientRect().top;
      return -top + innerHeight * 0.78;
    };

    const ensure = (t: Tile) => {
      if (t.canvas) return;
      const c = document.createElement("canvas");
      c.width = Math.round(builtW * dpr);
      c.height = Math.round(t.h * dpr);
      c.style.top = `${t.top}px`;
      c.style.height = `${t.h}px`;
      const ctx = c.getContext("2d");
      if (!ctx) return;
      ctx.setTransform(dpr, 0, 0, dpr, 0, -t.top * dpr);
      root.append(c);
      t.canvas = c;
      t.ctx = ctx;
      t.drawn = 0;
    };

    const release = (t: Tile) => {
      if (!t.canvas) return;
      t.canvas.width = 0;
      t.canvas.remove();
      t.canvas = null;
      t.ctx = null;
      t.drawn = 0;
    };

    const paint = () => {
      if (!net) return;
      const top = host.getBoundingClientRect().top;
      const vis0 = -top - innerHeight * KEEP;
      const vis1 = -top + innerHeight * (1 + KEEP);
      for (const t of tiles) {
        if (t.top + t.h < vis0 || t.top > vis1) {
          release(t);
          continue;
        }
        const upto = lowerBound(t.keys, shown);
        if (upto <= t.drawn && t.canvas) continue;
        ensure(t);
        if (!t.ctx) continue;
        drawEntries(t.ctx, net, t.idx, t.drawn, upto, dpr);
        t.drawn = upto;
      }
      paintTips(-top);
    };

    // bright beads on the growing tips, redrawn per frame in a viewport-sized canvas
    const paintTips = (viewTop: number) => {
      const c = tipCanvas;
      if (!c || !net) return;
      const w = Math.round(builtW * dpr);
      const h = Math.round(innerHeight * dpr);
      if (c.width !== w || c.height !== h) {
        c.width = w;
        c.height = h;
        c.style.height = `${innerHeight}px`;
      }
      c.style.transform = `translateY(${viewTop}px)`;
      const ctx = c.getContext("2d");
      if (!ctx) return;
      ctx.setTransform(1, 0, 0, 1, 0, 0);
      ctx.clearRect(0, 0, w, h);
      ctx.setTransform(dpr, 0, 0, dpr, 0, -viewTop * dpr);
      drawTips(ctx, net, shown, viewTop - 20, viewTop + innerHeight + 20);
    };

    const tick = () => {
      frame = 0;
      if (!net) return;
      if (reduce) {
        shown = Infinity;
      } else {
        target = Math.max(target, frontFromScroll());
        // ease towards the scroll position so growth keeps creeping on briefly
        const d = target - shown;
        shown = d < 1 ? target : shown + Math.max(3, d * 0.16);
      }
      paint();
      if (shown < target) frame = requestAnimationFrame(tick);
    };
    const schedule = () => {
      if (!frame && !document.hidden) frame = requestAnimationFrame(tick);
    };

    // client-side navigation (ClientRouter) swaps the page: tear down
    const ac = new AbortController();
    const { signal } = ac;
    document.addEventListener("astro:before-swap", () => ac.abort(), { once: true });

    const start = () => {
      if (signal.aborted) return;
      makeWorker();
      build();
      schedule();
      addEventListener("scroll", schedule, { passive: true, signal });
      document.addEventListener("visibilitychange", schedule, { signal });

      // rebuild when the width changes or the page grows (late images/fonts);
      // height-only viewport changes (mobile URL bar) don't touch main's size
      let timer = 0;
      const ro = new ResizeObserver(() => {
        const W = host.clientWidth;
        const H = host.scrollHeight;
        if (W === builtW && Math.abs(H - builtH) < 80) return;
        clearTimeout(timer);
        timer = window.setTimeout(() => {
          build();
          schedule();
        }, 250);
      });
      ro.observe(host);
      signal.addEventListener("abort", () => {
        ro.disconnect();
        worker?.terminate();
        worker = null;
        clearTimeout(timer);
        cancelAnimationFrame(frame);
        frame = 0;
        net = null;
        tiles = [];
      });
    };

    // lazy: simulate once the browser is idle
    if ("requestIdleCallback" in window) requestIdleCallback(start, { timeout: 1200 });
    else setTimeout(start, 300);
  }

  document.addEventListener("astro:page-load", init);
  if (document.readyState !== "loading") init();
  else document.addEventListener("DOMContentLoaded", init);
</script>
