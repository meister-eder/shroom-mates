---
/**
 * Site footer shared by website and shop (Redesign 2026): night band, big
 * mushroom drawing, "Bis bald in der Glasfabrik!" and four link columns.
 *
 *   Website: <Footer app="website" />
 *   Shop:    <Footer app="shop" countryCode={cc}>
 *              <a slot="actions" href=…>Vertrag widerrufen</a>   (§ 356a BGB)
 *            </Footer>
 *
 * `legalExtended` adds AGB / Widerruf / Gewährleistung (default: shop only).
 * The old `links` prop is ignored (deprecated).
 */
import { Image } from "astro:assets";
import drawing from "./assets/shroom-mates-drawing-eyeless.png";
import Icon from "./Icon.astro";
import {
  ADDRESS,
  CONTACT_EMAIL,
  INSTAGRAM_URL,
  REPO_URL,
  footerColumns,
  type AppId,
} from "./site";

export interface FooterLink {
  label: string;
  href: string;
  external?: boolean;
  isEmail?: boolean;
}

interface Props {
  app?: AppId;
  countryCode?: string;
  legalExtended?: boolean;
  /** @deprecated links are derived from `app` */
  links?: FooterLink[];
}

const { app = "website", countryCode = "de", legalExtended } = Astro.props;
const columns = footerColumns(app, countryCode, legalExtended);
const currentYear = new Date().getFullYear();

/*
 * Augen der Footer-Zeichnung: [x, y, rx, ry, gesicht] im 1200 x 547-Raster des
 * Bildes. Die Zeichnung selbst ist augenlos (shroom-mates-drawing-eyeless.png),
 * die Pupillen liegen als SVG genau an den gezeichneten Stellen. Augen mit
 * gleicher Gesichts-Nummer blinzeln zusammen.
 */
const eyes: [number, number, number, number, number][] = [[27.1,522.2,1.5,2.5,0],[63.1,482.6,2,3,1],[71.4,479,3,2.5,1],[72.3,381,7,8.5,2],[101.6,381.5,7,7.5,2],[126.9,494.5,4,4.5,3],[138.6,490.8,4,4.5,3],[181.3,307.4,5,5,4],[196.8,309.6,5,6.5,4],[204.3,467.8,8,10,5],[220.4,458.1,8,10.5,5],[298.6,327.3,2,4,6],[304.1,325.7,2.5,5,6],[366.9,269.2,2.5,3.5,7],[374.8,269.6,2.5,4,7],[439.5,389.3,3.5,6.5,8],[452.9,391.1,3,3.5,8],[512.1,494.7,3.5,5,9],[526.4,493.7,4.5,5.5,9],[573,518.2,3.5,3.5,10],[587.6,520.4,3,4,10],[600.9,442,3.5,3.5,11],[625,440.9,4.5,3.5,11],[650.4,534.3,2,3,12],[657.1,532.7,2.5,3.5,12],[662.5,349.4,3,7,13],[674.6,346.1,3,6.5,13],[735.5,476.6,2,4,14],[743.2,477.7,2.5,3,14],[749.8,431.3,7.5,3.5,15],[786,442.6,7.5,4,15],[883.4,349.6,5.5,5,17],[897.2,354.8,5,5.5,17],[922.7,417,2,5,18],[929.9,416.6,1.5,4,18],[950.2,337.9,2,4,19],[957.5,340.4,2,4,19],[979,206.8,7.5,6.5,20],[1003.3,199.9,8.5,7.5,20],[1011.8,442.7,4,2,21],[1050.6,335.2,5,5.5,22],[1062.5,336.7,4.5,10,22],[1099.6,525.6,3,4,23],[1110.3,527.5,3,4,23],[1145.9,307.1,4.5,9,24],[1160.1,303.9,4.5,9,24],[1151.7,436.1,3,5.5,25],[1158.8,438.4,2.5,5.5,25]];
---

<footer class="site-footer" role="contentinfo">
  <div class="footer-drawing-wrap" data-footer-eyes>
    <Image
      class="footer-drawing"
      src={drawing}
      alt="Gezeichnete Menge kleiner Pilzfiguren mit Gesichtern"
      widths={[640, 1180, 1536, 2200]}
      sizes="100vw"
      format="webp"
      loading="lazy"
    />
    <svg class="footer-eyes" viewBox="0 0 1200 547" aria-hidden="true" focusable="false">
      {
        eyes.map(([x, y, rx, ry, face]) => (
          <ellipse
            class="footer-eyes__pupil"
            data-face={face}
            cx={x}
            cy={y}
            rx={rx}
            ry={ry}
            fill="#15132b"
          />
        ))
      }
    </svg>
  </div>

  <div class="footer-main">
    <p class="footer-claim">
      <span>Mush love,</span> <span>eure</span> <span>shroom mates!</span>
    </p>

    <nav class="footer-cols" aria-label="Footer">
      <div class="footer-col">
        <p class="footer-col__title">Besuch</p>
        <address>
          {ADDRESS.name}<br />
          {ADDRESS.street}<br />
          {ADDRESS.city.replace(/^\d+\s+/, "")}
        </address>
      </div>
      <div class="footer-col">
        <p class="footer-col__title">Kontakt</p>
        <ul role="list">
          <li><a class="footer-link--ul" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></li>
          <li>
            <a class="footer-link--ul" href={INSTAGRAM_URL} target="_blank" rel="noopener noreferrer">
              Instagram<span class="sr-only"> (öffnet in neuem Tab)</span>
            </a>
          </li>
        </ul>
      </div>
      {
        columns.map((col) => (
          <div class="footer-col">
            <p class="footer-col__title">{col.title}</p>
            <ul role="list">
              {col.links.map((l) => (
                <li>
                  <a href={l.href}>{l.label}</a>
                </li>
              ))}
              {col.title === "Mehr" && Astro.slots.has("actions") && (
                <li class="footer-actions">
                  <slot name="actions" />
                </li>
              )}
            </ul>
          </div>
        ))
      }
    </nav>
  </div>

  <p class="footer-credit">
    &copy; {currentYear} shroom-mates &middot; gebaut mit <Icon
      name="mushroom"
      size={18}
      strokeWidth={2}
      label="Pilzen"
      class="footer-credit__icon"
    /> und freier Software &middot;
    <a href={REPO_URL} target="_blank" rel="noopener noreferrer"
      >Code auf GitHub<span class="sr-only"> (öffnet in neuem Tab)</span></a
    >
  </p>
</footer>

<style>
  .site-footer {
    width: 100%;
    margin-top: auto;
    padding: 0 0 40px;
    overflow: hidden;
    background: var(--color-bg);
    color: var(--color-ink);
  }

  .footer-drawing-wrap {
    position: relative;
    width: 100%;
    border-bottom: 2px solid var(--color-accent);
  }

  .site-footer :global(.footer-drawing) {
    display: block;
    width: 100%;
    height: auto;
  }

  .footer-eyes {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .footer-main {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 40px;
    max-width: var(--container);
    margin: 0 auto;
    padding: 48px var(--gutter) 0;
  }

  .footer-claim {
    flex: 1 1 100%;
    margin: 0;
    text-align: center;
    font-family: var(--font-display);
    font-weight: 900;
    font-variation-settings: "SOFT" 100, "WONK" 1;
    font-size: clamp(40px, 6vw, 88px);
    line-height: 0.95;
    color: var(--color-accent);
    text-wrap: balance;
  }

  .footer-claim span {
    white-space: nowrap;
  }

  .footer-cols {
    flex: 1 1 100%;
    min-width: 0;
    max-width: 1000px;
    margin: 0 auto;
    text-align: center;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
    gap: 32px 16px;
    font-size: clamp(14px, 3.8vw, 16px);
    line-height: 1.8;
  }

  .footer-col__title {
    margin: 0 0 8px;
    font-family: var(--font-mono);
    font-variation-settings: normal;
    font-size: 12px;
    font-weight: 400;
    line-height: 1.4;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .footer-col ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-col address {
    margin: 0 0 8px;
    font-style: normal;
  }

  .footer-col a {
    display: inline-block;
    padding-block: 2px;
    color: var(--color-ink);
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .footer-col a.footer-link--ul {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .footer-col a:hover {
    color: var(--color-accent-dark);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .footer-actions {
    margin-top: 10px;
  }

  /* Withdraw button etc. passed via slot="actions" */
  .footer-actions :global(a) {
    padding: 0.5rem 1.1rem;
    min-height: 44px;
    border: 2px solid var(--color-ink);
    border-radius: var(--radius-pill);
    font-weight: 700;
  }

  .footer-credit {
    max-width: var(--container);
    margin: 48px auto 0;
    padding-inline: var(--gutter);
    text-align: center;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--color-muted);
  }

  .footer-credit a {
    color: var(--color-ink);
  }

  .footer-credit :global(.footer-credit__icon) {
    display: inline-block;
    vertical-align: -3px;
    color: var(--color-accent);
  }

  @media (max-width: 768px) {
    .footer-cols {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>

<script>
  // Pupils of the drawn crowd follow the pointer (mouse and touch). Without a
  // pointer nearby the mates glance around on their own; faces blink now and
  // then. Reduced motion: pupils stay where they are drawn.
  function init() {
    const wrap = document.querySelector<HTMLElement>("[data-footer-eyes]");
    if (!wrap || wrap.dataset.ready) return;
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    wrap.dataset.ready = "1";
    const svg = wrap.querySelector("svg") as SVGSVGElement;
    const eyes = [...svg.querySelectorAll<SVGEllipseElement>(".footer-eyes__pupil")].map((el) => {
      const rx = Number(el.getAttribute("rx"));
      const ry = Number(el.getAttribute("ry"));
      return {
        el,
        cx: Number(el.getAttribute("cx")),
        cy: Number(el.getAttribute("cy")),
        ry,
        face: el.dataset.face!,
        // how far the pupil may wander (image px): bigger eyes look further
        reach: Math.min(5, Math.max(1.4, Math.min(rx, ry) * 0.75)),
        x: 0,
        y: 0,
        blink: 1,
      };
    });
    const faces = [...new Set(eyes.map((e) => e.face))];

    let px = 0;
    let py = 0;
    let lastMove = -1e9;
    let glance = { x: 0, y: -1, until: 0 };
    let blinkFace = "";
    let blinkStart = 0;
    let nextBlink = performance.now() + 1500;
    let visible = false;
    let frame = 0;

    const tick = (now: number) => {
      frame = 0;
      const rect = svg.getBoundingClientRect();
      const k = rect.width / 1200;
      const idle = now - lastMove > 2500;
      if (idle && now > glance.until) {
        const a = Math.random() * Math.PI * 2;
        glance = { x: Math.cos(a), y: Math.sin(a) * 0.6, until: now + 900 + Math.random() * 1800 };
      }
      if (now > nextBlink) {
        blinkFace = faces[Math.floor(Math.random() * faces.length)];
        blinkStart = now;
        nextBlink = now + 1200 + Math.random() * 2600;
      }
      let moving = false;
      for (const e of eyes) {
        let tx: number;
        let ty: number;
        if (idle) {
          tx = glance.x * e.reach;
          ty = glance.y * e.reach;
        } else {
          const dx = px - (rect.left + e.cx * k);
          const dy = py - (rect.top + e.cy * k);
          const d = Math.hypot(dx, dy) || 1;
          const s = Math.min(1, d / 90) * e.reach;
          tx = (dx / d) * s;
          ty = (dy / d) * s;
        }
        // ease toward the target so the gaze moves instead of jumping
        e.x += (tx - e.x) * 0.25;
        e.y += (ty - e.y) * 0.25;
        if (Math.abs(tx - e.x) > 0.05 || Math.abs(ty - e.y) > 0.05) moving = true;
        const t = (now - blinkStart) / 160;
        e.blink = e.face === blinkFace && t < 1 ? Math.max(0.12, Math.abs(1 - 2 * t)) : 1;
        e.el.setAttribute(
          "transform",
          `translate(${(e.x + e.cx).toFixed(2)} ${(e.y + e.cy).toFixed(2)}) scale(1 ${e.blink.toFixed(2)}) translate(${-e.cx} ${-e.cy})`,
        );
      }
      if (visible && (moving || idle || now - blinkStart < 200)) frame = requestAnimationFrame(tick);
    };
    const kick = () => {
      if (!frame && visible) frame = requestAnimationFrame(tick);
    };

    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      kick();
    }).observe(wrap);
    addEventListener(
      "pointermove",
      (ev) => {
        px = ev.clientX;
        py = ev.clientY;
        lastMove = performance.now();
        kick();
      },
      { passive: true },
    );
    addEventListener(
      "pointerdown",
      (ev) => {
        px = ev.clientX;
        py = ev.clientY;
        lastMove = performance.now();
        kick();
      },
      { passive: true },
    );
  }
  document.addEventListener("astro:page-load", init);
  if (document.readyState !== "loading") init();
  else document.addEventListener("DOMContentLoaded", init);
</script>
