---
/**
 * Site footer shared by website and shop (Redesign 2026): night band, big
 * mushroom drawing, "Bis bald in der Glasfabrik!" and four link columns.
 *
 *   Website: <Footer app="website" />
 *   Shop:    <Footer app="shop" countryCode={cc}>
 *              <a slot="actions" href=…>Vertrag widerrufen</a>   (§ 356a BGB)
 *            </Footer>
 *
 * `legalExtended` adds AGB / Widerruf / Gewährleistung (default: shop only).
 * The old `links` prop is ignored (deprecated).
 */
import { Image } from "astro:assets";
import drawing from "./assets/shroom-mates-drawing.png";
import Icon from "./Icon.astro";
import {
  ADDRESS,
  CONTACT_EMAIL,
  INSTAGRAM_URL,
  REPO_URL,
  footerColumns,
  type AppId,
} from "./site";

export interface FooterLink {
  label: string;
  href: string;
  external?: boolean;
  isEmail?: boolean;
}

interface Props {
  app?: AppId;
  countryCode?: string;
  legalExtended?: boolean;
  /** @deprecated links are derived from `app` */
  links?: FooterLink[];
}

const { app = "website", countryCode = "de", legalExtended } = Astro.props;
const columns = footerColumns(app, countryCode, legalExtended);
const currentYear = new Date().getFullYear();

/* Augen der Footer-Zeichnung (Pixelkoordinaten im 1200 x 547-Raster des Bildes) */
const eyes = [{"x": 1003.2, "y": 199.9, "rx": 8.5, "ry": 7.5}, {"x": 979.0, "y": 206.9, "rx": 7.0, "ry": 6.5}, {"x": 1160.2, "y": 303.7, "rx": 4.0, "ry": 8.5}, {"x": 1145.9, "y": 307.2, "rx": 4.5, "ry": 9.0}, {"x": 181.3, "y": 307.4, "rx": 4.5, "ry": 5.0}, {"x": 196.8, "y": 309.4, "rx": 4.5, "ry": 6.0}, {"x": 1050.6, "y": 335.1, "rx": 4.0, "ry": 5.5}, {"x": 1062.7, "y": 335.6, "rx": 4.5, "ry": 7.5}, {"x": 674.6, "y": 346.0, "rx": 3.0, "ry": 6.0}, {"x": 662.3, "y": 349.3, "rx": 3.0, "ry": 6.5}, {"x": 883.5, "y": 349.6, "rx": 5.0, "ry": 5.0}, {"x": 897.1, "y": 354.6, "rx": 4.5, "ry": 5.0}, {"x": 72.3, "y": 381.0, "rx": 7.0, "ry": 8.0}, {"x": 101.6, "y": 381.4, "rx": 7.0, "ry": 7.0}, {"x": 439.5, "y": 389.2, "rx": 3.0, "ry": 6.0}, {"x": 749.7, "y": 431.3, "rx": 7.0, "ry": 3.5}, {"x": 786.0, "y": 442.7, "rx": 7.5, "ry": 4.0}, {"x": 204.1, "y": 467.4, "rx": 8.0, "ry": 9.5}, {"x": 526.3, "y": 493.7, "rx": 4.5, "ry": 5.0}, {"x": 512.2, "y": 494.6, "rx": 3.5, "ry": 5.0}, {"x": 126.9, "y": 494.7, "rx": 4.0, "ry": 4.0}];
const BODY = "#ebe8dd"; /* Körperfarbe der Zeichnung unter den Pupillen */
---

<footer class="site-footer" role="contentinfo">
  <div class="footer-drawing-wrap" data-footer-eyes>
    <Image
      class="footer-drawing"
      src={drawing}
      alt="Gezeichnete Menge kleiner Pilzfiguren mit Gesichtern"
      widths={[640, 1180, 1536]}
      sizes="(min-width: 1260px) 1180px, 100vw"
      format="webp"
      loading="lazy"
    />
    <svg class="footer-eyes" viewBox="0 0 1200 547" aria-hidden="true" focusable="false">
      {
        eyes.map((e) => (
          <g data-eye data-cx={e.x} data-cy={e.y} data-r={Math.min(e.rx, e.ry)}>
            <ellipse cx={e.x} cy={e.y} rx={e.rx + 3} ry={e.ry + 3} fill={BODY} />
            <ellipse class="footer-eyes__pupil" cx={e.x} cy={e.y} rx={e.rx} ry={e.ry} fill="#15132b" />
          </g>
        ))
      }
    </svg>
  </div>

  <div class="footer-main">
    <p class="footer-claim">
      <span>Mush love,</span> <span>eure</span> <span>shroom mates!</span>
    </p>

    <nav class="footer-cols" aria-label="Footer">
      {
        columns.map((col) => (
          <div class="footer-col">
            <p class="footer-col__title">{col.title}</p>
            <ul role="list">
              {col.links.map((l) => (
                <li>
                  <a href={l.href}>{l.label}</a>
                </li>
              ))}
              {col.title === "Rechtliches" && Astro.slots.has("actions") && (
                <li class="footer-actions">
                  <slot name="actions" />
                </li>
              )}
            </ul>
          </div>
        ))
      }
      <div class="footer-col">
        <p class="footer-col__title">Kontakt</p>
        <address>
          {ADDRESS.name}<br />
          {ADDRESS.street}<br />
          {ADDRESS.city}
        </address>
        <ul role="list">
          <li><a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></li>
          <li>
            <a href={INSTAGRAM_URL} target="_blank" rel="noopener noreferrer">
              Instagram<span class="sr-only"> (öffnet in neuem Tab)</span>
            </a>
          </li>
        </ul>
      </div>
    </nav>
  </div>

  <p class="footer-credit">
    &copy; {currentYear} shroom-mates &middot; gebaut mit <Icon
      name="mushroom"
      size={18}
      strokeWidth={2}
      label="Pilzen"
      class="footer-credit__icon"
    /> und freier Software &middot;
    <a href={REPO_URL} target="_blank" rel="noopener noreferrer"
      >Code auf GitHub<span class="sr-only"> (öffnet in neuem Tab)</span></a
    >
  </p>
</footer>

<style>
  .site-footer {
    width: 100%;
    margin-top: auto;
    padding: 0 var(--gutter) 40px;
    overflow: hidden;
    background: var(--color-bg);
    color: var(--color-ink);
  }

  .footer-drawing-wrap {
    position: relative;
    width: 100%;
    max-width: 1160px;
    margin: 0 auto;
  }

  .site-footer :global(.footer-drawing) {
    display: block;
    width: 100%;
    height: auto;
  }

  .footer-eyes {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .footer-main {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 40px;
    max-width: var(--container);
    margin: 0 auto;
    padding-top: 48px;
    border-top: 2px solid var(--color-accent);
  }

  .footer-claim {
    flex: 1 1 100%;
    margin: 0;
    text-align: center;
    font-family: var(--font-display);
    font-weight: 900;
    font-variation-settings: "SOFT" 100, "WONK" 1;
    font-size: clamp(40px, 6vw, 88px);
    line-height: 0.95;
    color: var(--color-accent);
    text-wrap: balance;
  }

  .footer-claim span {
    white-space: nowrap;
  }

  .footer-cols {
    flex: 1 1 100%;
    min-width: 0;
    max-width: 1000px;
    margin: 0 auto;
    text-align: center;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 32px 16px;
    font-size: 16px;
    line-height: 1.8;
  }

  .footer-col__title {
    margin: 0 0 8px;
    font-family: var(--font-mono);
    font-variation-settings: normal;
    font-size: 12px;
    font-weight: 400;
    line-height: 1.4;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .footer-col ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-col address {
    margin: 0 0 8px;
    font-style: normal;
  }

  .footer-col a {
    display: inline-block;
    padding-block: 2px;
    color: var(--color-ink);
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .footer-col a:hover {
    color: var(--color-accent-dark);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .footer-actions {
    margin-top: 10px;
  }

  /* Withdraw button etc. passed via slot="actions" */
  .footer-actions :global(a) {
    padding: 0.5rem 1.1rem;
    min-height: 44px;
    border: 2px solid var(--color-ink);
    border-radius: var(--radius-pill);
    font-weight: 700;
  }

  .footer-credit {
    max-width: var(--container);
    margin: 48px auto 0;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--color-muted);
  }

  .footer-credit a {
    color: var(--color-ink);
  }

  .footer-credit :global(.footer-credit__icon) {
    display: inline-block;
    vertical-align: -3px;
    color: var(--color-accent);
  }

  @media (max-width: 768px) {
    .footer-cols {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>

<script>
  // Pupils follow the pointer (rAF-throttled). Touch / reduced motion: they keep
  // their drawn position.
  function init() {
    const wrap = document.querySelector<HTMLElement>("[data-footer-eyes]");
    if (!wrap || wrap.dataset.ready) return;
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    if (!matchMedia("(hover: hover) and (pointer: fine)").matches) return;
    wrap.dataset.ready = "1";
    const svg = wrap.querySelector("svg") as SVGSVGElement;
    const eyes = [...svg.querySelectorAll<SVGGElement>("[data-eye]")].map((g) => ({
      pupil: g.querySelector<SVGEllipseElement>(".footer-eyes__pupil")!,
      cx: Number(g.dataset.cx),
      cy: Number(g.dataset.cy),
      r: Number(g.dataset.r),
    }));
    let px = 0;
    let py = 0;
    let frame = 0;
    const draw = () => {
      frame = 0;
      const rect = svg.getBoundingClientRect();
      const k = rect.width / 1200;
      for (const e of eyes) {
        const dx = px - (rect.left + e.cx * k);
        const dy = py - (rect.top + e.cy * k);
        const d = Math.hypot(dx, dy) || 1;
        const reach = Math.min(1, d / 160) * (e.r * 0.7);
        e.pupil.setAttribute("transform", `translate(${((dx / d) * reach).toFixed(2)} ${((dy / d) * reach).toFixed(2)})`);
      }
    };
    addEventListener(
      "pointermove",
      (ev) => {
        px = ev.clientX;
        py = ev.clientY;
        if (!frame) frame = requestAnimationFrame(draw);
      },
      { passive: true },
    );
  }
  document.addEventListener("astro:page-load", init);
  if (document.readyState !== "loading") init();
  else document.addEventListener("DOMContentLoaded", init);
</script>
