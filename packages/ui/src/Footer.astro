---
/**
 * Site footer shared by website and shop (Redesign 2026): night band, big
 * mushroom drawing, "Bis bald in der Glasfabrik!" and four link columns.
 *
 *   Website: <Footer app="website" />
 *   Shop:    <Footer app="shop" countryCode={cc}>
 *              <a slot="actions" href=…>Vertrag widerrufen</a>   (§ 356a BGB)
 *            </Footer>
 *
 * `legalExtended` adds AGB / Widerruf / Gewährleistung (default: shop only).
 * The old `links` prop is ignored (deprecated).
 */
import { Image } from "astro:assets";
import drawing from "./assets/shroom-mates-drawing.png";
import Icon from "./Icon.astro";
import {
  ADDRESS,
  CONTACT_EMAIL,
  INSTAGRAM_URL,
  REPO_URL,
  footerColumns,
  type AppId,
} from "./site";

export interface FooterLink {
  label: string;
  href: string;
  external?: boolean;
  isEmail?: boolean;
}

interface Props {
  app?: AppId;
  countryCode?: string;
  legalExtended?: boolean;
  /** @deprecated links are derived from `app` */
  links?: FooterLink[];
}

const { app = "website", countryCode = "de", legalExtended } = Astro.props;
const columns = footerColumns(app, countryCode, legalExtended);
const currentYear = new Date().getFullYear();
---

<footer class="site-footer" role="contentinfo">
  <Image
    class="footer-drawing"
    src={drawing}
    alt="Gezeichnete Menge kleiner Pilzfiguren mit Gesichtern"
    widths={[640, 1180, 1536]}
    sizes="(min-width: 1260px) 1180px, 100vw"
    format="webp"
    loading="lazy"
  />

  <div class="footer-main">
    <p class="footer-claim">
      <span>Bis bald</span> <span>in der</span> <span>Glasfabrik!</span>
    </p>

    <nav class="footer-cols" aria-label="Footer">
      {
        columns.map((col) => (
          <div class="footer-col">
            <p class="footer-col__title">{col.title}</p>
            <ul role="list">
              {col.links.map((l) => (
                <li>
                  <a href={l.href}>{l.label}</a>
                </li>
              ))}
              {col.title === "Rechtliches" && Astro.slots.has("actions") && (
                <li class="footer-actions">
                  <slot name="actions" />
                </li>
              )}
            </ul>
          </div>
        ))
      }
      <div class="footer-col">
        <p class="footer-col__title">Kontakt</p>
        <address>
          {ADDRESS.name}<br />
          {ADDRESS.street}<br />
          {ADDRESS.city}
        </address>
        <ul role="list">
          <li><a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></li>
          <li>
            <a href={INSTAGRAM_URL} target="_blank" rel="noopener noreferrer">
              Instagram<span class="sr-only"> (öffnet in neuem Tab)</span>
            </a>
          </li>
        </ul>
      </div>
    </nav>
  </div>

  <p class="footer-credit">
    &copy; {currentYear} shroom-mates &middot; gebaut mit <Icon
      name="mushroom"
      size={18}
      strokeWidth={2}
      label="Pilzen"
      class="footer-credit__icon"
    /> und freier Software &middot;
    <a href={REPO_URL} target="_blank" rel="noopener noreferrer"
      >Code auf GitHub<span class="sr-only"> (öffnet in neuem Tab)</span></a
    >
  </p>
</footer>

<style>
  .site-footer {
    width: 100%;
    margin-top: auto;
    padding: 72px var(--gutter) 40px;
    overflow: hidden;
    background: var(--color-night);
    color: var(--color-paper);
  }

  .site-footer :global(.footer-drawing) {
    display: block;
    width: 100%;
    max-width: 1180px;
    margin: 0 auto 48px;
    height: auto;
  }

  .footer-main {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 48px;
    max-width: var(--container);
    margin: 0 auto;
    padding-top: 48px;
    border-top: 2px solid var(--color-paper);
  }

  .footer-claim {
    flex: 1 1 420px;
    margin: 0;
    font-family: var(--font-display);
    font-weight: 900;
    font-variation-settings: "SOFT" 100, "WONK" 1;
    font-size: clamp(48px, 6vw, 96px);
    line-height: 0.88;
    color: var(--color-accent);
    text-wrap: balance;
  }

  .footer-claim span {
    white-space: nowrap;
  }

  .footer-cols {
    flex: 2 1 560px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 32px;
    font-size: 16px;
    line-height: 1.8;
  }

  .footer-col__title {
    margin: 0 0 8px;
    font-family: var(--font-mono);
    font-variation-settings: normal;
    font-size: 12px;
    font-weight: 400;
    line-height: 1.4;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #a39e8a;
  }

  .footer-col ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-col address {
    margin: 0 0 8px;
    font-style: normal;
  }

  .footer-col a {
    display: inline-block;
    padding-block: 2px;
    color: var(--color-paper);
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .footer-col a:hover {
    color: var(--color-accent-light);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .footer-col a:focus-visible,
  .footer-credit a:focus-visible {
    outline-color: var(--color-paper);
  }

  .footer-actions {
    margin-top: 10px;
  }

  /* Withdraw button etc. passed via slot="actions" */
  .footer-actions :global(a) {
    padding: 0.5rem 1.1rem;
    min-height: 44px;
    border: 2px solid var(--color-paper);
    border-radius: var(--radius-pill);
    font-weight: 700;
  }

  .footer-credit {
    max-width: var(--container);
    margin: 48px auto 0;
    font-family: var(--font-mono);
    font-size: 13px;
    color: #a39e8a;
  }

  .footer-credit a {
    color: var(--color-paper);
  }

  .footer-credit :global(.footer-credit__icon) {
    display: inline-block;
    vertical-align: -3px;
    color: var(--color-accent-light);
  }

  @media (max-width: 768px) {
    .site-footer {
      padding-top: 48px;
    }

    .footer-cols {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
