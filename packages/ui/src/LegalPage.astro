---
/**
 * Layout for legal texts (rendered from src/legal/*.md). Open facts are
 * marked <mark class="legal-open">, open legal questions
 * <mark class="legal-check">; while any exist, a draft notice is shown.
 */
interface Props {
  title: string;
  /** Show the "draft – legal review pending" notice */
  draft?: boolean;
}

const { title, draft = true } = Astro.props;
---

<article class="legal-page" aria-labelledby="legal-title">
  <h1 id="legal-title" class="section-heading">{title}</h1>
  {
    draft && (
      <p class="legal-draft" role="note">
        <strong>Entwurf</strong> – dieser Text wird noch rechtlich geprüft. Gelb
        markierte Stellen sind noch offen, orange markierte noch zu prüfen.
      </p>
    )
  }
  <div class="legal-body">
    <slot />
  </div>
</article>

<style>
  .legal-page {
    max-width: 820px;
    margin: 0 auto;
    padding: 2rem 0 4rem;
  }

  .legal-page > h1 {
    margin-bottom: 1.5rem;
    color: var(--color-accent);
  }

  .legal-draft {
    margin: 0 0 2rem;
    padding: 0.85rem 1.1rem;
    background: #fff8d6;
    border: 3px solid var(--color-ink);
    border-radius: 0;
    font-size: 0.9375rem;
  }

  .legal-body {
    padding: 2rem 2.5rem;
    background: var(--color-white);
    border: 3px solid var(--color-ink);
    border-radius: var(--radius-card, 0);
    box-shadow: var(--shadow-card, 8px 8px 0 #1c1a33);
    font-size: 1.0625rem;
    line-height: 1.65;
    overflow-wrap: anywhere;
  }

  .legal-body :global(h2) {
    margin: 2.25rem 0 0.75rem;
    font-size: clamp(1.5rem, 3vw, 1.875rem);
    line-height: 1.1;
    text-wrap: balance;
  }

  .legal-body :global(h2:first-child) {
    margin-top: 0;
  }

  .legal-body :global(h3) {
    margin: 1.5rem 0 0.5rem;
    font-size: 1.1875rem;
    line-height: 1.25;
  }

  .legal-body :global(p),
  .legal-body :global(li) {
    margin: 0 0 0.75rem;
  }

  .legal-body :global(ul),
  .legal-body :global(ol) {
    padding-left: 1.5rem;
    margin: 0 0 1rem;
  }

  .legal-body :global(a) {
    color: var(--color-accent-dark, #bf2300);
    text-underline-offset: 3px;
  }

  .legal-body :global(a:hover) {
    color: var(--color-ink);
  }

  .legal-body :global(mark) {
    padding: 0 0.25em;
    border-radius: 0;
  }

  .legal-body :global(mark.legal-open) {
    background: #ffe66d;
  }

  .legal-body :global(mark.legal-check) {
    background: #ffc9a8;
  }

  @media (max-width: 640px) {
    .legal-body {
      padding: 1.25rem 1rem;
      border-radius: 0;
      box-shadow: 4px 4px 0 var(--color-ink);
    }
  }
</style>
