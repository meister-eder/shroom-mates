---
/**
 * Inline-SVG-Strichicons (Farbe = currentColor, round caps/joins).
 * Dekorativ per Default (aria-hidden). Mit `label` wird daraus ein
 * <svg role="img" aria-label="...">.
 *
 *   <Icon name="cart" />
 *   <Icon name="mushroom" label="Pilzen" size={18} />
 */
type IconName =
  | "cart"
  | "basket"
  | "menu"
  | "close"
  | "arrow-right"
  | "arrow-left"
  | "plus"
  | "minus"
  | "check"
  | "mushroom"
  | "instagram"
  | "mail"
  | "map-pin"
  | "truck";

interface Props {
  name: IconName;
  /** Kantenlänge in px (Default 24) */
  size?: number;
  /** Strichstärke im 24er-Raster (Default 2.4) */
  strokeWidth?: number;
  /** Zugänglicher Name; ohne Label ist das Icon aria-hidden */
  label?: string;
  class?: string;
}

const {
  name,
  size = 24,
  strokeWidth = 2.4,
  label,
  class: className,
} = Astro.props;

const shapes: Record<IconName, string> = {
  // Pilzkorb: Korb mit Henkel, Körper und drei Streben (kein Einkaufswagen)
  cart: '<path d="M7 10a5 5 0 0 1 10 0"/><path d="M3 10h18l-1.8 9.2a1.5 1.5 0 0 1-1.5 1.2H6.3a1.5 1.5 0 0 1-1.5-1.2Z"/><path d="M9 13.5v4M12 13.5v4M15 13.5v4"/>',
  basket:
    '<path d="M7 10a5 5 0 0 1 10 0"/><path d="M3 10h18l-1.8 9.2a1.5 1.5 0 0 1-1.5 1.2H6.3a1.5 1.5 0 0 1-1.5-1.2Z"/><path d="M9 13.5v4M12 13.5v4M15 13.5v4"/>',
  menu: '<path d="M4 7h16M4 12h16M4 17h10"/>',
  close: '<path d="M5 5l14 14M19 5L5 19"/>',
  "arrow-right": '<path d="M4 12h16M14 6l6 6-6 6"/>',
  "arrow-left": '<path d="M20 12H4M10 6l-6 6 6 6"/>',
  plus: '<path d="M12 5v14M5 12h14"/>',
  minus: '<path d="M5 12h14"/>',
  check: '<path d="M4 12.5l5 5L20 6.5"/>',
  mushroom:
    '<path d="M3 12a9 7 0 0 1 18 0z"/><path d="M9.5 12v6.5a2.5 2.5 0 0 0 5 0V12"/><circle cx="9" cy="8.5" r=".8" fill="currentColor"/><circle cx="14.5" cy="7" r=".8" fill="currentColor"/>',
  instagram:
    '<rect x="3" y="3" width="18" height="18" rx="5.5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r=".9" fill="currentColor"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="3"/><path d="M4 7l8 6 8-6"/>',
  "map-pin":
    '<path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.4"/>',
  truck:
    '<path d="M2 6h12v10H2zM14 10h4l3 3v3h-7z"/><circle cx="7" cy="18" r="1.8"/><circle cx="17" cy="18" r="1.8"/>',
};
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
  focusable="false"
  set:html={shapes[name]}
/>
