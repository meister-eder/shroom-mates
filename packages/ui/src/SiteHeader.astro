---
/**
 * Site header (Redesign 2026).
 *
 * Desktop: mascot + wordmark left, NavPills right (Kontakt, then the cart).
 * Mobile: menu button left, wordmark centre (no mascot), Instagram icon + cart right; the menu is a
 * full-screen overlay on ink with large Fraunces links.
 *
 * Usage: <SiteHeader active="growkits" ticker={[...]}>
 *           <CartButton slot="cart" ... />
 *        </SiteHeader>
 *
 * One header for the whole site (marketing and shop). All links are relative (see site.ts).
 */
import { Image } from "astro:assets";
import logoFont from "./assets/logo_font.svg?url";
import logoWithShrooms from "./assets/logo_with_shrooms.png";
import Icon from "./Icon.astro";
import MatesLogo from "./MatesLogo.astro";
import { INSTAGRAM_URL, mainNav, type NavKey } from "./site";

interface Props {
  /** Current section; the pill gets aria-current="page" */
  active?: NavKey;
  /** Marquee line above the header */
  ticker?: string[];
}

const { active, ticker } = Astro.props;

const current: NavKey | undefined = active;
const items = mainNav;
const home = "/";
const hasCart = Astro.slots.has("cart");
// Without a cart, Kontakt is the orange call-to-action pill
const kontaktAccent = !hasCart;
// duplicated groups make the marquee seamless; only the first one is exposed
const tickerGroups = ticker?.length ? [0, 1, 2, 3] : [];
---

<header class="site-header" role="banner">
  {
    tickerGroups.length > 0 && (
      <div class="ticker">
        <div class="ticker__track">
          {tickerGroups.map((g) => (
            <ul class="ticker__group" aria-hidden={g === 0 ? undefined : "true"}>
              {ticker!.map((t) => (
                <li>{t}</li>
              ))}
            </ul>
          ))}
        </div>
        <button
          type="button"
          class="ticker__toggle"
          aria-pressed="false"
          aria-label="Laufband anhalten"
          data-label-pause="Laufband anhalten"
          data-label-play="Laufband abspielen"
        >
          <svg
            class="ticker__icon ticker__icon--pause"
            width="14"
            height="14"
            viewBox="0 0 14 14"
            aria-hidden="true"
            focusable="false"
          >
            <path d="M4 2.5v9M10 2.5v9" fill="none" stroke="currentColor" stroke-width="2" />
          </svg>
          <svg
            class="ticker__icon ticker__icon--play"
            width="14"
            height="14"
            viewBox="0 0 14 14"
            aria-hidden="true"
            focusable="false"
          >
            <path d="M3.5 2l8 5-8 5z" fill="currentColor" />
          </svg>
        </button>
      </div>
    )
  }

  <nav class="site-nav" aria-label="Hauptnavigation">
    <button
      class="hamburger"
      aria-label="Navigationsmenü öffnen"
      aria-expanded="false"
      aria-controls="nav-links"
      type="button"
    >
      <span class="hamburger__bars" aria-hidden="true"><i></i><i></i><i></i></span>
    </button>

    <a href={home} class="brand" aria-label="shroom-mates Startseite">
      <MatesLogo class="brand__logo" alt="" width={58} loading="eager" />
      <span class="brand__word" aria-hidden="true">shroom<br />mates</span>
      <span class="brand__wordmark" aria-hidden="true" style={`--wordmark: url(${logoFont})`}></span>
    </a>

    <ul class="nav-links" id="nav-links" role="list">
      {
        items.map((item) => {
          const isKontakt = item.key === "kontakt";
          return (
            <li>
              <a
                href={item.href}
                class:list={["nav-pill", { "nav-pill--accent": isKontakt && kontaktAccent }]}
                aria-current={current === item.key ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          );
        })
      }
      <li class="nav-links__extra">
        <a href={INSTAGRAM_URL} target="_blank" rel="noopener noreferrer" class="nav-links__ig">
          <Icon name="instagram" size={22} />
          Instagram
          <span class="sr-only"> (öffnet in neuem Tab)</span>
        </a>
        <Image
          src={logoWithShrooms}
          alt=""
          aria-hidden="true"
          width={300}
          height={300}
          loading="lazy"
          format="webp"
          class="nav-links__mascot"
        />
      </li>
    </ul>

    <div class:list={["header-cart", { "header-cart--ig-only": !hasCart }]}>
      <a
        href={INSTAGRAM_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="header-ig"
        aria-label="Instagram (öffnet in neuem Tab)"
      >
        <Icon name="instagram" size={26} />
      </a>
      <slot name="cart" />
    </div>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: var(--color-bg);
  }

  .site-header :global(.ticker__group li::before) {
    content: "\2726";
    margin-right: 1.25rem;
    color: inherit;
  }

  /* ── Bar ──────────────────────────────────────────── */
  .site-nav {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 16px;
    max-width: var(--container);
    margin: 0 auto;
    padding: 18px var(--gutter);
  }

  .hamburger {
    display: none;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--color-accent);
    text-decoration: none;
  }

  .brand :global(.brand__logo) {
    width: 58px;
    height: 58px;
    flex: none;
  }

  .brand__wordmark {
    display: none;
  }

  .brand__word {
    font-family: var(--font-display);
    font-weight: 900;
    font-variation-settings: "SOFT" 100, "WONK" 1;
    font-size: 30px;
    line-height: 0.88;
  }

  .nav-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-links__extra {
    display: none;
  }

  .header-cart {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  /* Instagram icon is mobile-only (desktop has the link in the page) */
  .header-ig {
    display: none;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    color: var(--color-accent);
  }

  .header-cart--ig-only {
    display: none;
  }

  .nav-pill {
    padding: 0.5rem 1rem;
  }

  .nav-pill--accent {
    padding-inline: 1.1rem;
  }

  /* Fluid sizing: pills, gaps and wordmark shrink with the viewport so 8 links + Pilzkorb
     stay on one line from 1024px up (full size from 1600px); below 1024px the mobile menu
     takes over (keep in sync with hamburger.ts and base.css) */
  @media (min-width: 1024px) {
    .site-nav {
      gap: 16px;
    }

    .brand {
      gap: clamp(6px, 0.8vw, 10px);
    }

    .brand :global(.brand__logo) {
      width: clamp(44px, 3.4vw + 9px, 58px);
      height: auto;
      aspect-ratio: 1;
    }

    .brand__word {
      font-size: clamp(22px, 1.9vw + 3px, 30px);
    }

    .nav-links {
      flex-wrap: nowrap;
      gap: clamp(2px, 0.5vw - 2px, 6px);
    }

    .nav-pill,
    .nav-pill--accent {
      padding: 8px clamp(8px, 1.5625vw - 8px, 17px);
      font-size: clamp(14px, 0.521vw + 8.67px, 17px);
      white-space: nowrap;
    }
  }

  /* ── Mobile: menu button | wordmark | cart ────────── */
  @media (max-width: 1023px) {
    .site-nav {
      grid-template-columns: 1fr auto 1fr;
      gap: 8px;
      padding: 10px var(--gutter);
    }

    .hamburger {
      display: flex;
      align-items: center;
      justify-content: center;
      justify-self: start;
      width: 48px;
      height: 48px;
      padding: 0;
      border: 0;
      background: none;
      cursor: pointer;
    }

    .site-header {
      border-bottom: 2px solid var(--color-accent);
    }

    /* three orange bars (30 x 3 px), become an X when open */
    .hamburger__bars {
      position: relative;
      display: block;
      width: 48px;
      height: 48px;
    }

    .hamburger__bars i {
      position: absolute;
      left: 9px;
      width: 30px;
      height: 3px;
      border-radius: 3px;
      background: var(--color-accent);
      transition:
        transform 0.15s ease,
        opacity 0.15s ease;
    }

    .hamburger__bars i:nth-child(1) {
      top: 12.5px;
    }

    .hamburger__bars i:nth-child(2) {
      top: 22.5px;
    }

    .hamburger__bars i:nth-child(3) {
      top: 32.5px;
    }

    .hamburger[aria-expanded="true"] .hamburger__bars i:nth-child(1) {
      transform: translateY(10px) rotate(45deg);
    }

    .hamburger[aria-expanded="true"] .hamburger__bars i:nth-child(2) {
      opacity: 0;
    }

    .hamburger[aria-expanded="true"] .hamburger__bars i:nth-child(3) {
      transform: translateY(-10px) rotate(-45deg);
    }

    .hamburger:focus-visible {
      outline: 2px solid var(--color-accent);
      outline-offset: 2px;
    }

    @media (prefers-reduced-motion: reduce) {
      .hamburger__bars i {
        transition: none;
      }
    }

    .brand :global(.brand__logo) {
      display: none;
    }

    .brand__word {
      display: none;
    }

    /* Bentley wordmark (SVG, tinted with the accent colour) */
    .brand__wordmark {
      display: block;
      width: 88px;
      aspect-ratio: 42.47 / 15.81;
      background: var(--color-accent);
      -webkit-mask: var(--wordmark) center / contain no-repeat;
      mask: var(--wordmark) center / contain no-repeat;
    }

    .header-cart,
    .header-cart--ig-only {
      display: flex;
      grid-column: 3;
      justify-self: end;
    }

    .header-ig {
      display: inline-flex;
    }

    /* Full-screen overlay on ink */
    .nav-links {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      height: calc(100dvh - 100%);
      flex-direction: column;
      flex-wrap: nowrap;
      justify-content: flex-start;
      gap: 4px;
      padding: 24px var(--gutter) 32px;
      overflow-y: auto;
      background: var(--color-ink);
      color: var(--color-cream);
      visibility: hidden;
      opacity: 0;
      transition:
        opacity 0.2s ease,
        visibility 0s linear 0.2s;
    }

    .nav-links.active {
      visibility: visible;
      opacity: 1;
      transition: opacity 0.2s ease;
    }

    .nav-links .nav-pill,
    .nav-links .nav-pill--accent {
      display: block;
      min-height: 0;
      padding: 10px 0;
      border: 0;
      border-radius: 0;
      background: none;
      box-shadow: none;
      color: var(--color-cream);
      font-family: var(--font-display);
      font-weight: 900;
      font-variation-settings: "SOFT" 100, "WONK" 1;
      font-size: 40px;
      line-height: 1.1;
    }

    .nav-links .nav-pill:hover,
    .nav-links .nav-pill:focus-visible {
      color: var(--color-accent);
      background: none;
    }

    .nav-links .nav-pill[aria-current="page"] {
      color: var(--color-accent);
    }

    .nav-links .nav-pill:focus-visible,
    .nav-links__ig:focus-visible {
      outline-color: var(--color-cream);
    }

    .nav-links__extra {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      margin-top: auto;
      padding-top: 16px;
    }

    .nav-links__ig {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      min-height: 44px;
      color: var(--color-cream);
      font-family: var(--font-mono);
      font-size: 0.9rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      text-decoration: none;
    }

    .nav-links__extra :global(.nav-links__mascot) {
      width: 150px;
      height: auto;
    }
  }
</style>

<style is:global>
  html.menu-locked {
    overflow: hidden;
  }
</style>

<script>
  import "./scripts/hamburger.ts";
  import "./scripts/marquee.ts";
</script>
