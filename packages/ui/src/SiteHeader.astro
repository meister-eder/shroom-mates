---
/**
 * Site header shared by website and shop (Redesign 2026).
 *
 * Desktop: mascot + wordmark left, NavPills right (Kontakt, then the cart).
 * Mobile: menu button left, wordmark centre, cart right; the menu is a
 * full-screen overlay on ink with large Fraunces links.
 *
 * Usage (website):  <SiteHeader app="website" active="growkits" ticker={[...]} />
 * Usage (shop):     <SiteHeader app="shop" countryCode={cc} active="shop" info={[...]}>
 *                     <CartButton slot="cart" client:load ... />
 *                   </SiteHeader>
 *
 * Links are derived from `app` (same-origin relative, cross-origin absolute,
 * see site.ts). Legacy props (homeHref, links, shopHref, shopActive, slot
 * "end") still work but are deprecated.
 */
import { Image } from "astro:assets";
import logoWithShrooms from "./assets/logo_with_shrooms.png";
import Icon from "./Icon.astro";
import { INSTAGRAM_URL, linkBuilders, mainNav, type AppId, type NavKey } from "./site";

export interface NavLink {
  label: string;
  href: string;
}

interface Props {
  /** Which app renders the header (default "website") */
  app?: AppId;
  /** Shop only: country code for relative shop URLs (default "de") */
  countryCode?: string;
  /** Current section; the pill gets aria-current="page" */
  active?: NavKey;
  /** Marquee line above the header (website) */
  ticker?: string[];
  /** Static info line above the header (shop; no animation) */
  info?: string[];
  /** Override the brand link */
  homeHref?: string;

  /** @deprecated pass `app` instead */
  links?: NavLink[];
  /** @deprecated pass `app` instead */
  shopHref?: string;
  /** @deprecated use active="shop" */
  shopActive?: boolean;
}

const {
  app = "website",
  countryCode = "de",
  active,
  ticker,
  info,
  homeHref,
  links: legacyLinks,
  shopHref,
  shopActive = false,
} = Astro.props;

const current: NavKey | undefined = active ?? (shopActive ? "shop" : undefined);

type Item = { key: string; label: string; href: string };
let items: Item[];
if (legacyLinks) {
  items = [
    ...legacyLinks.map((l) => ({ key: l.label, ...l })),
    ...(shopHref ? [{ key: "shop", label: "Shop", href: shopHref }] : []),
  ];
} else {
  items = mainNav(app, countryCode);
}

const home = homeHref ?? linkBuilders(app, countryCode).home;
const hasCart = Astro.slots.has("cart") || Astro.slots.has("end");
// Without a cart, Kontakt is the orange call-to-action pill
const kontaktAccent = !hasCart;
// duplicated groups make the marquee seamless; only the first one is exposed
const tickerGroups = ticker && ticker.length ? [0, 1, 2, 3] : [];
---

<header class="site-header" role="banner">
  {
    tickerGroups.length > 0 && (
      <div class="ticker">
        <div class="ticker__track">
          {tickerGroups.map((g) => (
            <ul class="ticker__group" aria-hidden={g === 0 ? undefined : "true"}>
              {ticker!.map((t) => (
                <li>{t}</li>
              ))}
            </ul>
          ))}
        </div>
      </div>
    )
  }
  {
    info && info.length > 0 && (
      <ul class="header-info">
        {info.map((t) => (
          <li>{t}</li>
        ))}
      </ul>
    )
  }

  <nav class="site-nav" aria-label="Hauptnavigation">
    <button
      class="hamburger"
      aria-label="Navigationsmenü öffnen"
      aria-expanded="false"
      aria-controls="nav-links"
      type="button"
    >
      <Icon name="menu" size={22} strokeWidth={2.6} class="hamburger__open" />
      <Icon name="close" size={22} strokeWidth={2.6} class="hamburger__close" />
    </button>

    <a href={home} class="brand" aria-label="shroom-mates Startseite">
      <Image
        src={logoWithShrooms}
        alt=""
        width={116}
        height={116}
        loading="eager"
        format="webp"
        class="brand__logo"
      />
      <span class="brand__word" aria-hidden="true">shroom<br />mates</span>
    </a>

    <ul class="nav-links" id="nav-links" role="list">
      {
        items.map((item) => {
          const isKontakt = item.key === "kontakt";
          return (
            <li>
              <a
                href={item.href}
                class:list={[
                  "nav-pill",
                  { "nav-pill--accent": isKontakt && kontaktAccent },
                ]}
                aria-current={current === item.key ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          );
        })
      }
      <li class="nav-links__extra">
        <a href={INSTAGRAM_URL} target="_blank" rel="noopener noreferrer" class="nav-links__ig">
          <Icon name="instagram" size={22} />
          Instagram
          <span class="sr-only"> (öffnet in neuem Tab)</span>
        </a>
        <Image
          src={logoWithShrooms}
          alt=""
          aria-hidden="true"
          width={300}
          height={300}
          loading="lazy"
          format="webp"
          class="nav-links__mascot"
        />
      </li>
    </ul>

    {
      hasCart && (
        <div class="header-cart">
          <slot name="cart" />
          <slot name="end" />
        </div>
      )
    }
  </nav>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1000;
    background: var(--color-cream);
    border-bottom: 3px solid var(--color-ink);
  }

  /* ── Info line (shop) ─────────────────────────────── */
  .header-info {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 2px 28px;
    margin: 0;
    padding: 9px var(--gutter);
    list-style: none;
    background: var(--color-ink);
    color: var(--color-cream);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .header-info li + li::before {
    content: "\2726";
    margin-right: 28px;
    color: var(--color-accent-light);
  }

  .site-header :global(.ticker__group li::before) {
    content: "\2726";
    margin-right: 1.25rem;
    color: var(--color-accent-light);
  }

  /* ── Bar ──────────────────────────────────────────── */
  .site-nav {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 16px;
    max-width: var(--container);
    margin: 0 auto;
    padding: 14px var(--gutter);
  }

  .hamburger {
    display: none;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--color-accent);
    text-decoration: none;
  }

  .brand :global(.brand__logo) {
    width: 58px;
    height: 58px;
    object-fit: contain;
  }

  .brand__word {
    font-family: var(--font-display);
    font-weight: 900;
    font-variation-settings: "SOFT" 100, "WONK" 1;
    font-size: 30px;
    line-height: 0.88;
  }

  .nav-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-links__extra {
    display: none;
  }

  .header-cart {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .nav-pill {
    padding: 0.5rem 1rem;
  }

  /* Compact pills so 8 links + Pilzkorb stay on one line down to 1241px;
     below that the mobile menu takes over (keep in sync with hamburger.ts) */
  @media (max-width: 1440px) and (min-width: 1241px) {
    .nav-pill {
      padding: 0.45rem 0.75rem;
      font-size: 0.95rem;
    }

    .nav-links {
      gap: 4px;
    }

    .site-nav {
      gap: 12px;
    }
  }

  /* ── Mobile: menu button | wordmark | cart ────────── */
  @media (max-width: 1240px) {
    .site-nav {
      grid-template-columns: 1fr auto 1fr;
      gap: 8px;
      padding: 10px var(--gutter);
    }

    .hamburger {
      display: flex;
      align-items: center;
      justify-content: center;
      justify-self: start;
      width: 48px;
      height: 48px;
      padding: 0;
      border: 2px solid var(--color-ink);
      border-radius: 50%;
      background: #fff;
      color: var(--color-ink);
      cursor: pointer;
    }

    .hamburger :global(.hamburger__close),
    .hamburger[aria-expanded="true"] :global(.hamburger__open) {
      display: none;
    }

    .hamburger[aria-expanded="true"] :global(.hamburger__close) {
      display: block;
    }

    .brand {
      gap: 6px;
    }

    .brand :global(.brand__logo) {
      width: 40px;
      height: 40px;
    }

    .brand__word {
      font-size: 21px;
      line-height: 0.86;
    }

    .header-cart {
      grid-column: 3;
      justify-self: end;
    }

    /* Full-screen overlay on ink */
    .nav-links {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      height: calc(100dvh - 100%);
      flex-direction: column;
      flex-wrap: nowrap;
      justify-content: flex-start;
      gap: 4px;
      padding: 24px var(--gutter) 32px;
      overflow-y: auto;
      background: var(--color-ink);
      color: var(--color-cream);
      visibility: hidden;
      opacity: 0;
      transition:
        opacity 0.2s ease,
        visibility 0s linear 0.2s;
    }

    .nav-links.active {
      visibility: visible;
      opacity: 1;
      transition: opacity 0.2s ease;
    }

    .nav-links .nav-pill,
    .nav-links .nav-pill--accent {
      display: block;
      min-height: 0;
      padding: 10px 0;
      border: 0;
      border-radius: 0;
      background: none;
      box-shadow: none;
      color: var(--color-cream);
      font-family: var(--font-display);
      font-weight: 900;
      font-variation-settings: "SOFT" 100, "WONK" 1;
      font-size: 40px;
      line-height: 1.1;
    }

    .nav-links .nav-pill:hover,
    .nav-links .nav-pill:focus-visible {
      color: var(--color-accent);
      background: none;
    }

    .nav-links .nav-pill[aria-current="page"] {
      color: var(--color-accent);
    }

    .nav-links .nav-pill:focus-visible,
    .nav-links__ig:focus-visible {
      outline-color: var(--color-cream);
    }

    .nav-links__extra {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      margin-top: auto;
      padding-top: 16px;
    }

    .nav-links__ig {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      min-height: 44px;
      color: var(--color-cream);
      font-family: var(--font-mono);
      font-size: 0.9rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      text-decoration: none;
    }

    .nav-links__extra :global(.nav-links__mascot) {
      width: 150px;
      height: auto;
    }
  }
</style>

<style is:global>
  html.menu-locked {
    overflow: hidden;
  }
</style>

<script>
  import "./scripts/hamburger.ts";
</script>
