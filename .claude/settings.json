{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(bun install --frozen-lockfile)",
      "Bash(bun run --filter * lint)",
      "Bash(bun run --filter * build)",
      "Bash(bun run build)",
      "Bash(bunx biome check *)",
      "Bash(bunx astro check *)",
      "Bash(bun run test*)",
      "Bash(bunx playwright test *)",
      "Bash(npx playwright test *)",
      "Bash(npx medusa build)",
      "Bash(npm run test:*)",
      "Bash(scripts/verify.sh*)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push origin main*)",
      "Bash(git push origin shop*)",
      "Bash(gh workflow run deploy-server*)",
      "Bash(git commit --no-verify*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/format.sh\"",
            "timeout": 30,
            "statusMessage": "Biome formatiert"
          }
        ]
      }
    ]
  }
}
