# Site + shop: one app (prerendered pages and SSR shop)
:80 {
	# Umami tracker (only reachable if an umami service runs in this stack)
	@umami path /stats/s.js /stats/e
	handle @umami {
		reverse_proxy umami:3000
	}
	handle {
		reverse_proxy web:4321
	}
}

:4321 {
	reverse_proxy web:4321
}

:9000 {
	reverse_proxy medusa:9000
}
