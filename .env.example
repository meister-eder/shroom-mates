# Environment variables for docker compose
# Test server: /opt/shroom-mates/.env (docker-compose.test.yml; DOMAIN, the
# publishable key and SumUp/Resend keys are set by the Deploy workflow).
# Local stack: cp .env.example .env (docker-compose.local.yml has defaults).
# Generate secrets with: openssl rand -base64 32

# Database
POSTGRES_USER=medusa
POSTGRES_PASSWORD=<generate-a-strong-password>
POSTGRES_DB=shroom-mates

# Medusa secrets
COOKIE_SECRET=<openssl-rand-base64-32>
JWT_SECRET=<openssl-rand-base64-32>

# Analytics (optional; empty = no tracker)
# PUBLIC_UMAMI_WEBSITE_ID=
# UMAMI_APP_SECRET=

# Email (optional; without a key the backend only logs emails)
# RESEND_API_KEY=

# Payment (use SumUp sandbox keys outside production)
# SUMUP_API_KEY=sup_sk_sandbox_...
# SUMUP_MERCHANT_CODE=...
# Extra hosts (host[:port], comma-separated) allowed as SumUp redirect targets
# SUMUP_REDIRECT_ALLOWED_HOSTS=
