---
// SSR: shop pages rewrite to this page (Astro.rewrite("/404/")) for unknown products.
export const prerender = false;

import Layout from "@layouts/Layout.astro";
import MatesLogo from "@shroom-mates/ui/MatesLogo.astro";

Astro.response.status = 404;
---

<Layout
  title="Seite nicht gefunden | shroom-mates"
  description="Diese Seite gibt es nicht (mehr)."
  noindex
>
  <section class="not-found">
    <div class="not-found__mascot">
      <div class="dots" aria-hidden="true"></div>
      <MatesLogo
        class="not-found__logo"
        alt="Die shroom-mates-Maskottchen"
        width={260}
        sizes="(max-width: 480px) 60vw, 260px"
      />
    </div>
    <p class="eyebrow">404</p>
    <h1>Diese Seite ist uns entwischt.</h1>
    <p class="lead">Vielleicht wächst sie gerade noch.</p>
    <div class="not-found__actions">
      <a class="btn btn--primary" href="/">Zur Startseite</a>
      <a class="btn btn--secondary" href="/unsere-pilze/">Unsere Pilze</a>
      <a class="btn btn--secondary" href="/kontakt/">Kontakt</a>
    </div>
  </section>
</Layout>

<style>
  .not-found {
    max-width: 40rem;
    margin: 0 auto;
    padding: 1rem 0 4rem;
    text-align: center;
  }

  .not-found__mascot {
    position: relative;
    width: min(260px, 60vw);
    margin: 0 auto 1.5rem;
  }

  .not-found__mascot .dots {
    position: absolute;
    inset: 12% -12% 0;
    border-radius: 50%;
  }

  .not-found__mascot :global(.not-found__logo) {
    position: relative;
    display: block;
    width: 100%;
    filter: drop-shadow(5px 5px 0 var(--color-ink));
  }

  h1 {
    margin: 0.5rem 0 1rem;
    font-size: clamp(36px, 7vw, 64px);
    line-height: 0.95;
    color: var(--color-accent);
  }

  .lead {
    margin: 0 0 2rem;
  }

  .not-found__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    justify-content: center;
  }
</style>
