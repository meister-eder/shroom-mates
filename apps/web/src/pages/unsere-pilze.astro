---
import { getCollection, getEntry } from "astro:content";
import MushroomsPage from "../components/pages/MushroomsPage.astro";

const entry = await getEntry("mushrooms-page", "content");
if (!entry) {
  throw new Error("mushrooms-page content not found");
}
const mushrooms = await getCollection("mushrooms");
---

<MushroomsPage data={entry.data} mushrooms={mushrooms} />
