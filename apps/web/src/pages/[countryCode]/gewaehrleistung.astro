---
import Layout from "@layouts/Layout.astro";

const { countryCode } = Astro.params;
if (!countryCode) return Astro.rewrite("/404");
---

<Layout
  title="Gesetzliche Gewährleistung"
  description="Harmonisierte EU-Mitteilung über das gesetzliche Gewährleistungsrecht"
>
  <section class="warranty-page">
    <h1 class="section-heading">Gesetzliche Gewährleistung</h1>
    <!-- Harmonised notice, Annex I of Implementing Regulation (EU) 2025/1960 (German, colour). Must not be altered. -->
    <img
      src="/legal/gesetzliche-gewaehrleistung.jpg"
      width="1219"
      height="1668"
      alt="EU-Mitteilung: Mindestens zwei Jahre gesetzliche Gewährleistung der Vertragsmäßigkeit für Waren, die in der Europäischen Union verkauft werden. Verbraucher können ihre Rechte geltend machen, wenn die Waren nicht der Beschreibung entsprechen oder nicht bestimmungsgemäß funktionieren. Verkäufer müssen kostenlose Nachbesserung oder Ersatzlieferung, in bestimmten Fällen Preisminderung oder vollständige Erstattung anbieten. Melden Sie dem Verkäufer das Problem so bald wie möglich und legen Sie einen Kaufnachweis vor. Weitere Informationen: europa.eu/youreurope/garantien"
      class="notice"
    />
    <p class="source">
      Quelle: Durchführungsverordnung (EU) 2025/1960, Anhang I ·
      <a href="https://europa.eu/youreurope/garantien" rel="noopener noreferrer">europa.eu/youreurope/garantien</a>
    </p>
  </section>
</Layout>

<style>
  .warranty-page {
    max-width: 720px;
    margin: 0 auto;
    padding: 2rem 0 4rem;
    text-align: center;
  }

  .notice {
    width: 100%;
    height: auto;
    border: 2px solid #000;
    border-radius: 0;
  }

  .source {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-top: 1rem;
  }

  .source a {
    text-decoration: underline;
  }
</style>
