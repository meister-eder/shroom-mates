---
import { getCollection, getEntry } from "astro:content";
import GrowkitsPage from "../components/pages/GrowkitsPage.astro";

const entry = await getEntry("growkits-page", "content");
if (!entry) {
  throw new Error("growkits-page content not found");
}
const growkits = await getCollection("growkits");
---

<GrowkitsPage data={entry.data} growkits={growkits} />
