---
import Layout from "@layouts/Layout.astro";
import { WithdrawalForm } from "@modules/withdrawal/components/WithdrawalForm";
---

<Layout title="Vertrag widerrufen" description="Widerrufe deine Bestellung online." noindex>
  <section class="withdraw-page">
    <h1 class="section-heading">Vertrag widerrufen</h1>
    <p class="intro">
      Hier kannst du deinen Kaufvertrag innerhalb der Widerrufsfrist online widerrufen.
      Eine Begründung ist nicht nötig. Nach dem Absenden bekommst du sofort eine
      Eingangsbestätigung per E-Mail. Details zu Fristen und Rücksendung findest du
      in der <a href="/widerruf/">Widerrufsbelehrung</a>.
    </p>
    <WithdrawalForm client:load />
  </section>
</Layout>

<style>
  .withdraw-page {
    max-width: 680px;
    margin: 0 auto;
    padding: 2rem 0 4rem;
  }

  .intro {
    margin: 0 0 2rem;
    line-height: 1.6;
  }

  .intro a {
    text-decoration: underline;
  }
</style>
