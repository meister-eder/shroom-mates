---
export const prerender = false;

import { Image } from "astro:assets";
import Layout from "@layouts/Layout.astro";
import { listProducts, retrieveProduct } from "@lib/data/products";
import { getRegion } from "@lib/data/regions";
import { getProductPrice } from "@lib/utils/get-product-price";
import { serverImageSrc } from "@lib/utils/image";
import { stickerColor } from "@lib/utils/product-color";
import ImageCarouselWrapper from "@modules/products/components/product-details/image-carousel/ImageCarouselWrapper.astro";
import { ProductActions } from "@modules/products/components/product-details/ProductActions";
import ProductAttributes from "@modules/products/components/product-details/ProductAttributes.astro";
import Icon from "@shroom-mates/ui/Icon.astro";
import { jsonLd } from "@shroom-mates/ui/json-ld";
import { GROW_STEPS, SHIPPING } from "@shroom-mates/ui/shop-facts";
import { websiteUrl } from "@shroom-mates/ui/site";

const { handle } = Astro.params;

if (!handle) {
  return Astro.rewrite("/shop/not-found/");
}

const region = await getRegion();

if (!region) {
  return Astro.rewrite("/shop/not-found/");
}

let product: Awaited<ReturnType<typeof retrieveProduct>> | undefined;
let error: Error | undefined;

try {
  product = await retrieveProduct(handle, region.id);
} catch (e) {
  error = e instanceof Error ? e : new Error("Unknown error");
  console.error(error);
}

if (product === null) {
  return Astro.rewrite("/shop/not-found/");
}

// Old links used the product ID; send them to the readable URL.
if (product && handle !== product.handle) {
  return Astro.redirect(`/shop/${product.handle}/`, 301);
}

const {
  title,
  description,
  images,
  options,
  variants,
  material,
  origin_country,
  type,
  weight,
  length,
  width,
  height,
} = product ?? {};

const category = product?.categories?.[0];
const isGrowkit = product?.categories?.some((c) => c.handle === "growkits");
const color = stickerColor({ handle: product?.handle, title });

// Latin name only when the shop data has one (subtitle or metadata.latin_name)
const meta = (product?.metadata ?? {}) as Record<string, unknown>;
const text = (v: unknown) =>
  typeof v === "string" && v.trim() ? v.trim() : null;
const latinName = text(meta.latin_name) ?? text(product?.subtitle);
const contents = text(meta.inhalt);
const care = text(meta.pflege);
const hasAttributes = !!(
  material ||
  origin_country ||
  type?.value ||
  weight ||
  (length && width && height)
);

// "Passt dazu": one product from the other category, one from the same
let related: Awaited<ReturnType<typeof listProducts>> = [];
if (product) {
  try {
    const all = (await listProducts(region.id)).filter(
      (p) =>
        p.id !== product!.id &&
        !p.categories?.some((c) => c.handle === "frische-pilze"),
    );
    const sameCat = all.filter(
      (p) => p.categories?.[0]?.handle === category?.handle,
    );
    const otherCat = all.filter(
      (p) => p.categories?.[0]?.handle !== category?.handle,
    );
    related = [otherCat[0], sameCat[0]].filter(Boolean).slice(0, 2);
    if (related.length < 2) related = all.slice(0, 2);
  } catch (e) {
    console.error(e);
  }
}

// "Mehr über Lion's Mane →": variety name = title without product-type words
const varietyName = (title ?? "")
  .replace(/\b(growkit|tinktur|\d+\s?ml)\b/gi, "")
  .replace(/\s+/g, " ")
  .trim();
const firstHarvest =
  typeof meta.erste_ernte === "string" ? meta.erste_ernte : "";
const idealTemp = typeof meta.temperatur === "string" ? meta.temperatur : "";
const showVariety = !!varietyName && varietyName !== title;

const origin = Astro.site ?? Astro.url.origin;
const abs = (u: string) => new URL(u, origin).href;
const productUrl = abs(`/shop/${product?.handle ?? handle}/`);

let structuredData: unknown[] = [];
if (product) {
  Astro.response.headers.set(
    "Cache-Control",
    "public, max-age=60, stale-while-revalidate=600",
  );
  const imageUrls = (images ?? []).map((i) => abs(i.url));
  const shippingRate = Number.parseFloat(
    SHIPPING.standard.price.replace(",", "."),
  ).toFixed(2);
  const offers = (variants ?? [])
    .filter((v) => v.calculated_price?.calculated_amount != null)
    .map((v) => ({
      "@type": "Offer",
      ...(v.sku ? { sku: v.sku } : {}),
      url: productUrl,
      price: Number(v.calculated_price!.calculated_amount).toFixed(2),
      priceCurrency: "EUR",
      availability:
        v.inventory_quantity == null || v.inventory_quantity > 0
          ? "https://schema.org/InStock"
          : "https://schema.org/OutOfStock",
      itemCondition: "https://schema.org/NewCondition",
      shippingDetails: {
        "@type": "OfferShippingDetails",
        shippingRate: {
          "@type": "MonetaryAmount",
          value: shippingRate,
          currency: "EUR",
        },
        shippingDestination: {
          "@type": "DefinedRegion",
          addressCountry: "DE",
        },
      },
      hasMerchantReturnPolicy: {
        "@type": "MerchantReturnPolicy",
        applicableCountry: "DE",
        returnPolicyCategory:
          "https://schema.org/MerchantReturnFiniteReturnWindow",
        merchantReturnDays: 14,
        returnMethod: "https://schema.org/ReturnByMail",
      },
    }));
  const sku = (variants ?? []).find((v) => v.sku)?.sku;
  structuredData = [
    {
      "@context": "https://schema.org",
      "@type": "Product",
      name: title,
      ...(description ? { description } : {}),
      ...(imageUrls.length ? { image: imageUrls } : {}),
      ...(sku ? { sku } : {}),
      brand: { "@type": "Brand", name: "shroom-mates" },
      ...(offers.length ? { offers } : {}),
    },
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: [
        { name: "Shop", url: abs("/shop/") },
        ...(category
          ? [
              {
                name: category.name,
                url: abs(`/shop/?kategorie=${category.handle}`),
              },
            ]
          : []),
        { name: title, url: productUrl },
      ].map((c, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: c.name,
        item: c.url,
      })),
    },
  ];
}

import MatesLogo from "@shroom-mates/ui/MatesLogo.astro";
---

<Layout
  wide
  title={title}
  description={description ??
    `${title} — jetzt im Shroom-Mates Shop bestellen.`}
  image={images?.[0]?.url}
  type="product"
>
  {structuredData.map((d) => <script slot="head" type="application/ld+json" set:html={jsonLd(d)} />)}
  {error && <p class="error-banner" role="alert">Das Produkt konnte gerade nicht geladen werden. Bitte versuch es gleich noch einmal.</p>}
  {
    product && (
      <>
        <nav class="crumbs" aria-label="Brotkrumen">
          <a href="/shop/">Shop</a>
          {category && (
            <>
              <span aria-hidden="true">›</span>
              <a href={`/shop/?kategorie=${category.handle}`}>
                {category.name}
              </a>
            </>
          )}
          <span aria-hidden="true">›</span>
          <span aria-current="page">{title}</span>
        </nav>

        <div class="pdp">
          <div class="pdp__media">
            <ImageCarouselWrapper
              images={images ?? []}
              alt={title ?? "Produktbild"}
              color={color}
            />
          </div>

          <div class="pdp__info">
            {category && (
              <div class="pdp__pills">
                <span class={`cat-pill cat-pill--${color}`}>{category.name}</span>
              </div>
            )}
            <div>
              <h1 class="pdp__title">{title}</h1>
              {latinName && <p class="pdp__latin">{latinName}</p>}
            </div>
            {description && <p class="pdp__lead">{description}</p>}

            <ProductActions
              options={options ?? []}
              variants={variants ?? []}
              productId={product?.id ?? handle}
              productTitle={title ?? ""}
              regionId={region.id}
              client:load
            />

            <ul class="check-list" role="list">
              <li>
                <Icon name="check" size={22} strokeWidth={2.6} />
                Versand in {SHIPPING.standard.time.replace("Werktage", "Werktagen")}, ab {SHIPPING.standard.price}
              </li>
              {isGrowkit && firstHarvest && idealTemp && (
                <li>
                  <Icon name="check" size={22} strokeWidth={2.6} />
                  Erste Ernte {firstHarvest}, ideal {idealTemp}
                </li>
              )}
              <li>
                <Icon name="check" size={22} strokeWidth={2.6} />
                Selbst gezüchtet in der Glasfabrik Leutzsch
              </li>
              {!isGrowkit && (
                <li>
                  <Icon name="check" size={22} strokeWidth={2.6} />
                  Lieferung {SHIPPING.region}
                </li>
              )}
            </ul>

            <div class="accordion">
              {contents && (
                <details class="acc" id="inhalt" open>
                  <summary>Was drin ist</summary>
                  <p>{contents}</p>
                </details>
              )}
              {care && (
                <details class="acc" id="pflege" open={!contents}>
                  <summary>Pflege-Tipps</summary>
                  <p>{care}</p>
                </details>
              )}
              {hasAttributes && (
                <details class="acc" id="details" open={!contents && !care}>
                  <summary>Produktdetails</summary>
                  <ProductAttributes
                    material={material}
                    origin_country={origin_country}
                    type={type}
                    weight={weight}
                    length={length}
                    width={width}
                    height={height}
                  />
                </details>
              )}
              <details class="acc" id="versand" open={!contents && !care && !hasAttributes}>
                <summary>Versand &amp; Rückgabe</summary>
                <p>
                  Standard {SHIPPING.standard.price} ({SHIPPING.standard.time}), Express {SHIPPING.express.price} ({SHIPPING.express.time}).
                  Lieferung nur {SHIPPING.region}. Alle Preise
                  inkl. MwSt. Infos zum Widerruf findest du in der{" "}
                  <a href="/widerruf/">Widerrufsbelehrung</a>.
                </p>
              </details>
            </div>
          </div>
        </div>

        {isGrowkit && (
          <section class="how-band" aria-labelledby="how-title">
            <div class="how-band__inner">
              <h2 id="how-title" class="how-band__title">So einfach geht's</h2>
              <ol class="how-band__steps" role="list">
                {GROW_STEPS.map((step, i) => (
                  <li class="how-card">
                    <p class="how-card__num">{String(i + 1).padStart(2, "0")}</p>
                    <h3>{step.title}</h3>
                    <p>{step.text}</p>
                  </li>
                ))}
                <li class="how-card how-card--link">
                  <p class="how-card__cta">Ganze Anleitung</p>
                  <a href={websiteUrl("/growkits/")}>
                    Ansehen <span aria-hidden="true">→</span>
                  </a>
                </li>
              </ol>
            </div>
          </section>
        )}

        {(related.length > 0 || showVariety) && (
          <section class="pairs" aria-labelledby="pairs-title">
            <h2 id="pairs-title" class="pairs__title">Passt dazu</h2>
            <ul class="pairs__grid" role="list">
              {related.map((p) => {
                const price = getProductPrice({ productVariants: p.variants ?? [] }).cheapestPrice;
                const src = p.thumbnail ?? p.images?.[0]?.url;
                return (
                  <li class={`pair-card pair-card--${stickerColor({ handle: p.handle, title: p.title })}`}>
                    {src ? (
                      <Image
                        src={serverImageSrc(src)}
                        width={96}
                        height={96}
                        alt=""
                        format="webp"
                        loading="lazy"
                        class="pair-card__img"
                      />
                    ) : (
                      <span class="pair-card__img sticker-card__placeholder" aria-hidden="true" />
                    )}
                    <span>
                      <a href={`/shop/${p.handle}/`} class="pair-card__title">
                        {p.title}
                      </a>
                      {price && <span class="pair-card__price">{price.calculated_price}</span>}
                    </span>
                  </li>
                );
              })}
              {showVariety && (
                <li class="pair-card pair-card--more">
                  <MatesLogo alt="" width={96} class="pair-card__img pair-card__img--plain" />
                  <span>
                    <a href={websiteUrl("/unsere-pilze/")} class="pair-card__title">
                      Mehr über {varietyName} <span aria-hidden="true">→</span>
                    </a>
                    <span class="pair-card__sub">Alles zur Sorte</span>
                  </span>
                </li>
              )}
            </ul>
          </section>
        )}
      </>
    )
  }
</Layout>

<script>
  // Phones start with all accordions closed (mobile mockup)
  if (matchMedia("(max-width: 768px)").matches) {
    document.querySelectorAll(".accordion details[open]").forEach((d) => d.removeAttribute("open"));
  }
  // "zzgl. Versandkosten" jumps to the shipping accordion and opens it
  document.addEventListener("click", (e) => {
    const link = (e.target as Element | null)?.closest<HTMLAnchorElement>(
      'a[href="#versand"]',
    );
    if (!link) return;
    const details = document.getElementById("versand") as HTMLDetailsElement | null;
    if (details) details.open = true;
  });
</script>
