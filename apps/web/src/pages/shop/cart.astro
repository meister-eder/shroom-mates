---
export const prerender = false;

import Layout from "@layouts/Layout.astro";
import { CartPage } from "@modules/cart/components/CartPage";
import { CartSkeleton } from "@modules/cart/components/CartSkeleton";
---

<Layout
  shop
  title="Dein Pilzkorb"
  description="Überprüfe die Artikel in deinem Pilzkorb."
  noindex
  wide
>
  <!-- Client-only: rendered from the browser's cart -->
  <CartPage client:only="react">
    <CartSkeleton slot="fallback" />
  </CartPage>
</Layout>
