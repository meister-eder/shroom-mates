---
export const prerender = false;

import Layout from "@layouts/Layout.astro";
import { CartPage } from "@modules/cart/components/CartPage";
---

<Layout
  shop
  title="Dein Pilzkorb"
  description="Überprüfe die Artikel in deinem Pilzkorb."
  noindex
  wide
>
  <!-- Client-only: rendered from the browser's cart -->
  <CartPage client:only="react">
    <p slot="fallback" class="page-note">Pilzkorb wird geladen…</p>
  </CartPage>
</Layout>
