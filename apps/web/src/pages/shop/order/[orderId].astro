---
export const prerender = false;

import Layout from "@layouts/Layout.astro";
import { retrieveOrder } from "@lib/data/orders";
import { OrderConfirmedPage } from "@modules/order/components/OrderConfirmedPage";

const { orderId } = Astro.params;

const order = orderId ? await retrieveOrder(orderId) : null;
if (!order) {
  return Astro.rewrite("/404/");
}
---

<Layout shop title="Bestellung bestätigt" description="Deine Bestellung wurde bestätigt." noindex wide>
  <OrderConfirmedPage order={order} />
</Layout>

<script>
  // Umami "purchase" event: amount and currency only (no order ID, no e-mail)
  import { track } from "@lib/analytics";

  const el = document.querySelector<HTMLElement>("[data-purchase-total]");
  const revenue = Number(el?.dataset.purchaseTotal);
  if (el && Number.isFinite(revenue)) {
    const send = () =>
      track("purchase", {
        revenue,
        currency: el.dataset.purchaseCurrency || "EUR",
      });
    // The tracker script is deferred: wait until it has been executed
    if (document.readyState === "complete") send();
    else window.addEventListener("load", send, { once: true });
  }
</script>
