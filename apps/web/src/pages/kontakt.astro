---
import Icon from "@shroom-mates/ui/Icon.astro";
import LocationInfo from "../components/LocationInfo.astro";
import Layout from "../layouts/SiteLayout.astro";

const title =
  "Kontakt – Pilze, Growkits & Tinkturen bestellen in Leipzig | shroom-mates";
const description =
  "Frische Pilze, Growkits oder Tinkturen bestellen in Leipzig? Kontaktiere shroom-mates in Leutzsch. Für Privatkunden und Gastronomie, Lieferung in Leipzig und Versand per Post.";

const topics = [
  "Frische Pilze",
  "Growkits",
  "Tinkturen",
  "Gastronomie",
  "Etwas anderes",
];
---

<Layout title={title} description={description} active="kontakt" isLandingPage>
  <div class="contact-page">
    <section class="container contact-layout">
      <div class="contact-info">
        <h1 class="eyebrow contact-eyebrow">Kontakt: Pilze, Growkits &amp; Tinkturen bestellen in Leipzig</h1>
        <p class="contact-title">Schreib uns!</p>
        <a class="contact-mail" href="mailto:hey@shroom-mates.de">hey@shroom-mates.de</a>
        <p class="contact-intro">
          Wir liefern an Privatkunden und Gastronomiebetriebe in Leipzig. Fragen zu
          <a href="/unsere-pilze/">Pilzen</a>, <a href="/growkits/">Growkits</a> oder
          <a href="/tinkturen/">Tinkturen</a>? Oder brauchst du ein Angebot für dein
          <a href="/gastronomie/">Restaurant</a>? Schreib uns einfach.
        </p>

        <div class="contact-cards">
          <div class="contact-card contact-card--visit">
            <p class="label">Besuch</p>
            <p>
              Glasfabrik<br />
              Franz-Flemming-Straße 25<br />
              04179 Leipzig-Leutzsch
            </p>
            <a
              href="https://www.google.com/maps/search/?api=1&query=Franz-Flemming-Stra%C3%9Fe+25+Leipzig"
              target="_blank"
              rel="noopener noreferrer"
            >
              Route planen
            </a>
          </div>
          <div class="contact-card contact-card--insta">
            <p class="label">Daily Business</p>
            <p>Werksverkauf-Termine und was gerade wächst.</p>
            <a href="https://www.instagram.com/shroom_mates_le/" target="_blank" rel="noopener noreferrer">
              @shroom_mates_le
            </a>
          </div>
          <div class="contact-card contact-card--faq">
            <p class="label">Schnelle Antworten</p>
            <p>Lieferung, Lagerung, Growkits: vieles steht schon bei den häufigen Fragen.</p>
            <a href="/faq/">Zu den Fragen</a>
          </div>
        </div>
      </div>

      <div class="form-card">
        <form method="POST" id="form" class="contact-form">
          <input
            type="hidden"
            name="access_key"
            value="d69f2b91-fe55-4258-97a9-6bb53285b5e2"
          />
          <input type="hidden" name="topic" value="" />

          <fieldset class="contact-topics">
            <legend class="field__label">Worum geht's?</legend>
            <div class="contact-topics__chips">
              {
                topics.map((topic) => (
                  <button type="button" class="chip" data-topic={topic} aria-pressed="false">
                    {topic}
                  </button>
                ))
              }
            </div>
          </fieldset>

          <div class="contact-row">
            <div class="field">
              <label for="name">Name</label>
              <input type="text" id="name" name="name" autocomplete="name" required />
            </div>
            <div class="field">
              <label for="email">E-Mail</label>
              <input type="email" id="email" name="email" autocomplete="email" required />
            </div>
          </div>

          <div class="field">
            <label for="message">Nachricht</label>
            <textarea id="message" name="message" rows="5" required></textarea>
          </div>

          <button type="submit" class="btn btn--primary contact-submit">
            Ab geht die Post <Icon name="arrow-right" size={20} />
          </button>
          <div id="result" class="contact-result" role="status" aria-live="polite"></div>
        </form>
      </div>
    </section>

    <script>
      import "../scripts/contact-form.ts";
    </script>

    <LocationInfo />
  </div>
</Layout>

<style>
  .contact-page {
    overflow-x: clip;
  }

  .contact-layout {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 56px;
    padding-top: 40px;
    padding-bottom: 96px;
  }

  .contact-info {
    flex: 1 1 420px;
    min-width: 0;
  }

  .contact-eyebrow {
    margin-bottom: 18px;
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .contact-title {
    margin: 0 0 32px;
    font-family: var(--font-display);
    font-weight: 900;
    font-variation-settings: "SOFT" 100, "WONK" 1;
    font-size: clamp(48px, 7vw, 104px);
    line-height: 0.9;
    color: var(--color-accent);
  }

  .contact-mail {
    display: inline-block;
    font-family: var(--font-display);
    font-weight: 900;
    font-variation-settings: "SOFT" 100;
    font-size: clamp(1.5rem, 3.4vw, 2.75rem);
    color: var(--color-ink);
    text-decoration-thickness: 3px;
    text-underline-offset: 6px;
    overflow-wrap: anywhere;
  }

  .contact-mail:hover {
    color: var(--color-accent-dark);
  }

  .contact-intro {
    max-width: 44ch;
    margin: 24px 0 0;
    font-size: 1.125rem;
    line-height: 1.55;
  }

  .contact-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
    gap: 18px;
    margin-top: 40px;
  }

  .contact-card {
    padding: 22px;
    border: 3px solid var(--color-ink);
    border-radius: 0;
    box-shadow: 6px 6px 0 var(--color-ink);
  }

  .contact-card--visit {
    background: var(--color-lavender);
  }

  .contact-card--insta {
    background: var(--color-pink);
  }

  .contact-card--faq {
    background: var(--color-paper);
  }

  .contact-card .label {
    margin-bottom: 6px;
    font-size: 0.75rem;
  }

  .contact-card p:not(.label) {
    margin: 0 0 12px;
    font-size: 1.0625rem;
    line-height: 1.5;
  }

  .contact-card a {
    color: var(--color-ink);
    font-weight: 700;
    overflow-wrap: anywhere;
  }

  .contact-intro a {
    font-weight: 700;
  }

  /* ── Formular ───────────────────────────────────── */
  .form-card {
    flex: 1 1 480px;
    min-width: 0;
    padding: 36px;
    background: var(--color-white);
    border: 3px solid var(--color-ink);
    border-radius: 0;
    box-shadow: var(--shadow-teaser);
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .contact-topics {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .contact-topics legend {
    margin-bottom: 10px;
    padding: 0;
  }

  .contact-topics__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  /* gewählt = Orange mit Tinte-Text (Mockup), sonst Creme */
  .contact-topics .chip {
    background: var(--color-cream);
  }

  .contact-topics .chip:hover {
    background: var(--color-paper);
  }

  .contact-topics .chip[aria-pressed="true"] {
    border-color: var(--color-ink);
    background: var(--color-accent);
    color: var(--color-cream);
  }

  .contact-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
    gap: 16px;
  }

  .contact-form :global(.field input),
  .contact-form :global(.field textarea) {
    padding: 14px 16px;
    font-size: 1.0625rem;
  }

  .contact-submit {
    align-self: flex-start;
    padding: 16px 28px;
    font-size: 1.125rem;
  }

  .contact-result {
    min-height: 1.5em;
    font-weight: 600;
  }

  .contact-result:empty {
    min-height: 0;
  }

  @media (max-width: 768px) {
    .contact-layout {
      gap: 40px;
      padding-bottom: 64px;
    }

    .form-card {
      padding: 22px 18px;
      border-radius: 0;
      box-shadow: 6px 6px 0 var(--color-ink);
    }

    .contact-card {
      box-shadow: 4px 4px 0 var(--color-ink);
    }

    .contact-submit {
      align-self: stretch;
    }
  }
</style>
