---
import Icon from "@shroom-mates/ui/Icon.astro";

interface Props {
  regionId?: string | null;
}

const { regionId } = Astro.props;
// On the cart and checkout pages the pill is a plain link instead of the drawer toggle.
const onCartPage = /^\/shop\/(cart|checkout)(\/|$)/.test(Astro.url.pathname);
---

{
  onCartPage ? (
    <a
      href="/shop/cart/"
      class="cart-pill"
      aria-label="Pilzkorb, 0 Artikel"
      data-cart-button
      data-region-id={regionId ?? undefined}
    >
      <Icon name="cart" size={20} />
      <span class="cart-pill__label" aria-hidden="true">
        Pilzkorb
      </span>
      <span class="cart-pill__count" aria-hidden="true" data-cart-count>
        0
      </span>
    </a>
  ) : (
    <button
      type="button"
      class="cart-pill"
      aria-label="Pilzkorb, 0 Artikel"
      aria-haspopup="dialog"
      data-cart-button
      data-region-id={regionId ?? undefined}
    >
      <Icon name="cart" size={20} />
      <span class="cart-pill__label" aria-hidden="true">Pilzkorb</span>
      <span class="cart-pill__count" aria-hidden="true" data-cart-count>0</span>
    </button>
  )
}

<script>
  import {
    $cartItemCount,
    $regionId,
    getCartId,
    initCart,
    toggleCartSidebar,
  } from "@lib/stores/cart";

  for (const button of document.querySelectorAll<HTMLElement>(
    "[data-cart-button]",
  )) {
    const count = button.querySelector("[data-cart-count]");
    $cartItemCount.subscribe((n) => {
      button.classList.toggle("has-items", n > 0);
      button.setAttribute("aria-label", `Pilzkorb, ${n} Artikel`);
      if (count) count.textContent = String(n);
    });
    if (button instanceof HTMLButtonElement) {
      button.addEventListener("click", () => toggleCartSidebar());
    }
    const regionId = button.dataset.regionId;
    if (regionId) {
      $regionId.set(regionId);
      initCart();
    } else if (getCartId()) {
      // Prerendered page without region: load the existing cart (and its region)
      initCart();
    }
  }
</script>
