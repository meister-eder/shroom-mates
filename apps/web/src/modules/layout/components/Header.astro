---
// Header of the whole site (shared SiteHeader): the Pilzkorb pill sits right
// next to "Kontakt". Same header and ticker on every page.
import SiteHeader from "@shroom-mates/ui/SiteHeader.astro";
import { SHIPPING } from "@shroom-mates/ui/shop-facts";
import type { NavKey } from "@shroom-mates/ui/site";
import CartButton from "./CartButton.astro";

interface Props {
  regionId?: string | null;
  active?: NavKey;
}

const { regionId = null, active } = Astro.props;

// Marquee above the header (every page): only verifiable statements
const ticker = [
  "Neu: Wir sind in die Glasfabrik Leutzsch umgezogen",
  "Edel- und Vitalpilze aus Leipzig-Leutzsch",
  "Frische Pilze, Growkits & Tinkturen",
  "Alles selbst gezüchtet",
  `Versand in ${SHIPPING.standard.time.replace("Werktage", "Werktagen")}`,
  "Selbst gezüchtet in Leipzig",
  "Sicher bezahlen mit SumUp",
  `Versand ab ${SHIPPING.standard.price}`,
];
---

<SiteHeader active={active} ticker={ticker}>
  <CartButton slot="cart" regionId={regionId} />
</SiteHeader>
