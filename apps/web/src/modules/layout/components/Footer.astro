---
// Shared footer. Shop pages (`shop`) show the legal links incl. AGB / Widerruf /
// Gewährleistung and the § 356a BGB withdrawal function.
import SharedFooter from "@shroom-mates/ui/Footer.astro";

interface Props {
  shop?: boolean;
}

const { shop = false } = Astro.props;
---

{
  shop ? (
    <SharedFooter legalExtended>
      <a slot="actions" href="/vertrag-widerrufen/">
        Vertrag widerrufen
      </a>
    </SharedFooter>
  ) : (
    <SharedFooter />
  )
}
