---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Icon from "@shroom-mates/ui/Icon.astro";
import PageHero from "@shroom-mates/ui/PageHero.astro";
import emmiAusternpilz from "../../assets/images/fotos/emmi-austernpilz.jpg";
import rosenseitling from "../../assets/images/fotos/rosenseitling-bueschel.jpg";
import timFreigestellt from "../../assets/images/fotos/tim-freigestellt.png";

interface Props {
  data: CollectionEntry<"about-us-page">["data"];
}

const {
  title,
  description,
  heroTitle,
  heroSubtitle,
  heroName,
  heroEmmiAlt,
  heroTimAlt,
  timeline,
  values,
  where,
  whoWeAre,
  howWeWork,
  valuesIntro,
  whereText,
} = Astro.props.data;

const mapsLink =
  "https://www.google.com/maps/search/?api=1&query=Franz-Flemming-Stra%C3%9Fe+25+Leipzig";
---

<Layout title={title} description={description} active="ueber-uns" isLandingPage>
  <div class="about-page">
    <PageHero eyebrow={`${heroTitle} – ${heroSubtitle}`} title={heroName}>
      <Fragment set:html={whoWeAre[0] ?? ""} />
      <div slot="media" class="about-hero__photos">
        <div class="dots" aria-hidden="true"></div>
        <Image
          src={emmiAusternpilz}
          alt={heroEmmiAlt}
          class="about-hero__emmi"
          widths={[320, 480, 640, 800]}
          sizes="(max-width: 900px) 70vw, 400px"
          loading="eager"
          format="webp"
        />
        <Image
          src={timFreigestellt}
          alt={heroTimAlt}
          class="about-hero__tim"
          widths={[200, 320, 480]}
          sizes="(max-width: 900px) 34vw, 200px"
          loading="eager"
        />
      </div>
    </PageHero>

    <section class="section section--night section--no-border timeline" aria-labelledby="timeline-heading">
      <div class="container">
        <h2 id="timeline-heading">{timeline.title}</h2>
        <ol class="timeline__grid" role="list">
          {
            timeline.items.map((step) => (
              <li class="timeline__item">
                {step.image ? (
                  <Image
                    src={step.image}
                    alt={step.imageAlt ?? ""}
                    class="timeline__img"
                    widths={[320, 480, 640]}
                    sizes="(max-width: 768px) 90vw, 400px"
                    format="webp"
                  />
                ) : (
                  <div class="timeline__img timeline__placeholder" aria-hidden="true" />
                )}
                <div class="timeline__body">
                  {step.year && <p class="timeline__year">{step.year}</p>}
                  <h3 class="timeline__title">{step.title}</h3>
                  <p>{step.text}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="container work" aria-labelledby="work-heading">
      <div class="work__col">
        <h2 id="work-heading" class="work__heading">Wer wir sind</h2>
        {whoWeAre.slice(1).map((p) => <p set:html={p} />)}
      </div>
      <div class="work__col">
        <h2 class="work__heading">Wie wir arbeiten</h2>
        {howWeWork.map((p) => <p set:html={p} />)}
      </div>
    </section>

    <section class="container values" aria-labelledby="values-heading">
      <h2 id="values-heading" class="eyebrow values__eyebrow">Das ist uns wichtig</h2>
      {valuesIntro.map((p) => <p class="values__intro" set:html={p} />)}
      <ol class="values__list" role="list">
        {
          values.map((v, i) => (
            <li class="values__row">
              <p class="values__num">{String(i + 1).padStart(2, "0")}</p>
              <h3 class="values__title">{v.title}</h3>
              <p class="values__text" set:html={v.text} />
              <div class="arch-frame values__frame">
                <Image
                  src={v.image}
                  alt={v.imageAlt}
                  widths={[180, 360, 540]}
                  sizes="180px"
                  format="webp"
                />
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="section section--paper where" aria-labelledby="where-heading">
      <div class="container where__inner">
        <div class="where__copy">
          <p class="eyebrow">Wo ihr uns findet</p>
          <h2 id="where-heading">{where.title}</h2>
          <address class="where__address">{where.address}</address>
          {whereText.map((p) => <p class="where__text" set:html={p} />)}
          <div class="where__actions">
            <a class="btn btn--primary where__btn" href={mapsLink} target="_blank" rel="noopener noreferrer">
              <Icon name="map-pin" size={20} /> {where.routeButton}
            </a>
            <a class="btn btn--secondary where__btn" href="/kontakt/">{where.visitButton}</a>
          </div>
        </div>
        <div class="arch-frame where__photo">
          <Image
            src={rosenseitling}
            alt={where.imageAlt}
            widths={[320, 480, 640]}
            sizes="(max-width: 900px) 90vw, 460px"
            format="webp"
          />
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .about-page {
    overflow-x: clip;
  }

  /* ── Hero (Gerüst in PageHero) ──────────────────── */
  .about-hero__photos {
    position: relative;
    padding: 24px;
  }

  .about-hero__photos .dots {
    position: absolute;
    inset: 0 40px 40px 0;
    border-radius: 0;
  }

  .about-hero__photos :global(.about-hero__emmi) {
    position: relative;
    display: block;
    width: 78%;
    height: 500px;
    object-fit: cover;
    border: 3px solid var(--color-ink);
    border-radius: 0;
    box-shadow: var(--shadow-teaser);
    transform: rotate(-2deg);
    box-sizing: border-box;
  }

  .about-hero__photos :global(.about-hero__tim) {
    position: absolute;
    right: 0;
    bottom: -20px;
    width: 46%;
    height: auto;
    filter: drop-shadow(6px 6px 0 var(--color-ink));
  }

  /* ── Zeitleiste ─────────────────────────────────── */
  .timeline {
    padding: 88px 0;
    background: var(--color-ink);
    color: var(--color-cream);
  }

  .timeline h2 {
    margin-bottom: 48px;
    color: var(--color-accent-light);
  }

  .timeline__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: 18px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .timeline__item {
    overflow: hidden;
    background: var(--color-cream);
    color: var(--color-ink);
    border-radius: 0;
  }

  .timeline__item :global(.timeline__img),
  .timeline__placeholder {
    display: block;
    width: 100%;
    height: 200px;
    object-fit: cover;
    border-bottom: 3px solid var(--color-ink);
  }

  .timeline__placeholder {
    background:
      radial-gradient(rgba(29, 29, 29, 0.13) 1.4px, transparent 1.5px) 0 0 / 12px 12px,
      var(--color-pink);
  }

  .timeline__body {
    padding: 18px 20px 22px;
  }

  .timeline__year {
    margin: 0 0 6px;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-accent-dark);
  }

  .timeline__title {
    margin: 0 0 6px;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.625rem;
  }

  .timeline__body p:not(.timeline__year) {
    margin: 0;
    font-size: 1rem;
    line-height: 1.5;
  }

  /* ── Wie wir arbeiten / Wer wir sind ────────────── */
  .work {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 48px 64px;
    padding-top: 96px;
  }

  .work__heading {
    margin-bottom: 20px;
    font-size: clamp(36px, 4.4vw, 56px);
    color: var(--color-accent);
  }

  .work__col p {
    max-width: 52ch;
    margin: 0 0 1rem;
    font-size: 1.125rem;
    line-height: 1.6;
  }

  /* ── Das ist uns wichtig ────────────────────────── */
  .values {
    padding-top: 96px;
    padding-bottom: 96px;
  }

  .values__eyebrow {
    margin-bottom: 20px;
    font-size: 0.9375rem;
    font-weight: 500;
  }

  .values__intro {
    max-width: 62ch;
    margin: 0 0 32px;
    font-size: 1.1875rem;
    line-height: 1.55;
  }

  .values__list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 3px solid var(--color-ink);
  }

  .values__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 24px 48px;
    padding: 36px 0;
    border-bottom: 3px solid var(--color-ink);
  }

  .values__num {
    flex: 0 0 80px;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.9375rem;
  }

  .values__title {
    flex: 1 1 300px;
    margin: 0;
    font-family: var(--font-display);
    font-weight: 900;
    font-variation-settings: "SOFT" 100, "WONK" 1;
    font-size: clamp(48px, 6vw, 88px);
    line-height: 0.9;
    color: var(--color-accent);
    hyphens: manual;
    overflow-wrap: normal;
    word-break: normal;
  }

  .values__text {
    flex: 1 1 280px;
    margin: 0;
    font-size: 1.1875rem;
    line-height: 1.5;
  }

  .values__text :global(a) {
    color: var(--color-ink);
  }

  .values__frame {
    flex: 0 0 180px;
    width: 180px;
    height: 220px;
    border-radius: 100px 100px 0 0;
    box-shadow: none;
  }

  /* ── Wo ihr uns findet ──────────────────────────── */
  .where__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 48px;
  }

  .where__copy {
    flex: 1 1 420px;
    min-width: 0;
  }

  .where__copy h2 {
    margin: 10px 0 16px;
  }

  .where__address {
    margin-bottom: 12px;
    font-size: 1.1875rem;
    font-style: normal;
    font-weight: 700;
  }

  .where__text {
    max-width: 44ch;
    margin: 0 0 1rem;
    font-size: 1.125rem;
    line-height: 1.55;
  }

  .where__text :global(a) {
    color: var(--color-accent-dark);
    font-weight: 700;
  }

  .where {
    padding: 88px 0;
  }

  .where__btn {
    padding: 16px 26px;
    font-size: 1.125rem;
  }

  .where__btn.btn--secondary {
    box-shadow: none;
  }

  .where__btn.btn--secondary:hover {
    background: var(--color-white);
  }

  .where__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 24px;
  }

  .where__photo {
    flex: 1 1 460px;
    min-width: 0;
    height: 380px;
    border-radius: 0;
    box-shadow: 8px 8px 0 var(--color-ink);
  }

  @media (max-width: 900px) {
    .about-hero__photos :global(.about-hero__emmi) {
      height: 420px;
    }

    .work {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 768px) {
    .about-hero__photos {
      padding: 16px 12px 28px;
    }

    .about-hero__photos :global(.about-hero__emmi) {
      height: 340px;
      box-shadow: 6px 6px 0 var(--color-ink);
    }

    .work,
    .values {
      padding-top: 56px;
    }

    .values {
      padding-bottom: 56px;
    }

    .values__row {
      gap: 16px 24px;
      padding: 28px 0;
    }

    .values__num {
      flex-basis: 100%;
    }

    .where__photo {
      height: 320px;
      box-shadow: 6px 6px 0 var(--color-ink);
    }

    .timeline,
    .where {
      padding: 56px 0;
    }
  }

  @media (max-width: 480px) {
    .values__frame {
      flex-basis: 140px;
      width: 140px;
      height: 180px;
    }
  }
</style>
