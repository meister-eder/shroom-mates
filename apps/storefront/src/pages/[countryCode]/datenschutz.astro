---
import Layout from "@layouts/Layout.astro";
import LegalPage from "@shroom-mates/ui/LegalPage.astro";
import { Content } from "@shroom-mates/ui/legal/datenschutz-shop.md";

const { countryCode } = Astro.params;
if (!countryCode) return Astro.rewrite("/404");
---

<Layout title="Datenschutzerklärung" description="Datenschutzerklärung für den Online-Shop von shroom-mates">
  <LegalPage title="Datenschutzerklärung">
    <Content />
  </LegalPage>
</Layout>
