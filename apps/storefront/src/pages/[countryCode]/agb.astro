import LegalPage from "@shroom-mates/ui/LegalPage.astro";
import { Content } from "@shroom-mates/ui/legal/agb.md";

const { countryCode } = Astro.params;
if (!countryCode) return Astro.rewrite("/404");
---

<Layout title="Allgemeine Geschäftsbedingungen" description="AGB für den Online-Shop von shroom-mates">
  <LegalPage title="Allgemeine Geschäftsbedingungen">
    <Content />
  </LegalPage>
</Layout>
