---
import Layout from "@layouts/Layout.astro";
import { getRegion } from "@lib/data/regions";
import { loadCatalog } from "@modules/store/catalog";
import StoreCatalog from "@modules/store/components/StoreCatalog.astro";

const { countryCode } = Astro.params;

const region = await getRegion(countryCode);
if (!region) {
  return Astro.redirect("/not-found");
}

const catalog = await loadCatalog(region.id);
const activeCategory = Astro.url.searchParams.get("kategorie") ?? "";
---

<Layout
  wide
  description="Growkits und Pilztinkturen aus Leipzig — direkt vom Erzeuger online bestellen."
  image={catalog.products[0]?.thumbnail ?? undefined}
>
  <StoreCatalog
    {...catalog}
    basePath={`/${countryCode}`}
    activeCategory={activeCategory}
  />
</Layout>
