---
import Layout from "@layouts/Layout.astro";
import { getRegionParams } from "@lib/params/region-params";
import { CartPage } from "@modules/cart/components/CartPage";

export const getStaticPaths = getRegionParams;

const { countryCode } = Astro.params;

if (!countryCode) {
  return Astro.redirect("/not-found");
}
---

<Layout
  title="Warenkorb"
  description="Überprüfe die Artikel in deinem Warenkorb."
  noindex
>
  <!-- Client-only: rendered from the browser's cart -->
  <CartPage client:only="react" countryCode={countryCode}>
    <p slot="fallback" class="text-muted text-center py-16">Warenkorb wird geladen…</p>
  </CartPage>
</Layout>
