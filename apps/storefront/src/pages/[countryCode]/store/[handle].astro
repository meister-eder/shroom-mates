---
import Layout from "@layouts/Layout.astro";
import { retrieveProduct } from "@lib/data/products";
import { getRegion } from "@lib/data/regions";
import { getProductPrice } from "@lib/utils/get-product-price";
import ImageCarouselWrapper from "@modules/products/components/product-details/image-carousel/ImageCarouselWrapper.astro";
import { ProductActions } from "@modules/products/components/product-details/ProductActions";
import ProductAttributes from "@modules/products/components/product-details/ProductAttributes.astro";

const { countryCode, handle } = Astro.params;

if (!countryCode || !handle) {
  return Astro.redirect("/not-found");
}

const region = await getRegion(countryCode);

if (!region) {
  return Astro.redirect("/not-found");
}

let product: Awaited<ReturnType<typeof retrieveProduct>> | undefined;
let error: Error | undefined;

try {
  product = await retrieveProduct(handle, region.id);
} catch (e) {
  error = e instanceof Error ? e : new Error("Unknown error");
  console.error(error);
}

if (product === null) {
  return Astro.rewrite("/404");
}

// Old links used the product ID; send them to the readable URL.
if (product && handle !== product.handle) {
  return Astro.redirect(`/${countryCode}/store/${product.handle}`, 301);
}

const {
  title,
  description,
  images,
  options,
  variants,
  material,
  origin_country,
  type,
  weight,
  length,
  width,
  height,
} = product ?? {};

const { cheapestPrice } = getProductPrice({
  productVariants: variants ?? [],
});
---

<Layout
  title={title}
  description={description ??
    `${title} — jetzt im Shroom-Mates Shop bestellen.`}
  image={images?.[0]?.url}
  type="product"
>
  {error && <p class="text-red-700">{error.message}</p>}
  {
    product && (
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 px-8 py-8 max-w-[1200px] mx-auto">
        <ImageCarouselWrapper
          images={images ?? []}
          alt={title ?? "Produktbild"}
        />

        <div class="flex flex-col gap-12">
          <div class="flex flex-col gap-4">
            <h1 class="text-4xl font-bold">{title}</h1>
            <p class="text-gray-600">{description}</p>
            <p
              class="text-3xl font-bold"
              style="color: var(--accent, #ff4908);"
            >
              {cheapestPrice?.calculated_price}
            </p>
            <p class="text-sm text-muted -mt-3">inkl. MwSt., zzgl. Versandkosten</p>
          </div>

          <ProductActions
            options={options ?? []}
            variants={variants ?? []}
            productId={product?.id ?? handle}
            regionId={region.id}
            client:load
          />

          <ProductAttributes
            material={material}
            origin_country={origin_country}
            type={type}
            weight={weight}
            length={length}
            width={width}
            height={height}
          />
        </div>
      </div>
    )
  }
</Layout>
