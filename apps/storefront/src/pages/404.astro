---
// Standalone: the shop Layout needs a country code and would redirect.
import "@shroom-mates/ui/fonts";
import "@shroom-mates/ui/base.css";
import "@styles/global.css";
import "@styles/shop.css";
import { WEBSITE_URL } from "@shroom-mates/ui/site";

const DEFAULT_REGION = import.meta.env.DEFAULT_REGION || "de";
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Seite nicht gefunden | Shroom-Mates Shop</title>
  </head>
  <body>
    <main class="not-found">
      <img src="/mascot.webp" alt="" aria-hidden="true" width="180" height="180" />
      <p class="not-found__code">404</p>
      <h1 class="not-found__title">Diese Seite ist uns entwischt.</h1>
      <p>Den Link gibt es nicht (mehr). Hier geht's weiter:</p>
      <div class="not-found__actions">
        <a href={`/${DEFAULT_REGION}/store`} class="btn btn--primary">Zum Sortiment</a>
        <a href={WEBSITE_URL} class="btn btn--secondary">Zur Website</a>
      </div>
    </main>
  </body>
</html>
