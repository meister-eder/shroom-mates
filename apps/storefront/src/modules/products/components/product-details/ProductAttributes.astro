---
interface Props {
  material?: string | null;
  origin_country?: string | null;
  type?: { value: string } | null;
  weight?: number | null;
  length?: number | null;
  width?: number | null;
  height?: number | null;
}

const { material, origin_country, type, weight, length, width, height } =
  Astro.props;

// Only show attributes that are actually filled in
const rows = [
  ["Material", material],
  ["Herkunftsland", origin_country],
  ["Typ", type?.value],
  ["Gewicht", weight ? `${weight} g` : null],
  ["Maße", length && width && height ? `${length} × ${width} × ${height}` : null],
].filter((row): row is [string, string] => !!row[1]);
---

{
  rows.length > 0 && (
    <dl class="spec-list">
      {rows.map(([label, value]) => (
        <div>
          <dt>{label}</dt>
          <dd>{value}</dd>
        </div>
      ))}
    </dl>
  )
}
