---
import { Image } from "astro:assets";
import { serverImageSrc } from "@lib/utils/image";

interface Props {
  imageUrl?: string;
  title: string;
  priority?: boolean;
}

const { imageUrl, title, priority = false } = Astro.props;
---

{
  imageUrl ? (
    <Image
      class="product-tile__img"
      src={serverImageSrc(imageUrl)}
      width={600}
      height={600}
      alt={title}
      widths={[300, 450, 600]}
      sizes="(max-width: 640px) 46vw, (max-width: 1024px) 48vw, 320px"
      format="webp"
      quality={80}
      loading={priority ? "eager" : "lazy"}
      fetchpriority={priority ? "high" : "auto"}
    />
  ) : (
    <div class="product-tile__img product-tile__placeholder" role="img" aria-label={title}></div>
  )
}
