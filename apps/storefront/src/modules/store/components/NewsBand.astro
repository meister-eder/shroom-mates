---
// "news" band: light lilac band with wave edges and a mushroom that rolls
// along the top wave while scrolling (Snack-News style).
import { Image } from "astro:assets";
import { websiteUrl } from "@shroom-mates/ui/site";
import WaveDivider from "@shroom-mates/ui/WaveDivider.astro";
import lionsMane from "@assets/lions-mane-makro.webp";
import growkits from "@assets/hero-growkits.jpg";
import markttisch from "@assets/emmi-glasfabrik-markttisch.jpg";
import schneidebrett from "@assets/schneidebrett.jpg";

const news = [
  { title: "Lieber frische Pilze? Unsere Sorten", href: websiteUrl("/unsere-pilze/"), img: lionsMane, alt: "Lion's Mane in Nahaufnahme" },
  { title: "So klappt die erste Ernte", href: websiteUrl("/growkits/"), img: growkits, alt: "Growkits mit Pilzen" },
  { title: "Wir sind in die Glasfabrik gezogen", href: websiteUrl("/ueber-uns/"), img: markttisch, alt: "Markttisch mit Pilzen in der Backsteinhalle" },
  { title: "Pilze für deine Restaurantküche", href: websiteUrl("/gastronomie/"), img: schneidebrett, alt: "Pioppino und Seitlinge auf dem Schneidebrett" },
];
---

<div class="news-wrap" data-news-wrap>
  <div class="news-roll" data-news-roll aria-hidden="true">
    <svg viewBox="0 0 36 36" width="48" height="48">
      <rect x="12" y="17" width="12" height="17" rx="4" fill="#fffdf5" stroke="#1c1a33" stroke-width="2"></rect>
      <path d="M3 20a15 14 0 0 1 30 0z" fill="#7d4d2c" stroke="#1c1a33" stroke-width="2" stroke-linejoin="round"></path>
      <circle cx="15.5" cy="25" r="1.1" fill="#1c1a33"></circle>
      <circle cx="20.5" cy="25" r="1.1" fill="#1c1a33"></circle>
      <path d="M15.2 28.6q2.8 2.6 5.6 0" fill="none" stroke="#1c1a33" stroke-width="1.3" stroke-linecap="round"></path>
      <circle cx="12" cy="13" r="2" fill="#fffdf5"></circle>
      <circle cx="22" cy="10" r="2.2" fill="#fffdf5"></circle>
      <circle cx="27" cy="16" r="1.6" fill="#fffdf5"></circle>
    </svg>
  </div>
  <WaveDivider color="var(--color-paper)" />
  <section class="news" aria-labelledby="news-title">
    <div class="news__inner">
      <h2 id="news-title" class="news__title">news</h2>
      <ul class="news__grid" role="list">
        {
          news.map((n) => (
            <li>
              <a class="tile" href={n.href}>
                <div class="tile__ph">
                  <Image src={n.img} alt={n.alt} widths={[300, 520]} sizes="(max-width: 640px) 46vw, 300px" />
                </div>
                <h3 class="tile__title">{n.title}</h3>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
  <WaveDivider color="var(--color-paper)" flip />
</div>

<script>
  // Mushroom rolls along the top wave: scrolling down = right, up = back;
  // it turns around at the edges. Static when reduced motion is requested.
  const wrap = document.querySelector<HTMLElement>("[data-news-wrap]");
  const roll = document.querySelector<HTMLElement>("[data-news-roll]");
  if (wrap && roll && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const W = 1440;
    const M = 40;
    const span = W - 2 * M;
    const path = document.createElementNS("http://www.w3.org/2000/svg", "path");
    path.setAttribute(
      "d",
      "M0 28C80 6 160 6 240 28S400 50 480 28 640 6 720 28 880 50 960 28 1120 6 1200 28 1360 50 1440 28",
    );
    const len = path.getTotalLength();
    const waveY = (x: number) => {
      let lo = 0;
      let hi = len;
      for (let i = 0; i < 24; i++) {
        const mid = (lo + hi) / 2;
        if (path.getPointAtLength(mid).x < x) lo = mid;
        else hi = mid;
      }
      return path.getPointAtLength(hi).y;
    };
    let offset = 0;
    let lastY = window.scrollY;
    let frame = 0;
    const draw = () => {
      frame = 0;
      const t = (((offset * 0.9) % (2 * span)) + 2 * span) % (2 * span);
      const rx = M + (t <= span ? t : 2 * span - t);
      const h = wrap.querySelector("svg.wave-divider")?.getBoundingClientRect().height ?? 56;
      const scale = h / 56;
      const ry = waveY(rx) * scale;
      roll.style.left = `${(rx / W) * 100}%`;
      roll.style.top = `${Math.round(ry - 45)}px`;
      roll.style.transform = `rotate(${Math.round((rx / 24) * 57.3)}deg)`;
    };
    const schedule = () => {
      if (!frame) frame = requestAnimationFrame(draw);
    };
    addEventListener(
      "scroll",
      () => {
        offset += window.scrollY - lastY;
        lastY = window.scrollY;
        schedule();
      },
      { passive: true },
    );
    addEventListener("resize", schedule);
    draw();
  } else if (roll) {
    roll.style.display = "none";
  }
</script>

<style>
  .news-wrap {
    position: relative;
  }

  .news-roll {
    position: absolute;
    z-index: 2;
    left: 50%;
    top: 0;
    width: 48px;
    height: 48px;
    margin-left: -24px;
    pointer-events: none;
  }

  .news {
    padding: 40px var(--page-gutter, 32px);
    background: var(--color-paper);
  }

  .news__inner {
    max-width: 1312px;
    margin: 0 auto;
  }

  .news__title {
    margin: 0 0 32px;
    font-size: clamp(48px, 7vw, 104px);
    line-height: 0.85;
    letter-spacing: -0.02em;
    color: var(--color-accent);
  }

  .news__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 40px 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tile {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .tile__ph {
    overflow: hidden;
    border: 2px solid var(--color-accent);
    aspect-ratio: 1 / 1.05;
  }

  .tile__ph :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.35s ease;
  }

  .tile:hover .tile__ph :global(img) {
    transform: scale(1.05);
  }

  .tile__title {
    margin: 14px 0 0;
    font-size: 19px;
    font-weight: 800;
    line-height: 1.15;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    color: var(--color-accent-dark);
  }

  .tile:hover .tile__title {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }

  @media (max-width: 768px) {
    .news-roll {
      transform-origin: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tile__ph :global(img) {
      transition: none;
    }
  }
</style>
