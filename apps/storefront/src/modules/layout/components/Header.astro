---
// Same header as the website (shared component); the cart sits next to Instagram.
import SiteHeader from "@shroom-mates/ui/SiteHeader.astro";
import { navLinks, websiteUrl } from "@shroom-mates/ui/site";
import { CartButton } from "./CartButton";

interface Props {
  countryCode: string;
  regionId: string | null;
}

const { countryCode, regionId } = Astro.props;
---

<SiteHeader
  homeHref={`/${countryCode}`}
  links={navLinks(websiteUrl)}
  shopHref={`/${countryCode}/store`}
  shopActive
>
  <CartButton slot="end" client:load regionId={regionId} />
</SiteHeader>
