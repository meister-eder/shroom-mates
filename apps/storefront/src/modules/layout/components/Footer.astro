---
// Thin wrapper: website links absolute, shop links relative
import type { FooterLink } from "@shroom-mates/ui/Footer.astro";
import SharedFooter from "@shroom-mates/ui/Footer.astro";
import { footerLinks, websiteUrl } from "@shroom-mates/ui/site";

interface Props {
  countryCode: string;
}

const { countryCode } = Astro.props;

const links: FooterLink[] = footerLinks(
  websiteUrl,
  (path) => path.replace(/^\/de\//, `/${countryCode}/`),
  { website: true, shop: false },
);
---

<SharedFooter links={links} />
