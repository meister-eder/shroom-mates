---
// Thin wrapper: storefront-specific Footer links
import SharedFooter from "@shroom-mates/ui/Footer.astro";
import type { FooterLink } from "@shroom-mates/ui/Footer.astro";
import { CONTACT_EMAIL, websiteUrl } from "@shroom-mates/ui/site";

interface Props {
  countryCode: string;
}

const { countryCode } = Astro.props;
---

<SharedFooter
  links={[
    { label: "Shop", href: `/${countryCode}/store` },
    { label: "Unsere Pilze", href: websiteUrl("/unsere-pilze/"), external: true },
    { label: "FAQ", href: websiteUrl("/faq/"), external: true },
    { label: "Kontakt", href: websiteUrl("/kontakt/"), external: true },
    { label: "Datenschutz", href: `/${countryCode}/datenschutz` },
    { label: "Widerruf", href: `/${countryCode}/widerruf` },
    { label: "AGB", href: `/${countryCode}/agb` },
    { label: "Impressum", href: websiteUrl("/impressum/"), external: true },
    { label: CONTACT_EMAIL, href: `mailto:${CONTACT_EMAIL}`, isEmail: true },
  ] satisfies FooterLink[]}
/>
