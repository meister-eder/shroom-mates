---
import "@shroom-mates/ui/fonts";
import "@shroom-mates/ui/base.css";
import "@shroom-mates/ui/utilities.css";
import frauncesUrl from "@fontsource-variable/fraunces/files/fraunces-latin-full-normal.woff2?url";
import { ClientRouter } from "astro:transitions";
import Footer from "@shroom-mates/ui/Footer.astro";
import LayoutScripts from "@shroom-mates/ui/LayoutScripts.astro";
import SiteHeader from "@shroom-mates/ui/SiteHeader.astro";
import type { NavKey } from "@shroom-mates/ui/site";

interface Props {
	title: string;
	description?: string;
	ogImage?: string;
	isLandingPage?: boolean;
	noindex?: boolean;
	/** @deprecated ohne Wirkung; der Hintergrund ist überall Creme */
	noBackground?: boolean;
	/** Aktiver Navigationspunkt (aria-current im Header) */
	active?: NavKey;
}

const {
	title,
	description = "Frische Edelpilze, Growkits & Pilztinkturen aus Leipzig-Leutzsch. Austernpilze, Lion's Mane, Pioppino. Nachhaltig gezüchtet für Privat und Gastronomie, direkt vom Züchter.",
	ogImage,
	isLandingPage = false,
	noindex = false,
	active,
} = Astro.props;

// Laufband über dem Header: nur belegbare Aussagen
const tickerItems = [
	"Neu: Wir sind in die Glasfabrik Leutzsch umgezogen",
	"Edel- und Vitalpilze aus Leipzig-Leutzsch",
	"Frische Pilze, Growkits & Tinkturen",
	"Alles selbst gezüchtet",
];

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
// Use a better default image - the logo with mushrooms
const defaultOgImage =
	ogImage ||
	new URL("/assets/logo_with_shrooms_and_text.png", Astro.site).toString();

// Structured data for local business SEO
const structuredData = {
	"@context": "https://schema.org",
	"@type": "LocalBusiness",
	"@id": "https://shroom-mates.de/#business",
	name: "shroom-mates",
	alternateName: "shroom-mates GbR",
	legalName: "shroom-mates GbR – Emmelie Kunz & Tim Eder",
	image: new URL(
		"/assets/logo_with_shrooms_and_text.png",
		Astro.site,
	).toString(),
	description:
		"Edelpilzzucht in Leipzig-Leutzsch. Frische Austernpilze, Lion's Mane, Pioppino, Growkits und Pilztinkturen. Für Privat und Gastronomie.",
	address: {
		"@type": "PostalAddress",
		streetAddress: "Franz-Flemming-Straße 25",
		addressLocality: "Leipzig",
		addressRegion: "Sachsen",
		postalCode: "04179",
		addressCountry: "DE",
	},
	geo: {
		"@type": "GeoCoordinates",
		latitude: 51.3540, // TODO: Koordinaten verifizieren
		longitude: 12.3010, // TODO: Koordinaten verifizieren
	},
	url: "https://shroom-mates.de",
	email: "hey@shroom-mates.de",
	priceRange: "$$",
	knowsLanguage: "de",
	knowsAbout: [
		"Edelpilze",
		"Pilzzucht",
		"Austernpilze",
		"Lion's Mane",
		"Growkits",
		"Pilztinkturen",
		"Vitalpilze",
		"Pilze für Gastronomie",
	],
	areaServed: [
		{
			"@type": "City",
			name: "Leipzig",
			"@id": "https://www.wikidata.org/wiki/Q2079",
		},
		{
			"@type": "State",
			name: "Sachsen",
		},
	],
	sameAs: ["https://www.instagram.com/shroom_mates_le/"],
	founder: [
		{ "@type": "Person", name: "Emmelie Kunz" },
		{ "@type": "Person", name: "Tim Eder" },
	],
	hasOfferCatalog: {
		"@type": "OfferCatalog",
		name: "Edelpilze, Growkits & Tinkturen aus Leipzig",
		itemListElement: [
			{
				"@type": "OfferCatalog",
				name: "Frische Edelpilze",
				itemListElement: [
					{
						"@type": "Offer",
						itemOffered: {
							"@type": "Product",
							name: "Rosenseitling",
							description:
								"Rosa Austernpilze, zart und nussig, saisonal im Sommer",
						},
					},
					{
						"@type": "Offer",
						itemOffered: {
							"@type": "Product",
							name: "Pioppino",
							description: "Südlicher Schüppling, knackig und aromatisch",
						},
					},
					{
						"@type": "Offer",
						itemOffered: {
							"@type": "Product",
							name: "Lion's Mane",
							description:
								"Igelstachelbart, Vitalpilz mit besonderem Geschmack",
						},
					},
					{
						"@type": "Offer",
						itemOffered: {
							"@type": "Product",
							name: "White Pearl",
							description: "Weißer Austernpilz, vielseitig und ertragreich",
						},
					},
				],
			},
			{
				"@type": "OfferCatalog",
				name: "Growkits: Pilze selber züchten",
				itemListElement: [
					{
						"@type": "Offer",
						itemOffered: {
							"@type": "Product",
							name: "Growkit",
							description: "Pilzzuchtset für Zuhause, in 2-3 Wochen ernten",
						},
					},
				],
			},
			{
				"@type": "OfferCatalog",
				name: "Pilztinkturen & Extrakte",
				itemListElement: [
					{
						"@type": "Offer",
						itemOffered: {
							"@type": "Product",
							name: "Lion's Mane Tinktur",
							description: "Handgemachter Doppelextrakt aus eigenem Anbau",
						},
					},
					{
						"@type": "Offer",
						itemOffered: {
							"@type": "Product",
							name: "Reishi + Cordyceps Tinktur",
							description: "Adaptogener Doppelextrakt, immunsystemstärkend",
						},
					},
				],
			},
		],
	},
};

// Breadcrumb structured data
const pathSegments = Astro.url.pathname.split("/").filter(Boolean);
const breadcrumbItems = [
	{
		"@type": "ListItem",
		position: 1,
		name: "Startseite",
		item: "https://shroom-mates.de/",
	},
];
const breadcrumbNames: Record<string, string> = {
	"unsere-pilze": "Unsere Pilze",
	growkits: "Growkits",
	tinkturen: "Tinkturen",
	kontakt: "Kontakt",
	"ueber-uns": "Über uns",
	impressum: "Impressum",
	faq: "Häufige Fragen",
	gastronomie: "Gastronomie",
};
pathSegments.forEach((segment, index) => {
	breadcrumbItems.push({
		"@type": "ListItem",
		position: index + 2,
		name: breadcrumbNames[segment] || segment,
		item: `https://shroom-mates.de/${pathSegments.slice(0, index + 1).join("/")}/`,
	});
});
const breadcrumbSchema = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	itemListElement: breadcrumbItems,
};
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <ClientRouter />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={frauncesUrl}
      crossorigin="anonymous"
    />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta
      name="google-site-verification"
      content="4MHVB3PHlJNORM3zCWb3yyka7m2Y-cEwrXlLAZitKFs"
    />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO and Open Graph -->
    <title>{title}</title>
    <link rel="canonical" href={canonicalURL} />

    <!-- Structured Data for Local Business SEO -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />

    <!-- Breadcrumb Structured Data -->
    {
      pathSegments.length > 0 && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(breadcrumbSchema)}
        />
      )
    }

    <!-- Location/Geo Targeting -->
    <meta name="geo.region" content="DE-SN" />
    <meta name="geo.placename" content="Leipzig-Leutzsch" />
    <meta name="geo.position" content="51.3540;12.3010" />
    <meta name="ICBM" content="51.3540, 12.3010" />

    <!-- Keywords for local search -->
    <meta
      name="keywords"
      content="Pilze Leipzig, Edelpilze Leipzig, frische Pilze kaufen Leipzig, Pilze Gastronomie Leipzig, Pilzlieferant Leipzig, Austernpilze Leipzig, Vitalpilze Leipzig, Growkits Leipzig, Growkits kaufen, Pilze selber züchten, Pilzzuchtset, Pilztinkturen Leipzig, Pilzextrakte Leipzig, Lion's Mane Leipzig, Lion's Mane Tinktur, Reishi Tinktur, Pilzzucht Leipzig, Leutzscher Markthalle, regionale Pilze Sachsen"
    />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="shroom-mates" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:image" content={defaultOgImage} />
    <meta property="og:image:width" content="512" />
    <meta property="og:image:height" content="512" />
    <meta
      property="og:image:alt"
      content="shroom-mates Logo - Edelpilze aus Leipzig"
    />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={defaultOgImage} />
    <meta
      name="twitter:image:alt"
      content="shroom-mates Logo - Edelpilze aus Leipzig"
    />

    <!-- Additional meta tags -->
    {
      noindex ? (
        <meta name="robots" content="noindex, nofollow" />
      ) : (
        <meta
          name="robots"
          content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
        />
      )
    }
    <meta name="author" content="shroom-mates - Emmelie Kunz & Tim Eder" />
    <meta name="theme-color" content="#fdfcea" />

    <!-- Language alternates (for future expansion) -->
    <link rel="alternate" hreflang="de" href={canonicalURL} />
    <link rel="alternate" hreflang="x-default" href={canonicalURL} />

    <!-- Sitemap -->
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body>
    <!-- Skip link for keyboard navigation -->
    <a href="#main-content" class="skip-link">Zum Hauptinhalt springen</a>

    <div class="site-wrapper">
      <SiteHeader app="website" active={active} ticker={tickerItems} />
      <main
        id="main-content"
        class={isLandingPage ? "site-main" : "site-main with-nav-spacing"}
        aria-label="Seiteninhalt"
      >
        <slot />
      </main>

      <Footer app="website" />


      <LayoutScripts />

      <script>
        // Fallback transitions for browsers without View Transitions API
        const hasViewTransitions = document.startViewTransition !== undefined;
        if (!hasViewTransitions) {
          document.addEventListener("astro:before-preparation", () => {
            const main = document.querySelector(".site-main");
            if (main) {
              main.classList.add("astro-transitioning");
            }
          });

          document.addEventListener("astro:after-swap", () => {
            const main = document.querySelector(".site-main");
            if (main) {
              // Small delay to ensure smooth transition
              setTimeout(() => {
                main.classList.remove("astro-transitioning");
              }, 50);
            }
          });
        }
      </script>

      <script>
        // Scroll-triggered reveal animations using IntersectionObserver
        function setupRevealAnimations() {
          const prefersReducedMotion = window.matchMedia(
            "(prefers-reduced-motion: reduce)",
          ).matches;
          if (prefersReducedMotion) return;

          const revealElements = document.querySelectorAll(
            ".reveal, .reveal-left, .reveal-right, .reveal-scale",
          );
          if (!revealElements.length) return;

          const observer = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (entry.isIntersecting) {
                  entry.target.classList.add("reveal--visible");
                  observer.unobserve(entry.target);
                }
              }
            },
            { threshold: 0.15, rootMargin: "0px 0px -40px 0px" },
          );

          for (const el of revealElements) {
            observer.observe(el);
          }
        }

        setupRevealAnimations();
        document.addEventListener("astro:after-swap", setupRevealAnimations);
      </script>

      <style is:global>
        @import url("../styles/global.css");

        /* Fallback transitions for browsers without View Transitions API */
        @media (prefers-reduced-motion: no-preference) {
          .site-main {
            transition: opacity 0.2s ease-in-out;
          }

          .site-main.astro-transitioning {
            opacity: 0.8;
          }
        }

        /* Landing page renders full-bleed without the header offset */
        .site-main:not(.with-nav-spacing) {
          max-width: none;
          padding: 0;
          margin: 0;
        }
      </style>
    </div>
  </body>
</html>
