---
import { getEntry } from "astro:content";
/**
 * FAQ-Akkordeon (einzige FAQ-Darstellung, nur auf /faq/ eingebunden).
 * Native <details name="faq">: kein Script, Tastatur/Screenreader gratis,
 * immer nur eine Frage offen; die aktive Frage ist lavendel hinterlegt.
 * Inhalt kommt vollständig aus der Content-Collection „faq-page“; alle
 * Antworten stehen auch geschlossen im HTML. Liefert FAQPage-JSON-LD mit.
 */
import Icon from "@shroom-mates/ui/Icon.astro";

const faqPageEntry = await getEntry("faq-page", "content");
if (!faqPageEntry) {
	throw new Error("FAQ page content not found");
}

const { faqs, moreLinkText } = faqPageEntry.data;

const faqSchema = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	mainEntity: faqs.map((faq) => ({
		"@type": "Question",
		name: faq.question,
		acceptedAnswer: {
			"@type": "Answer",
			text: faq.answer,
		},
	})),
};
---

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<div class="faq-list">
  {
    faqs.map((faq, i) => (
      <details class="faq-item" name="faq" open={i === 0}>
        <summary>
          <h2 class="faq-question">{faq.question}</h2>
          <span class="faq-toggle" aria-hidden="true">
            <Icon name="plus" size={20} strokeWidth={2.6} class="faq-toggle__plus" />
            <Icon name="minus" size={20} strokeWidth={2.6} class="faq-toggle__minus" />
          </span>
        </summary>
        <div class="faq-answer">
          <p set:html={faq.answer} />
          {faq.link && (
            <p class="faq-link">
              <a href={faq.link}>{moreLinkText}</a>
            </p>
          )}
        </div>
      </details>
    ))
  }
</div>

<style>
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .faq-item {
    background: var(--color-white);
    border: 3px solid var(--color-ink);
    border-radius: 0;
    overflow: hidden;
  }

  .faq-item[open] {
    background: var(--color-lavender);
    box-shadow: 6px 6px 0 var(--color-ink);
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 20px 24px;
    list-style: none;
    cursor: pointer;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:focus-visible {
    outline: 3px solid var(--color-ink);
    outline-offset: -6px;
    border-radius: 0;
  }

  .faq-question {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.1875rem, 2.4vw, 1.375rem);
    font-weight: 800;
    font-variation-settings: "SOFT" 100;
    line-height: 1.2;
    text-wrap: pretty;
  }

  .faq-toggle {
    display: grid;
    place-items: center;
    flex: none;
    width: 36px;
    height: 36px;
    border: 2px solid var(--color-ink);
    border-radius: 50%;
    background: var(--color-cream);
  }

  .faq-toggle :global(.faq-toggle__minus),
  .faq-item[open] .faq-toggle :global(.faq-toggle__plus) {
    display: none;
  }

  .faq-item[open] .faq-toggle :global(.faq-toggle__minus) {
    display: block;
  }

  .faq-answer {
    padding: 0 24px 24px;
  }

  .faq-answer p {
    max-width: 62ch;
    margin: 0;
    font-size: 1.0625rem;
    line-height: 1.55;
  }

  .faq-answer p + p {
    margin-top: 0.75rem;
  }

  .faq-answer :global(a) {
    color: var(--color-ink);
    font-weight: 700;
    text-underline-offset: 3px;
  }

  .faq-answer :global(a:hover) {
    text-decoration-thickness: 2px;
  }

  @media (max-width: 480px) {
    summary {
      padding: 16px 16px;
    }

    .faq-answer {
      padding: 0 16px 20px;
    }
  }
</style>
