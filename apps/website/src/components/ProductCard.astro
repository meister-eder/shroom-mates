---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

/**
 * Sticker-Karte für Produkte (Sorten, Growkits): Kartonfarbe als Fläche,
 * Bild mit weißem Rand, Name, Inhalt (Default-Slot) und optional Aktionen
 * (Slot "actions"). Rotation/Hover kommen aus .sticker-card (utilities.css).
 */
type Tone = "lavender" | "pink" | "olive-soft" | "stone" | "paper" | "mist" | "white";

interface Props {
	title: string;
	image: ImageMetadata;
	imageAlt: string;
	tone?: Tone;
	headingLevel?: 2 | 3;
	/** Lateinischer Name o. Ä., in DM Mono kursiv */
	subtitle?: string;
	/** Kleine Pille auf dem Bild, z. B. „Nur im Sommer“ */
	badge?: string;
	id?: string;
	/** Neigung der Karte in Grad (Entwurf: abwechselnd -1.5 / 1 / -1 / 1.5) */
	tilt?: number;
	sizes?: string;
}

const {
	title,
	image,
	imageAlt,
	tone = "paper",
	headingLevel = 2,
	subtitle,
	badge,
	id,
	tilt,
	sizes = "(max-width: 768px) 90vw, 420px",
} = Astro.props;

const HeadingTag = `h${headingLevel}` as "h2" | "h3";
---

<article
	class={`sticker-card sticker-card--${tone} product-card`}
	id={id}
	style={tilt !== undefined ? `--sticker-rot: ${tilt}deg` : undefined}
>
	<div class="product-card__media">
		<Image
			src={image}
			alt={imageAlt}
			class="product-card__img"
			widths={[320, 480, 640, 800]}
			{sizes}
			format="webp"
			loading="lazy"
		/>
		{badge && <span class="product-card__badge">{badge}</span>}
	</div>
	<div class:list={["product-card__body", { "product-card__body--panel": tone === "stone" }]}>
		<HeadingTag class="product-card__title">{title}</HeadingTag>
		{subtitle && <p class="product-card__subtitle">{subtitle}</p>}
		<div class="product-card__content">
			<slot />
		</div>
		{
			Astro.slots.has("actions") && (
				<div class="product-card__actions">
					<slot name="actions" />
				</div>
			)
		}
	</div>
</article>

<style>
	.product-card {
		gap: 0.5rem;
		min-width: 0;
		padding: 18px;
	}

	/* Zusätzliche Kartonfarben aus dem Entwurf */
	.product-card.sticker-card--mist {
		--sticker-bg: #b9bbe6;
	}

	.product-card.sticker-card--white {
		--sticker-bg: #fff;
	}

	.product-card__media {
		position: relative;
	}

	.product-card :global(.product-card__img) {
		height: 320px;
		box-sizing: border-box;
	}

	.product-card__badge {
		position: absolute;
		top: 14px;
		right: 14px;
		padding: 6px 12px;
		background: var(--color-cream);
		color: var(--color-ink);
		border: 2px solid var(--color-ink);
		border-radius: var(--radius-pill);
		font-family: var(--font-mono);
		font-size: 0.8125rem;
		line-height: 1.2;
	}

	.product-card__body {
		display: flex;
		flex: 1;
		flex-direction: column;
		padding: 6px 4px 4px;
	}

	/* Steingrau: Text auf Creme-Fläche für ausreichend Kontrast */
	.product-card__body--panel {
		margin-top: 4px;
		padding: 14px 16px 16px;
		background: var(--color-cream);
		border: 2px solid var(--color-ink);
		border-radius: 0;
	}

	.product-card__title {
		margin: 10px 0 0;
		font-family: var(--font-display);
		font-weight: 900;
		font-variation-settings: "SOFT" 100;
		font-size: 2.25rem;
		line-height: 1;
	}

	.product-card__subtitle {
		margin: 2px 0 0;
		font-family: var(--font-mono);
		font-size: 0.8125rem;
		font-style: italic;
	}

	.product-card__content {
		margin-top: 12px;
		font-size: 1.0625rem;
		line-height: 1.5;
	}

	.product-card__content :global(h2) {
		margin: 16px 0 8px;
		font-family: var(--font-body);
		font-size: 1.25rem;
		font-weight: 800;
		line-height: 1.2;
	}

	.product-card__content :global(h3) {
		margin: 14px 0 6px;
		font-size: 1.0625rem;
		font-weight: 800;
		line-height: 1.25;
	}

	.product-card__content :global(p) {
		margin: 0 0 0.75rem;
	}

	.product-card__content > :global(:first-child) {
		margin-top: 0;
	}

	.product-card__content > :global(:last-child) {
		margin-bottom: 0;
	}

	.product-card__content :global(ul),
	.product-card__content :global(ol) {
		margin: 0.5rem 0 0.75rem;
		padding-left: 1.25rem;
	}

	.product-card__content :global(li) {
		margin: 0.35rem 0;
	}

	.product-card__content :global(a) {
		color: var(--color-ink);
		text-underline-offset: 2px;
	}

	.product-card__content :global(details) {
		border-top: 2px solid var(--color-ink);
		padding-top: 10px;
	}

	.product-card__content :global(summary) {
		cursor: pointer;
		min-height: 44px;
		display: flex;
		align-items: center;
		font-weight: 800;
	}

	.product-card__actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 8px;
		margin-top: auto;
		padding-top: 16px;
	}

	.product-card__actions :global(.tag) {
		display: inline-flex;
		align-items: center;
		min-height: 36px;
		padding: 6px 14px;
		border: 2px solid var(--color-ink);
		border-radius: var(--radius-pill);
		color: var(--color-ink);
		font-family: var(--font-mono);
		font-size: 0.8125rem;
		line-height: 1.2;
		text-decoration: none;
	}

	.product-card__actions :global(a.tag) {
		min-height: 44px;
		background: var(--color-ink);
		color: var(--color-cream);
	}

	.product-card__actions :global(a.tag:hover) {
		background: var(--color-cream);
		color: var(--color-ink);
	}

	@media (max-width: 768px) {
		.product-card {
			padding: 12px;
		}

		.product-card :global(.product-card__img) {
			height: 240px;
		}

		.product-card__title {
			font-size: 2rem;
		}
	}
</style>
