---
/**
 * LocationInfo Component
 * Displays the farm location with embedded Google Maps.
 */

// Google Maps embed URL for shroom-mates location (Markranstädter Str. 8, 04229 Leipzig)
const mapsEmbedUrl =
	"https://www.google.com/maps?q=shroom-mates+Leipzig,+Markranstädter+Straße+8,+04229+Leipzig&output=embed";
const mapsLinkUrl = "https://maps.app.goo.gl/MYEGJezHxqpG7d1e6";
---

<section class="location-info" aria-label="Unser Standort">
  <h2>Unser Standort</h2>

  <div class="location-content">
    <div class="market-info">
      <div class="market-card">
        <h3>Plagwitzer Markthalle</h3>
        <address>
          Markranstädter Straße 8<br />
          04229 Leipzig
        </address>
        <p class="market-note">
          Schreib uns für Bestellungen und Abholtermine.
        </p>
      </div>

      <a
        href={mapsLinkUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="maps-link"
        aria-label="Standort in Google Maps öffnen"
      >
        📍 In Google Maps öffnen
      </a>
    </div>

    <div class="map-container">
      <!-- Click-to-load: nothing is requested from Google before consent -->
      <div class="map-consent" data-map-src={mapsEmbedUrl}>
        <p class="map-consent-title">Karte von Google Maps anzeigen?</p>
        <p class="map-consent-text">
          Wenn du die Karte lädst, werden Daten (u. a. deine IP-Adresse) an
          Google Ireland Limited übermittelt und ggf. in die USA weitergegeben;
          Google kann dabei Cookies setzen. Mit Klick auf „Karte laden“
          willigst du hierin ein (Art. 6 Abs. 1 lit. a DSGVO, § 25 Abs. 1
          TDDDG). Mehr in unserer
          <a href="/datenschutz/#4-google-maps-nur-nach-klick">Datenschutzerklärung</a>.
        </p>
        <button type="button" class="map-consent-button" data-load-map>
          Karte laden
        </button>
      </div>
    </div>
  </div>
</section>

<script>
  // Delegated so it keeps working across view-transition navigations.
  document.addEventListener("click", (event) => {
    const button = (event.target as HTMLElement | null)?.closest("[data-load-map]");
    if (!button) return;
    const placeholder = button.closest<HTMLElement>(".map-consent");
    const src = placeholder?.dataset.mapSrc;
    if (!placeholder || !src) return;
    const iframe = document.createElement("iframe");
    iframe.src = src;
    iframe.width = "100%";
    iframe.height = "450";
    iframe.style.border = "0";
    iframe.style.display = "block";
    iframe.allowFullscreen = true;
    iframe.referrerPolicy = "no-referrer-when-downgrade";
    iframe.title = "Karte zur shroom-mates Pilzzucht in Leipzig, Markranstädter Straße 8";
    placeholder.replaceWith(iframe);
  });
</script>

<style>
  .map-consent {
    min-height: 450px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    padding: 2rem;
    text-align: center;
    background: var(--bg-color);
  }

  .map-consent-title {
    font-family: "DM Mono", monospace;
    font-weight: 700;
    font-size: 1.1rem;
    margin: 0;
  }

  .map-consent-text {
    font-size: 0.9rem;
    max-width: 30rem;
    margin: 0;
    line-height: 1.6;
  }

  .map-consent-text a {
    text-decoration: underline;
  }

  .map-consent-button {
    padding: 0.7rem 1.5rem;
    border: 2px solid #000;
    border-radius: 6px;
    background: #000;
    color: #fff;
    font-family: "DM Mono", monospace;
    cursor: pointer;
    box-shadow: 4px 4px 0 rgba(0, 0, 0, 0.2);
  }

  .map-consent-button:hover {
    background: var(--accent);
  }

  .location-info {
    margin-top: 0;
    padding: 3rem 2rem;
    width: calc(100vw - var(--scrollbar-width, 0px));
    margin-left: calc(50% - (100vw - var(--scrollbar-width, 0px)) / 2);
    background: var(--bg-accent);
    border-top: 2px solid #000;
    border-bottom: 2px solid #000;
  }

  .location-info h2 {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    text-align: center;
    margin: 0 0 0.5rem 0;
    color: var(--text-color);
    font-family: "DM Mono", monospace;
  }

  .location-info h2::after {
    content: "";
    display: block;
    width: 50px;
    height: 3px;
    background: var(--accent);
    margin: 0.6rem auto 2rem;
    border-radius: 2px;
  }

  .location-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    max-width: 1000px;
    margin: 0 auto;
  }

  .market-info {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .market-card {
    background: #fff;
    padding: 1.5rem;
    border-radius: 8px;
    border: 2px solid #000;
    box-shadow: 4px 4px 0 rgba(0, 0, 0, 0.1);
  }

  .market-card h3 {
    font-size: 1.3rem;
    font-family: "DM Mono", monospace;
    margin-bottom: 1rem;
  }

  .market-card address {
    font-style: normal;
    line-height: 1.6;
    margin-bottom: 1rem;
  }

  .market-note {
    margin-top: 0.5rem;
    color: #666;
    font-size: 0.9rem;
  }

  .maps-link {
    display: inline-block;
    padding: 0.8rem 1.5rem;
    background: #000;
    color: #fff;
    text-decoration: none;
    border-radius: 6px;
    font-weight: 500;
    text-align: center;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
    box-shadow: 3px 3px 0 rgba(0, 0, 0, 0.2);
  }

  .maps-link:hover {
    transform: translate(1px, 1px);
    box-shadow: 2px 2px 0 rgba(0, 0, 0, 0.2);
  }

  .maps-link:focus-visible {
    outline: 2px solid var(--focus-color, #000);
    outline-offset: 2px;
  }

  .map-container {
    border-radius: 8px;
    overflow: hidden;
    border: 2px solid #000;
    box-shadow: 4px 4px 0 rgba(0, 0, 0, 0.1);
    min-height: 450px;
    height: 450px;
    width: 100%;
    position: relative;
  }

  .map-container iframe {
    display: block;
    width: 100%;
    height: 100%;
  }

  @media (max-width: 768px) {
    .location-content {
      grid-template-columns: 1fr;
    }

    .location-info {
      padding: 1.5rem;
    }

    .location-info h2 {
      font-size: 1.5rem;
    }

    .map-container {
      min-height: 300px;
    }
  }

  @media (max-width: 480px) {
    .location-info {
      padding: 1rem;
    }

    .market-card {
      padding: 1rem;
    }
  }
</style>
