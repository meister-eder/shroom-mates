---
/**
 * LocationInfo Component
 * Displays the farm location with embedded Google Maps.
 */
import Icon from "@shroom-mates/ui/Icon.astro";

// Google Maps embed URL for shroom-mates location (Franz-Flemming-Str. 25, 04179 Leipzig; TODO: Koordinaten/Maps-Link verifizieren)
const mapsEmbedUrl =
	"https://www.google.com/maps?q=shroom-mates+Leipzig,+Franz-Flemming-Straße+25,+04179+Leipzig&output=embed";
const mapsLinkUrl = "https://www.google.com/maps/search/?api=1&query=Franz-Flemming-Stra%C3%9Fe+25,+04179+Leipzig";
---

<section class="location-info" aria-label="Unser Standort">
  <div class="container location-content">
    <h2 class="location-title">Unser Standort</h2>
    <div class="market-info">
      <div class="market-card">
        <h3>Glasfabrik</h3>
        <address>
          Franz-Flemming-Straße 25<br />
          04179 Leipzig
        </address>
        <p class="market-note">
          Schreib uns für Bestellungen und Abholtermine.
        </p>
      </div>

      <a
        href={mapsLinkUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn--primary maps-link"
        aria-label="Standort in Google Maps öffnen (öffnet in neuem Tab)"
      >
        <Icon name="map-pin" size={20} /> In Google Maps öffnen
      </a>
    </div>

    <div class="map-container">
      <!-- Click-to-load: nothing is requested from Google before consent -->
      <div class="map-consent" data-map-src={mapsEmbedUrl}>
        <p class="map-consent-title">Karte von Google Maps anzeigen?</p>
        <p class="map-consent-text">
          Wenn du die Karte lädst, werden Daten (u. a. deine IP-Adresse) an
          Google Ireland Limited übermittelt und ggf. in die USA weitergegeben;
          Google kann dabei Cookies setzen. Mit Klick auf „Karte laden“
          willigst du hierin ein (Art. 6 Abs. 1 lit. a DSGVO, § 25 Abs. 1
          TDDDG). Mehr in unserer
          <a href="/datenschutz/#4-google-maps-nur-nach-klick">Datenschutzerklärung</a>.
        </p>
        <button type="button" class="btn btn--primary map-consent-button" data-load-map>
          Karte laden
        </button>
      </div>
    </div>
  </div>
</section>

<script>
  // Delegated so it keeps working across view-transition navigations.
  document.addEventListener("click", (event) => {
    const button = (event.target as HTMLElement | null)?.closest("[data-load-map]");
    if (!button) return;
    const placeholder = button.closest<HTMLElement>(".map-consent");
    const src = placeholder?.dataset.mapSrc;
    if (!placeholder || !src) return;
    const iframe = document.createElement("iframe");
    iframe.src = src;
    iframe.width = "100%";
    iframe.height = "450";
    iframe.style.border = "0";
    iframe.style.display = "block";
    iframe.allowFullscreen = true;
    iframe.referrerPolicy = "no-referrer-when-downgrade";
    iframe.title = "Karte zur shroom-mates Pilzzucht in Leipzig, Franz-Flemming-Straße 25";
    placeholder.replaceWith(iframe);
  });
</script>

<style>
  .location-info {
    padding: 80px 0 96px;
    background: var(--color-paper);
    border-top: 3px solid var(--color-ink);
  }

  .location-content {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    grid-template-areas:
      "title title"
      "info map";
    gap: 32px 48px;
    align-items: start;
  }

  .location-title {
    grid-area: title;
  }

  .market-info {
    grid-area: info;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
  }

  .market-card {
    width: 100%;
    padding: 24px;
    background: var(--color-white);
    border: 3px solid var(--color-ink);
    border-radius: 0;
    box-shadow: var(--shadow-btn);
  }

  .market-card h3 {
    margin: 0 0 12px;
    font-family: var(--font-display);
    font-weight: 900;
    font-variation-settings: "SOFT" 100;
  }

  .market-card address {
    margin-bottom: 12px;
    font-size: 1.125rem;
    font-style: normal;
    line-height: 1.5;
  }

  .market-note {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.9375rem;
  }

  .maps-link {
    text-decoration: none;
  }

  .map-container {
    grid-area: map;
    position: relative;
    width: 100%;
    min-height: 450px;
    overflow: hidden;
    background: var(--color-cream);
    border: 3px solid var(--color-ink);
    border-radius: 0;
    box-shadow: var(--shadow-card);
  }

  .map-container :global(iframe) {
    display: block;
    width: 100%;
    height: 450px;
  }

  .map-consent {
    min-height: 450px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    padding: 2rem;
    text-align: center;
  }

  .map-consent-title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 1.5rem;
  }

  .map-consent-text {
    max-width: 30rem;
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .map-consent-text a {
    color: var(--color-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 900px) {
    .location-content {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        "title"
        "info"
        "map";
    }
  }

  @media (max-width: 768px) {
    .location-info {
      padding: 56px 0 64px;
    }

    .map-container,
    .map-consent {
      min-height: 320px;
    }

    .map-container :global(iframe) {
      height: 380px;
    }

    .map-container {
      border-radius: 0;
      box-shadow: 4px 4px 0 var(--color-ink);
    }
  }
</style>
