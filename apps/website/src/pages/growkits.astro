---
import { Image } from "astro:assets";
import { getCollection, getEntry, render } from "astro:content";
import Icon from "@shroom-mates/ui/Icon.astro";
import { linkBuilders } from "@shroom-mates/ui/site";
import rosenseitlingBueschel from "../assets/images/fotos/rosenseitling-bueschel.jpg";
import ProductCard from "../components/ProductCard.astro";
import Layout from "../layouts/Layout.astro";

const { shop } = linkBuilders("website");

// Generische Anleitung (CMS)
const growkitsPageEntry = await getEntry("growkits-page", "content");
if (!growkitsPageEntry) {
	throw new Error("Growkits page content not found");
}
const { Content: PageContent } = await render(growkitsPageEntry);

const {
	title,
	description,
	heroTitle,
	heroHeadline,
	heroSubtitle,
	heroPrimaryButton,
	heroSecondaryButton,
	heroImage,
	heroImageAlt,
	kitsTitle,
	kitDetailsLabel,
	kitShopButton,
	guideHarvestImageAlt,
	ctaTitle,
	ctaText,
	ctaShopButton,
	ctaButtonText,
	ctaButtonLink,
	shippingLabel,
	shippingText,
} = growkitsPageEntry.data;

// Anleitung für die Comic-Panels aus dem Markdown lesen:
// "## Überschrift", Einleitung, dann "### 1\. Titel" + Text je Schritt.
// Klappt das nicht (Struktur im CMS geändert), rendern wir den Text unverändert.
const escapeHtml = (s: string) =>
	s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
const inlineMd = (s: string) =>
	escapeHtml(s)
		.replace(/\*\*([^*]+)\*\*/g, "<strong>$1</strong>")
		.replace(/(?<!\*)\*([^*]+)\*(?!\*)/g, "<em>$1</em>");
const paragraphs = (s: string) =>
	s
		.split(/\n\s*\n/)
		.map((p) => p.trim())
		.filter(Boolean)
		.map(inlineMd);

const [introPart, ...stepParts] = (growkitsPageEntry.body ?? "").split(
	/^###\s+/m,
);
const guideHeading =
	introPart.match(/^##\s+(.+)$/m)?.[1]?.trim() ?? "So funktioniert's";
const guideIntro = paragraphs(introPart.replace(/^##\s+.+$/m, ""));
const steps = stepParts.map((part) => {
	const [first, ...rest] = part.split("\n");
	return {
		title: first.replace(/^\d+\\?\.\s*/, "").trim(),
		text: paragraphs(rest.join("\n")),
	};
});

// Foto je Schritt (sonst Platzhalter in Kartonfarbe mit Rasterpunkten)
const stepImage = (stepTitle: string) =>
	/^Ernten/i.test(stepTitle)
		? {
				image: rosenseitlingBueschel,
				alt: guideHarvestImageAlt,
			}
		: undefined;
const placeholders = [
	"var(--color-pink)",
	"var(--color-lavender)",
	"var(--color-olive-soft)",
];

// Kartonfarbe und Shop-Produkt je Growkit (Schlüssel = Dateiname)
const kitMeta: Record<
	string,
	{
		tone: "lavender" | "pink" | "olive-soft";
		handle: string;
	}
> = {
	"lions-mane": { tone: "lavender", handle: "lions-mane-growkit" },
	rosenseitling: { tone: "pink", handle: "austernseitlinge-growkit" },
	"white-pearl": { tone: "olive-soft", handle: "austernseitlinge-growkit" },
};

const growkitsCollection = await getCollection("growkits");
const growkits = await Promise.all(
	growkitsCollection
		.sort((a, b) => a.data.order - b.data.order)
		.map(async (entry) => {
			const { Content } = await render(entry);
			const m = kitMeta[entry.id];
			return {
				title: entry.data.title,
				image: entry.data.image,
				imageAlt: entry.data.imageAlt,
				Content,
				tone: m?.tone ?? "paper",
				shopHref: m ? shop(`/store/${m.handle}`) : shop("/store"),
				slug: entry.id,
			};
		}),
);

// Generate HowTo Schema for SEO
const howToSchema = {
	"@context": "https://schema.org",
	"@type": "HowTo",
	name: "Pilze zuhause züchten mit Growkits",
	description:
		"Schritt-für-Schritt Anleitung zum Züchten von Pilzen mit unseren Growkits. Lion's Mane, Rosenseitlinge und White Pearl in wenigen Wochen ernten.",
	image: heroImage?.src || "",
	totalTime: "P21D",
	estimatedCost: {
		"@type": "MonetaryAmount",
		currency: "EUR",
		value: "25",
	},
	supply: [
		{
			"@type": "HowToSupply",
			name: "Growkit",
		},
		{
			"@type": "HowToSupply",
			name: "Sprühflasche mit Wasser",
		},
	],
	tool: [
		{
			"@type": "HowToTool",
			name: "Heller Standort ohne direkte Sonneneinstrahlung",
		},
	],
	step: [
		{
			"@type": "HowToStep",
			name: "Auspacken & Vorbereiten",
			text: "Nimm das Growkit aus der Verpackung und stelle es an einen hellen Ort ohne direkte Sonneneinstrahlung.",
			position: 1,
		},
		{
			"@type": "HowToStep",
			name: "Befeuchten",
			text: "Besprühe das Kit 2-3 mal täglich mit Wasser. Die Oberfläche sollte immer leicht feucht sein.",
			position: 2,
		},
		{
			"@type": "HowToStep",
			name: "Warten & Beobachten",
			text: "Nach etwa 7-14 Tagen zeigen sich die ersten Pilzköpfe. Ab dann geht es schnell!",
			position: 3,
		},
		{
			"@type": "HowToStep",
			name: "Ernten",
			text: "Ernte die Pilze, wenn die Hutkanten beginnen sich nach oben zu wölben. Drehe sie vorsichtig ab.",
			position: 4,
		},
	],
};

// Generate Product schema for each growkit variety
const productSchemas = growkits.map((growkit) => ({
	"@context": "https://schema.org",
	"@type": "Product",
	name: `${growkit.title} Growkit`,
	description: `Pilzzuchtset für ${growkit.title} - Frische Pilze zuhause züchten`,
	image: growkit.image?.src || "",
	brand: {
		"@type": "Brand",
		name: "shroom-mates",
	},
	manufacturer: {
		"@type": "Organization",
		name: "shroom-mates",
		url: "https://shroom-mates.de",
	},
	category: "Pilzzucht",
}));
---

<Layout title={title} description={description} ogImage={heroImage?.src} isLandingPage={true} active="growkits">
  <script is:inline type="application/ld+json" set:html={JSON.stringify(howToSchema)} />
  {
    productSchemas.map((schema) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))
  }

  <div class="page">
    <section class="hero container">
      <div class="hero__copy">
        <h1>
          <span class="eyebrow hero__eyebrow">{heroTitle}</span>
          <span class="hero__title">{heroHeadline}</span>
        </h1>
        <p class="lead hero__lead">
          {heroSubtitle}
        </p>
        <div class="hero__actions">
          <a class="btn btn--primary" href="#kits">{heroPrimaryButton}</a>
          <a class="btn btn--secondary" href="#anleitung">{heroSecondaryButton}</a>
        </div>
      </div>
      <div class="hero__media">
        <div class="dots" aria-hidden="true"></div>
        <Image
          src={heroImage}
          alt={heroImageAlt}
          class="hero__img"
          widths={[320, 480, 640, 840]}
          sizes="(max-width: 900px) 90vw, 520px"
          loading="eager"
          format="webp"
        />
      </div>
    </section>

    {
      growkits.length > 0 && (
        <section id="kits" class="section section--paper kits" aria-labelledby="kits-heading">
          <div class="kits__inner">
            <h2 id="kits-heading">{kitsTitle}</h2>
            <div class="kits__grid">
              {growkits.map((growkit) => (
                <ProductCard
                  title={growkit.title}
                  image={growkit.image}
                  imageAlt={growkit.imageAlt}
                  tone={growkit.tone}
                  headingLevel={3}
                  id={growkit.slug}
                >
                  <details class="kit-details">
                    <summary>{kitDetailsLabel}</summary>
                    <growkit.Content />
                  </details>
                  <a slot="actions" class="btn btn--primary" href={growkit.shopHref}>
                    {kitShopButton} <Icon name="arrow-right" size={20} />
                  </a>
                </ProductCard>
              ))}
            </div>
          </div>
        </section>
      )
    }

    <section id="anleitung" class="section section--night guide" aria-labelledby="guide-heading">
      <div class="guide__inner">
        <h2 id="guide-heading">{guideHeading}</h2>
        {
          steps.length > 0 ? (
            <>
              {guideIntro.map((p) => <p class="guide__intro" set:html={p} />)}
              <ol class="guide__grid" role="list">
                {steps.map((step, i) => {
                  const photo = stepImage(step.title);
                  return (
                    <li class="comic-panel">
                      <div class="comic-panel__head">
                        <span class="comic-panel__num">{String(i + 1).padStart(2, "0")}</span>
                      </div>
                      {photo ? (
                        <Image
                          src={photo.image}
                          alt={photo.alt}
                          class="comic-panel__img guide__img"
                          widths={[320, 480, 640]}
                          sizes="(max-width: 768px) 90vw, 300px"
                          format="webp"
                          loading="lazy"
                        />
                      ) : (
                        <div
                          class="comic-panel__img guide__img guide__placeholder"
                          style={`--ph: ${placeholders[i % placeholders.length]}`}
                          aria-hidden="true"
                        />
                      )}
                      <div class="comic-panel__body">
                        <h3 class="guide__title">{step.title}</h3>
                        {step.text.map((p) => <p set:html={p} />)}
                      </div>
                    </li>
                  );
                })}
              </ol>
            </>
          ) : (
            <div class="guide__fallback"><PageContent /></div>
          )
        }
      </div>
    </section>

    <section class="container pickup" aria-label="Abholen und Versand">
      <div class="pickup__card">
        <h2 class="pickup__title">{ctaTitle}</h2>
        <p>{ctaText}</p>
        <div class="pickup__actions">
          <a class="btn btn--primary" href={shop("/store")}>{ctaShopButton} <Icon name="arrow-right" size={20} /></a>
          {ctaButtonText && ctaButtonLink && (
            <a class="btn btn--secondary" href={ctaButtonLink}>{ctaButtonText}</a>
          )}
        </div>
      </div>
      <div class="pickup__note">
        <p class="label">{shippingLabel}</p>
        <p>{shippingText}</p>
      </div>
    </section>
  </div>
</Layout>

<style>
  .page {
    padding-top: var(--navbar-height);
    overflow-x: clip;
  }

  /* ── Hero ───────────────────────────────────────── */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    align-items: center;
    gap: 48px;
    padding-top: 32px;
    padding-bottom: 88px;
  }

  .hero__eyebrow {
    display: block;
    max-width: 44ch;
    margin-bottom: 18px;
    font-size: 0.875rem;
    line-height: 1.4;
    color: var(--color-accent-dark);
  }

  .hero__title {
    display: block;
    font-size: clamp(2.75rem, 7.4vw, 7rem);
    line-height: 0.9;
    color: var(--color-accent);
  }

  .hero__lead {
    max-width: 38ch;
    margin: 24px 0 0;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 32px;
  }

  .hero__media {
    position: relative;
    padding: 24px;
  }

  .hero__media .dots {
    position: absolute;
    inset: 0 40px 40px 0;
    border-radius: 40px;
  }

  .hero__media :global(.hero__img) {
    position: relative;
    display: block;
    width: 100%;
    height: 480px;
    object-fit: cover;
    border: 3px solid var(--color-ink);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-teaser);
    rotate: 2deg;
  }

  /* ── Kits ───────────────────────────────────────── */
  .kits__inner,
  .guide__inner {
    max-width: var(--container, 1280px);
    margin-inline: auto;
  }

  .kits h2 {
    margin-bottom: 48px;
  }

  .kits__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: 40px 32px;
    align-items: start;
  }

  .kit-details {
    padding-top: 0;
  }

  /* ── Anleitung ──────────────────────────────────── */
  .guide__inner > h2 {
    margin-bottom: 12px;
    color: var(--color-accent-light);
  }

  .guide__intro {
    max-width: 56ch;
    margin: 0 0 16px;
    font-size: 1.1875rem;
    color: #e9e6cf;
  }

  .guide__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: 18px;
    margin: 32px 0 0;
    padding: 0;
    list-style: none;
  }

  .guide__grid > .comic-panel {
    border-radius: 6px;
    background: var(--color-cream);
  }

  .guide__grid :global(.guide__img) {
    height: 150px;
  }

  .guide__placeholder {
    background:
      radial-gradient(rgba(29, 29, 29, 0.13) 1.4px, transparent 1.5px) 0 0 / 12px 12px,
      var(--ph);
  }

  .guide__title {
    margin: 0 0 8px;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.5rem;
  }

  .comic-panel__body :global(p) {
    margin: 0 0 0.6rem;
    font-size: 1rem;
    line-height: 1.5;
  }

  .comic-panel__body :global(p:last-child) {
    margin-bottom: 0;
  }

  .guide__fallback {
    max-width: 70ch;
    margin-top: 24px;
    color: #e9e6cf;
  }

  .guide__fallback :global(a) {
    color: var(--color-accent-light);
  }

  /* ── Abholen / Versand ──────────────────────────── */
  .pickup {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    gap: 32px;
    padding-top: 96px;
    padding-bottom: 96px;
  }

  .pickup__card {
    flex: 1 1 420px;
    min-width: 0;
    padding: 36px;
    background: var(--color-lavender);
    border: 3px solid var(--color-ink);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
  }

  .pickup__title {
    margin-bottom: 12px;
    font-size: clamp(2rem, 3vw, 2.5rem);
    line-height: 1;
  }

  .pickup__card p {
    margin: 0 0 24px;
    font-size: 1.125rem;
    line-height: 1.5;
  }

  .pickup__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  .pickup__note {
    flex: 1 1 320px;
    min-width: 0;
    padding: 36px;
    background: #fff;
    border: 3px dashed var(--color-ink);
    border-radius: var(--radius-card);
  }

  .pickup__note .label {
    margin: 0 0 10px;
    color: var(--color-accent-dark);
  }

  .pickup__note p:last-child {
    margin: 0;
    font-size: 1.125rem;
    line-height: 1.5;
  }

  /* ── Responsive ─────────────────────────────────── */
  @media (max-width: 900px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      padding-bottom: 56px;
    }

    .hero__media :global(.hero__img) {
      height: 340px;
    }
  }

  @media (max-width: 768px) {
    .pickup {
      padding-top: 56px;
      padding-bottom: 56px;
    }

    .pickup__card,
    .pickup__note {
      padding: 24px 20px;
    }

    .pickup__card {
      box-shadow: 6px 6px 0 var(--color-ink);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__media :global(.hero__img) {
      rotate: none;
    }
  }
</style>
