---
import { Image } from "astro:assets";
import { getCollection, getEntry } from "astro:content";
import Icon from "@shroom-mates/ui/Icon.astro";
import { linkBuilders } from "@shroom-mates/ui/site";
import rosenseitlingBueschel from "../assets/images/fotos/rosenseitling-bueschel.jpg";
import Layout from "../layouts/Layout.astro";

const { shop } = linkBuilders("website");

// Generische Anleitung (CMS)
const growkitsPageEntry = await getEntry("growkits-page", "content");
if (!growkitsPageEntry) {
	throw new Error("Growkits page content not found");
}

const {
	title,
	description,
	heroTitle,
	heroHeadline,
	heroSubtitle,
	heroPrimaryButton,
	heroSecondaryButton,
	heroImage,
	heroImageAlt,
	kitsTitle,
	kitDetailsLabel,
	kitShopButton,
	guideHarvestImageAlt,
	guide,
	ctaTitle,
	ctaText,
	ctaShopButton,
	ctaButtonText,
	ctaButtonLink,
	shippingLabel,
	shippingText,
} = growkitsPageEntry.data;

const { title: guideHeading, intro: guideIntro, steps } = guide;

// Foto je Schritt (sonst Platzhalter in Kartonfarbe mit Rasterpunkten)
const stepImage = (photo: boolean) =>
	photo
		? { image: rosenseitlingBueschel, alt: guideHarvestImageAlt }
		: undefined;
// Farben der Platzhalter je Schritt (wie im Entwurf: Rosa, Lavendel, Butter …)
const placeholders = [
	"var(--color-pink)",
	"var(--color-lavender)",
	"var(--color-olive-soft)",
	"var(--color-pink)",
	"var(--color-pink)",
	"var(--color-lavender)",
	"var(--color-olive-soft)",
];

const growkitsCollection = await getCollection("growkits");
const growkits = growkitsCollection
	.map((entry) => ({
		title: entry.data.title,
		name: entry.data.title.replace(/\s*Growkit$/i, ""),
		image: entry.data.image,
		imageAlt: entry.data.imageAlt,
		tone: entry.data.tone,
		order: entry.data.order,
		level: entry.data.level,
		temp: entry.data.temperature,
		pins: entry.data.firstPins,
		intro: entry.data.intro,
		tips: entry.data.tips,
		use: entry.data.usage,
		shopHref: shop(`/store/${entry.data.shopHandle}`),
		slug: entry.id,
	}))
	.sort((a, b) => a.order - b.order);
---

<Layout title={title} description={description} ogImage={heroImage?.src} isLandingPage={true} active="growkits">

  <div class="page">
    <section class="hero">
      <div class="hero__copy">
        <h1>
          <span class="eyebrow hero__eyebrow">{heroTitle}</span>
          <span class="hero__title">{heroHeadline}</span>
        </h1>
        <p class="lead hero__lead">
          {heroSubtitle}
        </p>
        <div class="hero__actions">
          <a class="btn btn--primary hero__btn" href="#kits">{heroPrimaryButton}</a>
          <a class="btn hero__btn hero__btn--outline" href="#anleitung">{heroSecondaryButton}</a>
        </div>
      </div>
      <div class="hero__media">
        <div class="dots" aria-hidden="true"></div>
        <Image
          src={heroImage}
          alt={heroImageAlt}
          class="hero__img"
          widths={[320, 480, 640, 840]}
          sizes="(max-width: 900px) 90vw, 520px"
          loading="eager"
          format="webp"
        />
      </div>
    </section>

    {
      growkits.length > 0 && (
        <section id="kits" class="kits" aria-labelledby="kits-heading" data-kits>
          <div class="kits__inner">
            <h2 id="kits-heading">{kitsTitle}</h2>
            <div class="kits__grid" role="group" aria-label={kitsTitle}>
              {growkits.map((growkit, i) => (
                <button
                  type="button"
                  class={`kit-card kit-card--${growkit.tone}`}
                  style={`--rot: ${[-1.5, 1, -1][i % 3]}deg`}
                  aria-pressed={i === 0 ? "true" : "false"}
                  aria-controls={`kit-panel-${growkit.slug}`}
                  data-kit-btn={growkit.slug}
                >
                  <Image
                    src={growkit.image}
                    alt={growkit.imageAlt}
                    class="kit-card__img"
                    widths={[320, 480, 640]}
                    sizes="(max-width: 640px) 90vw, 340px"
                    format="webp"
                    loading="lazy"
                  />
                  <span class="kit-card__name">{growkit.name}</span>
                  {growkit.level && <span class="kit-card__level">{growkit.level}</span>}
                </button>
              ))}
            </div>

            <div class="kit-panels" aria-live="polite">
              {growkits.map((growkit, i) => (
                <div
                  class="kit-panel"
                  id={`kit-panel-${growkit.slug}`}
                  data-kit-panel={growkit.slug}
                  hidden={i !== 0}
                >
                  <div class="kit-panel__copy">
                    <p class="label kit-panel__label">{kitDetailsLabel}</p>
                    <h3 class="kit-panel__title">{growkit.name}</h3>
                    <p class="kit-panel__intro" set:html={growkit.intro} />
                    <a class="btn btn--primary kit-panel__btn" href={growkit.shopHref}>
                      {kitShopButton} <Icon name="arrow-right" size={20} />
                    </a>
                  </div>
                  <dl class="kit-panel__facts">
                    {growkit.temp && (
                      <div class="kit-fact">
                        <dt>Temperatur</dt>
                        <dd>{growkit.temp}</dd>
                      </div>
                    )}
                    {growkit.pins && (
                      <div class="kit-fact">
                        <dt>Erste Pins</dt>
                        <dd>{growkit.pins}</dd>
                      </div>
                    )}
                    {growkit.tips.length > 0 && (
                      <div class="kit-fact kit-fact--wide">
                        <dt>Tipps</dt>
                        <dd>
                          <ul>
                            {growkit.tips.map((t) => <li set:html={t} />)}
                          </ul>
                        </dd>
                      </div>
                    )}
                    {growkit.use && (
                      <div class="kit-fact kit-fact--wide">
                        <dt>In der Küche</dt>
                        <dd class="kit-fact__text">
                          <p set:html={growkit.use} />
                        </dd>
                      </div>
                    )}
                  </dl>
                </div>
              ))}
            </div>
            <noscript>
              <style>
                .kit-panel[hidden] {
                  display: flex;
                }
              </style>
            </noscript>
          </div>
        </section>
      )
    }

    <section id="anleitung" class="guide" aria-labelledby="guide-heading">
      <div class="guide__inner">
        <h2 id="guide-heading">{guideHeading}</h2>
        {guideIntro.map((p) => <p class="guide__intro" set:html={p} />)}
        <ol class="guide__grid" role="list">
          {steps.map((step, i) => {
            const photo = stepImage(step.photo);
            return (
              <li class="step">
                {photo ? (
                  <Image
                    src={photo.image}
                    alt={photo.alt}
                    class="step__media"
                    widths={[320, 480, 640]}
                    sizes="(max-width: 768px) 90vw, 300px"
                    format="webp"
                    loading="lazy"
                  />
                ) : (
                  <div
                    class="step__media step__placeholder"
                    style={`--ph: ${placeholders[i % placeholders.length]}`}
                    aria-hidden="true"
                  />
                )}
                <div class="step__body">
                  <p class="step__num">{String(i + 1).padStart(2, "0")}</p>
                  <h3 class="step__title">{step.title}</h3>
                  {step.text.map((p) => <p set:html={p} />)}
                </div>
              </li>
            );
          })}
        </ol>
      </div>
    </section>

    <section class="pickup" aria-label="Abholen und Versand">
      <div class="pickup__card">
        <h2 class="pickup__title">{ctaTitle}</h2>
        <p>{ctaText}</p>
        <div class="pickup__actions">
          <a class="btn btn--primary pickup__btn" href={shop("/store")}>{ctaShopButton} <Icon name="arrow-right" size={20} /></a>
          {ctaButtonText && ctaButtonLink && (
            <a class="btn pickup__btn pickup__btn--outline" href={ctaButtonLink}>{ctaButtonText}</a>
          )}
        </div>
      </div>
      <div class="pickup__note">
        <p class="label">{shippingLabel}</p>
        <p>{shippingText}</p>
      </div>
    </section>
  </div>
</Layout>

<script>
  // Growkit-Auswahl: Karte wählen, passendes Detailfeld einblenden
  function initKits() {
    const root = document.querySelector<HTMLElement>("[data-kits]");
    if (!root) return;
    const buttons = root.querySelectorAll<HTMLButtonElement>("[data-kit-btn]");
    const panels = root.querySelectorAll<HTMLElement>("[data-kit-panel]");
    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const key = btn.dataset.kitBtn;
        buttons.forEach((b) =>
          b.setAttribute("aria-pressed", b === btn ? "true" : "false"),
        );
        panels.forEach((p) => {
          p.hidden = p.dataset.kitPanel !== key;
        });
      });
    });
  }
  initKits();
</script>

<style>
  .page {
    overflow-x: clip;
  }

  /* ── Hero ───────────────────────────────────────── */
  .hero {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 48px;
    /* Entwurf: content-box, 1280px Inhaltsbreite + 2 x Gutter */
    max-width: calc(var(--container, 1280px) + 2 * var(--gutter));
    margin-inline: auto;
    padding: 40px var(--gutter) 96px;
  }

  .hero__copy {
    flex: 1 1 520px;
    min-width: 0;
  }

  .hero__eyebrow {
    display: block;
    margin-bottom: 18px;
    font-size: 0.875rem;
    line-height: 1.4;
    color: var(--color-accent-dark);
  }

  .hero__title {
    display: block;
    font-size: clamp(3rem, 7.4vw, 7rem);
    line-height: 0.9;
    color: var(--color-accent);
  }

  .hero__lead {
    max-width: 38ch;
    margin: 24px 0 0;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 32px;
  }

  .hero__btn {
    padding: 16px 26px;
    font-size: 1.125rem;
  }

  .hero__btn--outline {
    background: transparent;
    color: var(--color-ink);
    box-shadow: none;
  }

  .hero__btn--outline:hover {
    background: var(--color-white);
  }

  .hero__media {
    position: relative;
    box-sizing: content-box;
    flex: 1 1 420px;
    min-width: 0;
    padding: 24px;
  }

  .hero__media .dots {
    position: absolute;
    inset: 0 40px 40px 0;
    border-radius: 0;
  }

  .hero__media :global(.hero__img) {
    position: relative;
    display: block;
    width: 100%;
    height: 520px;
    object-fit: cover;
    border: 3px solid var(--color-ink);
    border-radius: 0;
    box-shadow: var(--shadow-teaser);
    rotate: 2deg;
  }

  /* ── Kits (Band mit gerader Kante, wie im Entwurf) ── */
  .kits {
    padding: 88px var(--gutter);
    background: var(--color-paper);
    border-block: 3px solid var(--color-ink);
  }

  .kits__inner,
  .guide__inner {
    max-width: var(--container, 1280px);
    margin-inline: auto;
  }

  .kits h2 {
    margin-bottom: 40px;
  }

  .kits__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: 28px;
    margin-bottom: 40px;
  }

  .kit-card {
    --kit-bg: var(--color-paper);
    display: block;
    padding: 16px;
    background: var(--kit-bg);
    color: var(--color-ink);
    border: 3px solid var(--color-ink);
    border-radius: 0;
    box-shadow: 6px 6px 0 var(--color-ink);
    font: inherit;
    text-align: left;
    cursor: pointer;
    rotate: var(--rot, 0deg);
    transition:
      rotate 0.25s var(--ease-smooth, ease),
      translate 0.25s var(--ease-smooth, ease),
      box-shadow 0.25s var(--ease-smooth, ease);
  }

  .kit-card--pink { --kit-bg: var(--color-pink); }
  .kit-card--lavender { --kit-bg: var(--color-lavender); }
  .kit-card--olive-soft { --kit-bg: var(--color-olive-soft); }

  .kit-card:hover {
    translate: 0 -3px;
  }

  .kit-card[aria-pressed="true"] {
    rotate: 0deg;
    translate: 0 -6px;
    box-shadow: 10px 10px 0 var(--color-accent);
  }

  .kit-card:focus-visible {
    outline: 3px solid var(--color-ink);
    outline-offset: 4px;
  }

  .kit-card :global(.kit-card__img) {
    display: block;
    width: 100%;
    height: 240px;
    object-fit: cover;
    border: 3px solid var(--white);
    border-radius: 0;
  }

  .kit-card__name {
    display: block;
    margin: 14px 4px 2px;
    font-family: var(--font-display);
    font-weight: 900;
    font-variation-settings: "SOFT" 100;
    font-size: 1.875rem;
    line-height: 1.15;
  }

  .kit-card__level {
    display: block;
    margin: 0 4px 4px;
    font-size: 1rem;
  }

  /* Detailfeld */
  .kit-panel {
    display: flex;
    flex-wrap: wrap;
    gap: 40px;
    padding: 36px;
    background: var(--white);
    border: 3px solid var(--color-ink);
    border-radius: 0;
  }

  .kit-panel[hidden] {
    display: none;
  }

  .kit-panel__copy {
    flex: 1 1 320px;
    min-width: 0;
  }

  .kit-panel__label {
    margin-bottom: 8px;
  }

  .kit-panel__title {
    margin: 0 0 16px;
    font-family: var(--font-display);
    font-weight: 900;
    font-variation-settings: "SOFT" 100;
    font-size: 2.5rem;
    line-height: 1;
  }

  .kit-panel__intro {
    margin: 0;
    font-size: 1.125rem;
    line-height: 1.55;
  }

  .kit-panel__btn {
    margin-top: 24px;
  }

  .kit-panel__facts {
    display: grid;
    flex: 1 1 320px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    min-width: 0;
    margin: 0;
  }

  .kit-fact {
    min-width: 0;
    padding: 16px;
    border: 2px solid var(--color-ink);
    border-radius: 0;
  }

  .kit-fact--wide {
    grid-column: 1 / -1;
  }

  .kit-fact dt {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .kit-fact dd {
    margin: 6px 0 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.625rem;
    line-height: 1.2;
    overflow-wrap: anywhere;
  }

  .kit-fact dd.kit-fact__text,
  .kit-fact dd:has(ul) {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 17px;
    line-height: 1.5;
  }

  .kit-fact__text :global(p) {
    margin: 0 0 0.5rem;
  }

  .kit-fact__text :global(p:last-child) {
    margin-bottom: 0;
  }

  .kit-fact ul {
    margin: 0;
    padding-left: 1.2rem;
  }

  .kit-fact li {
    margin: 0.25rem 0;
  }

  /* ── Anleitung ──────────────────────────────────── */
  .guide {
    padding: 88px var(--gutter);
    background: var(--color-ink);
    color: var(--color-cream);
  }

  .guide__inner > h2 {
    margin-bottom: 12px;
    color: var(--color-accent-light);
  }

  .guide__intro {
    max-width: 52ch;
    margin: 0 0 16px;
    font-size: 1.1875rem;
    color: var(--color-paper);
  }

  .guide__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: 18px;
    margin: 40px 0 0;
    padding: 0;
    list-style: none;
  }

  .step {
    overflow: hidden;
    background: var(--color-cream);
    color: var(--color-ink);
    border-radius: 0;
  }

  .step :global(.step__media) {
    display: block;
    width: 100%;
    height: 150px;
    object-fit: cover;
    border-bottom: 3px solid var(--color-ink);
  }

  .step__placeholder {
    background:
      radial-gradient(rgba(28, 26, 51, 0.13) 1.4px, transparent 1.5px) 0 0 / 12px 12px,
      var(--ph);
  }

  .step__body {
    padding: 16px 18px 20px;
  }

  .step__num {
    margin: 0 0 4px;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-accent-dark);
  }

  .step__title {
    margin: 0 0 6px;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.5rem;
    line-height: 1.15;
  }

  .step__body :global(p:not(.step__num)) {
    margin: 0 0 0.6rem;
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  .step__body :global(p:last-child) {
    margin-bottom: 0;
  }

  /* ── Abholen / Versand ──────────────────────────── */
  .pickup {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    gap: 32px;
    max-width: var(--container, 1280px);
    margin-inline: auto;
    padding: 96px var(--gutter);
  }

  .pickup__card {
    flex: 1 1 420px;
    min-width: 0;
    padding: 36px;
    background: var(--color-lavender);
    border: 3px solid var(--color-ink);
    border-radius: 0;
    box-shadow: var(--shadow-card);
  }

  .pickup__title {
    margin-bottom: 12px;
    font-weight: 900;
    font-variation-settings: "SOFT" 100;
    font-size: 2.5rem;
    line-height: 1;
  }

  .pickup__card p {
    margin: 0 0 24px;
    font-size: 1.125rem;
    line-height: 1.5;
  }

  .pickup__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  .pickup__btn {
    padding: 16px 26px;
    font-size: 1.125rem;
  }

  .pickup__btn--outline {
    background: transparent;
    color: var(--color-ink);
    box-shadow: none;
  }

  .pickup__btn--outline:hover {
    background: var(--color-white);
  }

  .pickup__note {
    flex: 1 1 320px;
    min-width: 0;
    padding: 36px;
    background: var(--white);
    border: 3px dashed var(--color-ink);
    border-radius: 0;
  }

  .pickup__note .label {
    margin: 0 0 10px;
    color: var(--color-accent-dark);
  }

  .pickup__note p:last-child {
    margin: 0;
    font-size: 1.125rem;
    line-height: 1.5;
  }

  /* ── Responsive ─────────────────────────────────── */
  @media (max-width: 900px) {
    .hero {
      padding-bottom: 56px;
    }

    .hero__media :global(.hero__img) {
      height: 340px;
    }
  }

  @media (max-width: 768px) {
    .hero {
      gap: 32px;
    }

    .kits,
    .guide {
      padding-block: 56px;
    }

    .kit-panel {
      gap: 24px;
      padding: 22px 18px;
    }

    .kit-panel__title {
      font-size: 2rem;
    }

    .pickup {
      padding-block: 56px;
    }

    .pickup__card,
    .pickup__note {
      padding: 24px 20px;
    }

    .pickup__card {
      box-shadow: 6px 6px 0 var(--color-ink);
    }
  }

  @media (max-width: 480px) {
    .kit-fact dd {
      font-size: 1.375rem;
    }

    .kit-card[aria-pressed="true"] {
      box-shadow: 8px 8px 0 var(--color-accent);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__media :global(.hero__img),
    .kit-card {
      rotate: none;
    }

    .kit-card {
      transition: none;
    }
  }
</style>
