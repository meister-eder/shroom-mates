---
import { Image } from "astro:assets";
import { getCollection, getEntry, render } from "astro:content";
import Icon from "@shroom-mates/ui/Icon.astro";
import { linkBuilders } from "@shroom-mates/ui/site";
import bunteWelt from "../assets/images/fotos/bunte-pilze-oben.jpg";
import rosaLamellen from "../assets/images/fotos/rosa-lamellen.jpg";
import ProductCard from "../components/ProductCard.astro";
import Layout from "../layouts/Layout.astro";

const pageEntry = await getEntry("mushrooms-page", "content");
if (!pageEntry) {
	throw new Error("Mushrooms page content not found");
}

const {
	title,
	description,
	heroEyebrow,
	heroTitle,
	heroLead,
	heroImageAlt,
	freshTag,
	growkitLabel,
	emptyText,
	bandText,
	ctas,
} = pageEntry.data;

const { shop } = linkBuilders("website");

// Kartonfarbe und Growkit-Link je Sorte (Schlüssel = Dateiname der Sorte)
const GROWKIT_AUSTERN = shop("/store/austernseitlinge-growkit");
const meta: Record<
	string,
	{
		tone: "lavender" | "pink" | "olive-soft" | "stone" | "paper";
		kit?: string;
	}
> = {
	"rosa-austernpilze": { tone: "pink", kit: GROWKIT_AUSTERN },
	"2025-11-17-lions-mane": {
		tone: "lavender",
		kit: shop("/store/lions-mane-growkit"),
	},
	"2025-11-17-white-pearl": { tone: "olive-soft", kit: GROWKIT_AUSTERN },
	"2025-11-17-pioppino": { tone: "paper" },
	"2025-11-17-black-pearl": { tone: "stone" },
};

const mushroomsCollection = await getCollection("mushrooms");
const mushrooms = await Promise.all(
	mushroomsCollection
		.sort((a, b) => a.data.order - b.data.order)
		.map(async (entry) => {
			const { Content } = await render(entry);
			const m = meta[entry.id];
			return {
				title: entry.data.title,
				image: entry.data.image,
				imageAlt: entry.data.imageAlt,
				tone: m?.tone ?? "paper",
				latin: entry.data.latinName,
				badge: entry.data.badge,
				kit: m?.kit,
				Content,
				slug: entry.id,
			};
		}),
);

// Product Schema je Sorte (ohne offers: Frischware wird nicht online verkauft)
const productSchemas = mushrooms.map((mushroom) => ({
	"@context": "https://schema.org",
	"@type": "Product",
	name: mushroom.title,
	description: `Frische ${mushroom.title} aus nachhaltiger Zucht in Leipzig. Erhältlich auf dem Egenberger Samstagsmarkt.`,
	image: mushroom.image.src,
	brand: {
		"@type": "Brand",
		name: "shroom-mates",
	},
	category: "Edelpilze",
	isRelatedTo: {
		"@type": "Product",
		name: "Growkit",
		description: "Pilzzuchtset zum Selberziehen",
	},
}));
---

<Layout title={title} description={description} isLandingPage={true} active="pilze">
  {
    productSchemas.map((schema) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))
  }

  <div class="page">
    <section class="hero container">
      <div class="hero__copy">
        <h1>
          <span class="eyebrow hero__eyebrow">{heroEyebrow}</span>
          <span class="hero__title">{heroTitle}</span>
        </h1>
        <p class="lead hero__lead">{heroLead}</p>
      </div>
      <div class="hero__media">
        <div class="dots" aria-hidden="true"></div>
        <div class="arch-frame hero__arch">
          <Image
            src={bunteWelt}
            alt={heroImageAlt}
            widths={[320, 480, 640, 840]}
            sizes="(max-width: 768px) 80vw, 420px"
            loading="eager"
            format="webp"
          />
        </div>
      </div>
    </section>

    <section class="container sorten" aria-label="Pilzsorten">
      <div class="sorten__grid">
        {
          mushrooms.map((mushroom) => (
            <ProductCard
              title={mushroom.title}
              image={mushroom.image}
              imageAlt={mushroom.imageAlt}
              tone={mushroom.tone}
              subtitle={mushroom.latin}
              badge={mushroom.badge}
              id={mushroom.slug}
            >
              <mushroom.Content />
              <Fragment slot="actions">
                <span class="tag">{freshTag}</span>
                {mushroom.kit && (
                  <a class="tag" href={mushroom.kit}>
                    {growkitLabel} <Icon name="arrow-right" size={16} />
                  </a>
                )}
              </Fragment>
            </ProductCard>
          ))
        }
      </div>

      {
        mushrooms.length === 0 && (
          <p class="no-content">{emptyText}</p>
        )
      }
    </section>

    <section class="band" aria-label="Bildband">
      <Image
        src={rosaLamellen}
        alt=""
        class="band__img"
        widths={[640, 1024, 1600]}
        sizes="100vw"
        loading="lazy"
        format="webp"
      />
      <div class="container band__inner">
        <p class="speech-bubble band__bubble">{bandText}</p>
      </div>
    </section>

    <section class="container ctas" aria-label="Pilze bekommen">
      {
        ctas.map((cta, i) => (
          <a class={`cta ${i === 0 ? "cta--accent" : "cta--white"}`} href={cta.link}>
            <span class={i === 0 ? "label" : "label cta__label"}>{cta.label}</span>
            <h2 class="cta__title">{cta.title} <Icon name="arrow-right" size={32} strokeWidth={3} /></h2>
            <p>{cta.text}</p>
          </a>
        ))
      }
    </section>
  </div>
</Layout>

<style>
  .page {
    padding-top: var(--navbar-height);
    overflow-x: clip;
  }

  /* ── Hero ───────────────────────────────────────── */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    align-items: center;
    gap: 40px;
    padding-top: 32px;
    padding-bottom: 64px;
  }

  .hero__eyebrow {
    display: block;
    margin-bottom: 18px;
    font-size: 0.875rem;
    line-height: 1.4;
    color: var(--color-accent-dark);
  }

  .hero__title {
    display: block;
    font-size: clamp(3rem, 8vw, 7.5rem);
    line-height: 0.9;
    color: var(--color-accent);
  }

  .hero__lead {
    max-width: 44ch;
    margin: 24px 0 0;
  }

  .hero__media {
    position: relative;
    padding: 24px;
  }

  .hero__media .dots {
    position: absolute;
    inset: 30px 0 0 50px;
    border-radius: 50%;
  }

  .hero__arch {
    position: relative;
    width: 100%;
    max-width: 420px;
    height: 480px;
    margin: 0 auto;
    box-shadow: var(--shadow-teaser);
  }

  /* ── Sorten ─────────────────────────────────────── */
  .sorten {
    padding-bottom: 112px;
  }

  .sorten__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 330px), 1fr));
    gap: 48px 36px;
    align-items: stretch;
  }

  .no-content {
    padding: 4rem 0;
    text-align: center;
    font-size: 1.2rem;
  }

  /* ── Bildband ───────────────────────────────────── */
  .band {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: 520px;
    padding: 48px 0;
    background: var(--color-ink);
    border-block: 3px solid var(--color-ink);
    overflow: hidden;
  }

  .band :global(.band__img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .band__inner {
    position: relative;
  }

  .band__bubble {
    max-width: 22ch;
    padding: 22px 28px;
    box-shadow: 6px 6px 0 var(--color-accent);
    font-family: var(--font-display);
    font-weight: 900;
    font-variation-settings: "SOFT" 100, "WONK" 1;
    font-size: clamp(1.75rem, 3.6vw, 3rem);
    line-height: 1;
    rotate: -2deg;
  }

  /* ── Weiter-Karten ──────────────────────────────── */
  .ctas {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: 32px;
    padding-top: 96px;
    padding-bottom: 96px;
  }

  .cta {
    display: block;
    padding: 36px;
    color: var(--color-ink);
    text-decoration: none;
    border: 3px solid var(--color-ink);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
    transition: transform 0.2s ease;
  }

  .cta:hover {
    transform: translateY(-4px);
  }

  .cta--accent {
    background: var(--color-accent);
  }

  .cta--white {
    background: #fff;
  }

  .cta__label {
    color: var(--color-accent-dark);
  }

  .cta .label {
    display: block;
    margin-bottom: 10px;
  }

  .cta__title {
    margin: 0 0 12px;
    font-size: clamp(1.9rem, 3vw, 2.5rem);
    line-height: 1;
  }

  .cta__title :global(svg) {
    vertical-align: -0.1em;
  }

  .cta p {
    margin: 0;
    font-size: 1.0625rem;
  }

  /* ── Responsive ─────────────────────────────────── */
  @media (max-width: 900px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      padding-bottom: 48px;
    }

    .hero__arch {
      height: 380px;
    }
  }

  @media (max-width: 768px) {
    .sorten {
      padding-bottom: 64px;
    }

    .band {
      min-height: 380px;
    }

    .ctas {
      padding-top: 56px;
      padding-bottom: 56px;
    }

    .cta {
      padding: 24px 20px;
      box-shadow: 6px 6px 0 var(--color-ink);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .band__bubble {
      rotate: none;
    }

    .cta:hover {
      transform: none;
    }
  }
</style>
