---
import { Image } from "astro:assets";
import { getEntry } from "astro:content";
import Icon from "@shroom-mates/ui/Icon.astro";
import Layout from "../layouts/Layout.astro";

const gastroPageEntry = await getEntry("gastronomie-page", "content");
if (!gastroPageEntry) {
	throw new Error("Gastronomie page content not found");
}

const {
	title,
	description,
	heroEyebrow,
	heroTitle,
	heroSubtitle,
	heroButton,
	heroPhotos,
	heroImage,
	introTitle,
	introText,
	introText2,
	sortenTitle,
	sorten,
	vorteileTitle,
	vorteile,
	ctaTitle,
	ctaText,
	ctaEmail,
} = gastroPageEntry.data;

const gastroSchema = {
	"@context": "https://schema.org",
	"@type": "Service",
	name: "Pilzlieferung für Gastronomie in Leipzig",
	description:
		"Regelmäßige Lieferung frischer Edelpilze an Restaurants, Cafés und Gastronomiebetriebe in Leipzig und Umgebung.",
	provider: {
		"@type": "LocalBusiness",
		name: "shroom-mates",
		address: {
			"@type": "PostalAddress",
			streetAddress: "Franz-Flemming-Straße 25",
			addressLocality: "Leipzig",
			addressRegion: "Sachsen",
			postalCode: "04179",
			addressCountry: "DE",
		},
	},
	areaServed: {
		"@type": "City",
		name: "Leipzig",
	},
	serviceType: "Edelpilz-Lieferung",
};
---

<Layout title={title} description={description} ogImage={heroImage?.src} active="gastro" isLandingPage>
  <script type="application/ld+json" set:html={JSON.stringify(gastroSchema)} />

  <div class="gastro-page">
    <section class="gastro-hero">
      <div class="container gastro-hero__inner">
        <div class="gastro-hero__copy">
          <h1 class="eyebrow gastro-hero__eyebrow">{heroEyebrow}</h1>
          <p class="gastro-hero__title">{heroTitle}</p>
          {heroSubtitle && <p class="gastro-hero__lead">{heroSubtitle}</p>}
          <a class="btn btn--accent gastro-hero__cta" href="#anfrage">{heroButton}</a>
        </div>
        <div class="gastro-hero__photos">
          {
            heroPhotos.map((photo, i) => (
              <Image
                src={photo.image}
                alt={photo.imageAlt}
                class={i === 0 ? "gastro-hero__img gastro-hero__img--tall" : "gastro-hero__img"}
                widths={[320, 480, 640]}
                sizes="(max-width: 900px) 50vw, 280px"
                loading="eager"
                format="webp"
              />
            ))
          }
        </div>
      </div>
    </section>

    <section class="container gastro-intro" aria-labelledby="intro-heading">
      <h2 id="intro-heading" class="text-accent">{introTitle}</h2>
      <div class="gastro-intro__text">
        <p class="lead">{introText}</p>
        {introText2 && <p class="lead">{introText2}</p>}
      </div>
    </section>

    <section class="container gastro-sorten" aria-labelledby="sorten-heading">
      <h2 id="sorten-heading" class="text-accent">{sortenTitle}</h2>
      <p class="sr-only">Unser Sortiment für die Gastronomie</p>
      <ul class="sorten-grid" role="list">
        {
          sorten.map((sorte) => (
            <li>
              <figure class="sorte">
                <div class="arch-frame sorte__frame">
                  <Image
                    src={sorte.image}
                    alt={sorte.imageAlt}
                    widths={[320, 480, 640]}
                    sizes="(max-width: 768px) 90vw, 280px"
                    format="webp"
                  />
                </div>
                <figcaption>
                  <h3 class="sorte__title">{sorte.title}</h3>
                  <p>{sorte.description}</p>
                </figcaption>
              </figure>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="section section--night section--no-border vorteile" aria-labelledby="vorteile-heading">
      <div class="container vorteile__inner">
        <h2 id="vorteile-heading">{vorteileTitle}</h2>
        <ul class="vorteile__list" role="list">
          {
            vorteile.map((vorteil) => (
              <li>
                <Icon name="check" size={28} strokeWidth={3} class="vorteile__icon" />
                <span set:html={vorteil} />
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section id="anfrage" class="container gastro-cta" aria-labelledby="cta-heading">
      <div class="gastro-cta__box">
        <div class="gastro-cta__copy">
          <h2 id="cta-heading">{ctaTitle}</h2>
          <p class="lead">{ctaText}</p>
          {
            ctaEmail && (
              <a class="gastro-cta__mail" href={`mailto:${ctaEmail}`}>
                {ctaEmail}
              </a>
            )
          }
        </div>
        <form method="POST" id="form" class="gastro-form">
          <input type="hidden" name="access_key" value="d69f2b91-fe55-4258-97a9-6bb53285b5e2" />
          <input type="hidden" name="subject" value="Gastronomie-Anfrage über shroom-mates.de" />
          <input type="hidden" name="topic" value="Gastronomie" />
          <div class="field">
            <label for="g-name">Name</label>
            <input id="g-name" type="text" name="name" autocomplete="name" required />
          </div>
          <div class="field">
            <label for="g-betrieb">Betrieb</label>
            <input id="g-betrieb" type="text" name="betrieb" autocomplete="organization" />
          </div>
          <div class="field gastro-form__wide">
            <label for="g-mail">E-Mail</label>
            <input id="g-mail" type="email" name="email" autocomplete="email" required />
          </div>
          <div class="field gastro-form__wide">
            <label for="g-bedarf">Was brauchst du?</label>
            <textarea id="g-bedarf" name="message" rows="3" placeholder="Sorten, Menge, Rhythmus" required></textarea>
          </div>
          <button type="submit" class="btn btn--primary gastro-form__submit">Anfrage senden</button>
          <div id="result" class="gastro-form__result gastro-form__wide" role="status" aria-live="polite"></div>
        </form>
      </div>
    </section>

    <script>
      import "../scripts/contact-form.ts";
    </script>
  </div>
</Layout>

<style>
  .gastro-page {
    padding-top: var(--navbar-height);
    overflow-x: clip;
  }

  /* ── Hero (dunkles Band) ────────────────────────── */
  .gastro-hero {
    margin-top: 0;
    padding: 80px 0;
    background: var(--color-night);
    color: var(--color-paper);
  }

  .gastro-hero__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 48px;
  }

  .gastro-hero__copy {
    flex: 1 1 540px;
    min-width: 0;
  }

  .gastro-hero__eyebrow {
    margin-bottom: 18px;
    font-size: 0.875rem;
    line-height: 1.5;
    color: #ff7a45;
  }

  .gastro-hero__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 900;
    font-variation-settings: "SOFT" 100, "WONK" 1;
    font-size: clamp(48px, 7.4vw, 112px);
    line-height: 0.9;
    color: var(--color-accent);
    text-wrap: balance;
  }

  .gastro-hero__lead {
    max-width: 42ch;
    margin: 24px 0 0;
    font-size: 1.3125rem;
    line-height: 1.5;
    color: #bfc1ea;
  }

  .gastro-hero__cta {
    margin-top: 32px;
    padding: 16px 26px;
    border: 0;
    font-size: 1.125rem;
    box-shadow: 4px 4px 0 var(--color-paper);
  }

  .gastro-hero__cta:hover {
    box-shadow: 2px 2px 0 var(--color-paper);
  }

  .gastro-hero__photos {
    flex: 1 1 400px;
    min-width: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .gastro-hero__photos :global(.gastro-hero__img) {
    width: 100%;
    height: 182px;
    object-fit: cover;
    border: 3px solid var(--color-paper);
    border-radius: 0;
    box-sizing: border-box;
  }

  .gastro-hero__photos :global(.gastro-hero__img--tall) {
    grid-row: span 2;
    height: 380px;
  }

  /* ── Intro ──────────────────────────────────────── */
  .gastro-intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    gap: 24px 64px;
    align-items: start;
    padding-top: 96px;
  }

  .gastro-intro__text p {
    margin: 0 0 1rem;
  }

  /* ── Sortiment: Foto-Karten mit Bildunterschrift ── */
  .gastro-sorten {
    padding-top: 96px;
    padding-bottom: 96px;
  }

  .gastro-sorten > h2 {
    margin-bottom: 40px;
  }

  .sorten-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: 40px 28px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .sorte {
    margin: 0;
  }

  .sorte__frame {
    aspect-ratio: 3 / 4;
  }

  .sorte__frame :global(img) {
    height: 100%;
  }

  .sorte figcaption {
    padding: 20px 4px 0;
  }

  .sorte__title {
    margin: 0 0 6px;
    font-family: var(--font-display);
    font-weight: 900;
    font-variation-settings: "SOFT" 100;
    font-size: 1.875rem;
  }

  .sorte figcaption p {
    margin: 0;
    font-size: 1rem;
    line-height: 1.5;
  }

  /* ── Vorteile (dunkles Band) ────────────────────── */
  .vorteile {
    padding: 88px 0;
    background: var(--color-ink);
    color: var(--color-cream);
  }

  .vorteile__inner > h2 {
    margin-bottom: 40px;
    color: var(--color-accent-light);
  }

  .vorteile__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: 18px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .vorteile__list li {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    padding: 20px;
    background: var(--color-cream);
    color: var(--color-ink);
    border-radius: 0;
    font-size: 1.0625rem;
    line-height: 1.45;
  }

  .vorteile__list :global(.vorteile__icon) {
    flex: none;
    color: var(--color-accent-dark);
  }

  /* ── Anfrage ────────────────────────────────────── */
  .gastro-cta {
    padding-top: 96px;
    padding-bottom: 96px;
  }

  .gastro-cta__box {
    display: flex;
    flex-wrap: wrap;
    gap: 48px;
    padding: 48px;
    background: var(--color-accent);
    color: var(--color-ink);
    border: 3px solid var(--color-ink);
    border-radius: 0;
    box-shadow: var(--shadow-teaser);
  }

  .gastro-cta__copy {
    flex: 1 1 320px;
    min-width: 0;
  }

  .gastro-cta__box h2 {
    margin-bottom: 16px;
    font-size: clamp(40px, 5vw, 64px);
  }

  .gastro-cta__box .lead {
    max-width: 44ch;
    margin: 0 0 16px;
    font-size: 1.1875rem;
  }

  .gastro-cta__mail {
    color: var(--color-ink);
    font-size: 1.1875rem;
    font-weight: 700;
    overflow-wrap: anywhere;
  }

  .gastro-cta__mail:hover {
    color: var(--color-cream);
  }

  .gastro-form {
    flex: 1 1 420px;
    min-width: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    align-content: start;
  }

  .gastro-form__wide {
    grid-column: 1 / -1;
  }

  .gastro-form .field input,
  .gastro-form .field textarea {
    padding: 14px 16px;
    font-size: 1.0625rem;
  }

  .gastro-form__submit {
    grid-column: 1 / -1;
    justify-self: start;
    padding: 16px 28px;
    border: 0;
    font-size: 1.125rem;
    box-shadow: none;
  }

  .gastro-form__submit:hover {
    background: var(--color-night);
  }

  .gastro-form__result {
    font-weight: 600;
  }

  .gastro-form__result:empty {
    display: none;
  }

  @media (max-width: 900px) {
    .gastro-intro {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 768px) {
    .gastro-hero {
      padding: 40px 0 56px;
    }

    .gastro-hero__photos :global(.gastro-hero__img) {
      height: 150px;
    }

    .gastro-hero__photos :global(.gastro-hero__img--tall) {
      height: 316px;
    }

    .gastro-intro,
    .gastro-sorten,
    .gastro-cta {
      padding-top: 56px;
    }

    .gastro-sorten,
    .gastro-cta {
      padding-bottom: 56px;
    }

    .gastro-cta__box {
      gap: 32px;
      padding: 28px 20px;
      box-shadow: 6px 6px 0 var(--color-ink);
    }

    .vorteile {
      padding: 56px 0;
    }

    .gastro-form {
      grid-template-columns: minmax(0, 1fr);
    }

    .gastro-form__submit {
      justify-self: stretch;
    }
  }
</style>
