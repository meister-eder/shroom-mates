---
import { Image } from "astro:assets";
import { getEntry } from "astro:content";
import Icon from "@shroom-mates/ui/Icon.astro";
import bunteWelt from "../assets/images/fotos/bunte-pilze-oben.jpg";
import marktstand from "../assets/images/fotos/marktstand-lions-mane.jpg";
import schneidebrett from "../assets/images/fotos/schneidebrett.jpg";
import blackPearl from "../assets/images/fotos/black-pearl.jpg";
import lionsMane from "../assets/images/fotos/lions-mane-makro.jpg";
import pioppino from "../assets/images/fotos/pioppino.jpg";
import rosaLamellen from "../assets/images/fotos/rosa-lamellen.jpg";
import Layout from "../layouts/Layout.astro";

const gastroPageEntry = await getEntry("gastronomie-page", "content");
if (!gastroPageEntry) {
	throw new Error("Gastronomie page content not found");
}

const {
	title,
	description,
	heroTitle,
	heroSubtitle,
	heroImage,
	introTitle,
	introText,
	introText2,
	sorten,
	vorteile,
	ctaTitle,
	ctaText,
	ctaButtonText,
	ctaButtonLink,
	ctaEmail,
} = gastroPageEntry.data;

// Foto + Alt-Text je Sorte (Schlüssel = Titel aus dem Content); Fallback: Saisonsorten
const sortenFotos: Record<string, { image: ImageMetadata; alt: string }> = {
	Austernpilze: { image: rosaLamellen, alt: "Rosa Austernpilze am Block" },
	"Lion's Mane": { image: lionsMane, alt: "Lion's Mane in Nahaufnahme" },
	Pioppino: { image: pioppino, alt: "Pioppino-Büschel" },
	Saisonsorten: { image: blackPearl, alt: "Black Pearl, eine Saisonsorte" },
};
const fallbackFoto = { image: blackPearl, alt: "" };

const gastroSchema = {
	"@context": "https://schema.org",
	"@type": "Service",
	name: "Pilzlieferung für Gastronomie in Leipzig",
	description:
		"Regelmäßige Lieferung frischer Edelpilze an Restaurants, Cafés und Gastronomiebetriebe in Leipzig und Umgebung.",
	provider: {
		"@type": "LocalBusiness",
		name: "shroom-mates",
		address: {
			"@type": "PostalAddress",
			streetAddress: "Franz-Flemming-Straße 25",
			addressLocality: "Leipzig",
			addressRegion: "Sachsen",
			postalCode: "04179",
			addressCountry: "DE",
		},
	},
	areaServed: {
		"@type": "City",
		name: "Leipzig",
	},
	serviceType: "Edelpilz-Lieferung",
};
---

<Layout title={title} description={description} ogImage={heroImage?.src} active="gastro" isLandingPage>
  <script type="application/ld+json" set:html={JSON.stringify(gastroSchema)} />

  <div class="gastro-page">
    <section class="gastro-hero">
      <div class="container gastro-hero__inner">
        <div class="gastro-hero__copy">
          <h1 class="eyebrow eyebrow--on-dark gastro-hero__eyebrow">Pilze für Gastronomie in Leipzig</h1>
          <p class="gastro-hero__title">{heroTitle}</p>
          {heroSubtitle && <p class="gastro-hero__lead">{heroSubtitle}</p>}
          <a class="btn btn--accent gastro-hero__cta" href="#anfrage">Angebot anfragen</a>
        </div>
        <div class="gastro-hero__photos">
          <Image
            src={bunteWelt}
            alt="Austernpilze in Gelb, Rosa und Weiß mit Lion's Mane"
            class="gastro-hero__img gastro-hero__img--tall"
            widths={[320, 480, 640]}
            sizes="(max-width: 900px) 50vw, 280px"
            loading="eager"
            format="webp"
          />
          <Image
            src={marktstand}
            alt="Korb mit Lion's Mane am Marktstand"
            class="gastro-hero__img"
            widths={[320, 480, 640]}
            sizes="(max-width: 900px) 50vw, 280px"
            loading="eager"
            format="webp"
          />
          <Image
            src={schneidebrett}
            alt="Pioppino und Seitlinge auf dem Schneidebrett"
            class="gastro-hero__img"
            widths={[320, 480, 640]}
            sizes="(max-width: 900px) 50vw, 280px"
            loading="eager"
            format="webp"
          />
        </div>
      </div>
    </section>

    <section class="container gastro-intro" aria-labelledby="intro-heading">
      <h2 id="intro-heading" class="text-accent">{introTitle}</h2>
      <div class="gastro-intro__text">
        <p class="lead">{introText}</p>
        {introText2 && <p class="lead">{introText2}</p>}
      </div>
    </section>

    <section class="container gastro-sorten" aria-labelledby="sorten-heading">
      <h2 id="sorten-heading" class="text-accent">Was auf den Teller kommt</h2>
      <p class="sr-only">Unser Sortiment für die Gastronomie</p>
      <ul class="sorten-grid" role="list">
        {
          sorten.map((sorte) => {
            const foto = sortenFotos[sorte.title] ?? fallbackFoto;
            return (
              <li>
                <figure class="sorte">
                  <div class="arch-frame sorte__frame">
                    <Image
                      src={foto.image}
                      alt={foto.alt}
                      widths={[320, 480, 640]}
                      sizes="(max-width: 768px) 90vw, 280px"
                      format="webp"
                    />
                  </div>
                  <figcaption>
                    <h3 class="sorte__title">{sorte.title}</h3>
                    <p>{sorte.description}</p>
                  </figcaption>
                </figure>
              </li>
            );
          })
        }
      </ul>
    </section>

    <section class="section section--night vorteile" aria-labelledby="vorteile-heading">
      <div class="container vorteile__inner">
        <h2 id="vorteile-heading">Warum shroom-mates?</h2>
        <ul class="vorteile__list" role="list">
          {
            vorteile.map((vorteil) => (
              <li>
                <Icon name="check" size={28} strokeWidth={3} class="vorteile__icon" />
                <span set:html={vorteil} />
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section id="anfrage" class="container gastro-cta" aria-labelledby="cta-heading">
      <div class="gastro-cta__box">
        <h2 id="cta-heading">{ctaTitle}</h2>
        <p class="lead">{ctaText}</p>
        <div class="gastro-cta__actions">
          <a href={ctaButtonLink} class="btn btn--primary">{ctaButtonText}</a>
          {
            ctaEmail && (
              <a class="gastro-cta__mail" href={`mailto:${ctaEmail}`}>
                {ctaEmail}
              </a>
            )
          }
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .gastro-page {
    padding-top: var(--navbar-height);
    overflow-x: clip;
  }

  /* ── Hero (dunkles Band) ────────────────────────── */
  .gastro-hero {
    margin-top: 0;
    padding: 64px 0 72px;
    background: var(--color-night);
    color: var(--color-paper);
    border-bottom: 3px solid var(--color-ink);
  }

  .gastro-hero__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 48px;
  }

  .gastro-hero__copy {
    flex: 1 1 480px;
    min-width: 0;
  }

  .gastro-hero__eyebrow {
    margin-bottom: 18px;
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .gastro-hero__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 900;
    font-variation-settings: "SOFT" 100, "WONK" 1;
    font-size: clamp(44px, 7.4vw, 112px);
    line-height: 0.9;
    color: var(--color-accent);
    text-wrap: balance;
  }

  .gastro-hero__lead {
    max-width: 42ch;
    margin: 24px 0 0;
    font-size: 1.3125rem;
    line-height: 1.5;
    color: #cfcab4;
  }

  .gastro-hero__cta {
    margin-top: 32px;
    box-shadow: 4px 4px 0 var(--color-paper);
  }

  .gastro-hero__photos {
    flex: 1 1 340px;
    min-width: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .gastro-hero__photos :global(.gastro-hero__img) {
    width: 100%;
    height: 182px;
    object-fit: cover;
    border: 3px solid var(--color-paper);
    border-radius: 20px;
    box-sizing: border-box;
  }

  .gastro-hero__photos :global(.gastro-hero__img--tall) {
    grid-row: span 2;
    height: 380px;
  }

  /* ── Intro ──────────────────────────────────────── */
  .gastro-intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    gap: 24px 64px;
    align-items: start;
    padding-top: 96px;
  }

  .gastro-intro__text p {
    margin: 0 0 1rem;
  }

  /* ── Sortiment: Foto-Karten mit Bildunterschrift ── */
  .gastro-sorten {
    padding-top: 96px;
    padding-bottom: 96px;
  }

  .gastro-sorten > h2 {
    margin-bottom: 40px;
  }

  .sorten-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: 40px 28px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .sorte {
    margin: 0;
  }

  .sorte__frame {
    aspect-ratio: 3 / 4;
  }

  .sorte__frame :global(img) {
    height: 100%;
  }

  .sorte figcaption {
    padding: 20px 4px 0;
  }

  .sorte__title {
    margin: 0 0 6px;
    font-family: var(--font-display);
    font-weight: 900;
    font-variation-settings: "SOFT" 100;
    font-size: 1.875rem;
  }

  .sorte figcaption p {
    margin: 0;
    font-size: 1rem;
    line-height: 1.5;
  }

  /* ── Vorteile (dunkles Band) ────────────────────── */
  .vorteile__inner > h2 {
    margin-bottom: 40px;
    color: var(--color-accent-light);
  }

  .vorteile__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: 18px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .vorteile__list li {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    padding: 20px;
    background: var(--color-cream);
    color: var(--color-ink);
    border-radius: 18px;
    font-size: 1.0625rem;
    line-height: 1.45;
  }

  .vorteile__list :global(.vorteile__icon) {
    flex: none;
    color: var(--color-accent-dark);
  }

  /* ── Anfrage ────────────────────────────────────── */
  .gastro-cta {
    padding-top: 96px;
    padding-bottom: 96px;
  }

  .gastro-cta__box {
    padding: 48px;
    background: var(--color-accent);
    color: var(--color-ink);
    border: 3px solid var(--color-ink);
    border-radius: 32px;
    box-shadow: var(--shadow-teaser);
  }

  .gastro-cta__box h2 {
    max-width: 14ch;
    margin-bottom: 16px;
    font-size: clamp(40px, 5vw, 64px);
  }

  .gastro-cta__box .lead {
    max-width: 44ch;
    margin: 0 0 28px;
  }

  .gastro-cta__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 28px;
  }

  .gastro-cta__box .btn--primary {
    box-shadow: 4px 4px 0 var(--color-cream);
  }

  .gastro-cta__mail {
    color: var(--color-ink);
    font-size: 1.1875rem;
    font-weight: 700;
    overflow-wrap: anywhere;
  }

  @media (max-width: 900px) {
    .gastro-intro {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 768px) {
    .gastro-hero {
      padding: 40px 0 56px;
    }

    .gastro-hero__photos :global(.gastro-hero__img) {
      height: 150px;
    }

    .gastro-hero__photos :global(.gastro-hero__img--tall) {
      height: 316px;
    }

    .gastro-intro,
    .gastro-sorten,
    .gastro-cta {
      padding-top: 56px;
    }

    .gastro-sorten,
    .gastro-cta {
      padding-bottom: 56px;
    }

    .gastro-cta__box {
      padding: 28px 20px;
      border-radius: 24px;
      box-shadow: 6px 6px 0 var(--color-ink);
    }
  }
</style>
