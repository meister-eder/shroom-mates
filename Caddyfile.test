# ── Test Caddyfile (self-signed TLS) ─────────────────────────
# Accept the cert warning in your browser once

shroom-mates.159.195.31.11.sslip.io {
	tls internal
	# Test server: keep it out of search engines
	header X-Robots-Tag "noindex, nofollow"
	root * /srv/website
	file_server
	try_files {path} {path}.html {path}/index.html

	# Branded 404 page from the static build
	handle_errors 404 {
		root * /srv/website
		rewrite * /404.html
		file_server
	}
}

shop.159.195.31.11.sslip.io {
	tls internal
	# Test server: keep it out of search engines
	header X-Robots-Tag "noindex, nofollow"
	reverse_proxy storefront:4321 {
		header_up Host {http.request.host}
		header_up X-Forwarded-Proto https
	}
}

api.159.195.31.11.sslip.io {
	tls internal
	# Test server: keep it out of search engines
	header X-Robots-Tag "noindex, nofollow"
	reverse_proxy medusa:9000
}
