# One config for every server environment. The caddy service gets:
#   DOMAIN      site host, e.g. staging.shroom-mates.de or shroom-mates.de
#   ROBOTS_TAG  X-Robots-Tag for the site ("noindex, nofollow" before go-live, else "all")
#   CSP_HEADER  Content-Security-Policy (enforced, default) or
#               Content-Security-Policy-Report-Only (violations only logged in the browser)
# Hosts: {$DOMAIN} (site + shop), api.{$DOMAIN} (Medusa), shop.{$DOMAIN} (old shop
# URLs, redirects only), www.{$DOMAIN} (redirect). Certificates come from Let's
# Encrypt automatically (needs DNS for all four names pointing at the server).

# Old shop URLs (former shop host, country prefix) -> new paths on the main
# host. 301, query string kept (SumUp sends buyers back to /de/checkout/complete?...).
# /de/ lands on the homepage, anything else unmapped on the shop index.
(legacy_shop) {
	route {
		@new path /shop /shop/*
		redir @new {args[0]}{uri} 301

		@home path /de /de/
		redir @home {args[0]}/ 301

		@store path /de/store /de/store/
		rewrite @store /shop/
		@product path_regexp product ^/de/store/([^/]+)/?$
		rewrite @product /shop/{re.product.1}/
		@cart path /de/cart /de/cart/
		rewrite @cart /shop/cart/
		@complete path /de/checkout/complete /de/checkout/complete/
		rewrite @complete /shop/checkout/complete/
		@checkout path /de/checkout /de/checkout/
		rewrite @checkout /shop/checkout/
		@order path_regexp order ^/de/order/([^/]+)/?$
		rewrite @order /shop/order/{re.order.1}/
		@legal path_regexp legal ^/de/(agb|widerruf|gewaehrleistung|vertrag-widerrufen|datenschutz)/?$
		rewrite @legal /{re.legal.1}/

		@mapped path /shop/* /agb/ /widerruf/ /gewaehrleistung/ /vertrag-widerrufen/ /datenschutz/
		redir @mapped {args[0]}{uri} 301
		redir {args[0]}/shop/ 301
	}
}

# Privacy-friendly JSON access log: IPs masked (IPv4 /16, IPv6 /32), no cookies or
# credentials, rolled daily and kept for 30 days (roll_interval needs Caddy >= 2.11).
(access_log) {
	log {
		output file /var/log/caddy/access.log {
			roll_interval 24h
			roll_keep 40
			roll_keep_for 720h
		}
		format filter {
			wrap json
			request>remote_ip ip_mask {
				ipv4 16
				ipv6 32
			}
			request>client_ip ip_mask {
				ipv4 16
				ipv6 32
			}
			request>headers>X-Forwarded-For ip_mask {
				ipv4 16
				ipv6 32
			}
			request>headers>Cookie delete
			request>headers>Authorization delete
			resp_headers>Set-Cookie delete
		}
	}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "{args[0]}"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}
}

# ── Site + Shop (Astro: prerendered pages and SSR shop, one app) ──
{$DOMAIN} {
	import access_log
	import security_headers SAMEORIGIN

	# Umami: only the tracker script and the collect endpoint are public (names set via
	# TRACKER_SCRIPT_NAME / COLLECT_API_ENDPOINT on the umami service). The dashboard
	# is not routed: it is reachable only through an SSH tunnel to 127.0.0.1:3001.
	@umami path /stats/s.js /stats/e
	handle @umami {
		reverse_proxy umami:3000
	}
	handle {
		reverse_proxy web:4321
	}

	# Cache static assets aggressively
	@assets path /assets/* /_astro/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# CSP: site + SumUp widget + Medusa API + web3forms + Google map frame
	# (everything except the CMS admin). The sha256 hashes allow Astro's inline
	# island scripts on pages with React islands: the astro-island runtime and the
	# loaders for client:idle, load, media, only, visible (in that order). They only
	# change with an Astro update; e2e/smoke/csp.spec.ts then fails and prints the new ones.
	@notadmin not path /admin /admin/*
	header @notadmin {
		{$CSP_HEADER:Content-Security-Policy} "default-src 'self'; script-src 'self' 'sha256-QJZDUlo/qa5AJCrG6vHyWcatjwCeWidEHQfJc601lzw=' 'sha256-BF0290pkb3jxQsE7z00xR8Imp8X34FLC88L0lkMnrGw=' 'sha256-QzWFZi+FLIx23tnm9SBU4aEgx4x8DsuASP07mfqol/c=' 'sha256-0chmwFk0zaA528yFfGV7J9ppIpdfTPPULncDF3WG7Zs=' 'sha256-eIXWvAmxkr251LJZkjniEK5LcPF3NkapbJepohwYRIc=' 'sha256-Q2BPg90ZMplYY+FSdApNErhpWafg2hcRRbndmvxuL/Q=' https://gateway.sumup.com; style-src 'self' 'unsafe-inline'; img-src 'self' https: data:; connect-src 'self' https://api.{$DOMAIN} https://api.web3forms.com; frame-src https://gateway.sumup.com https://www.google.com; font-src 'self'"
		X-Robots-Tag "{$ROBOTS_TAG:all}"
	}

	# Sveltia CMS admin (/admin/): talks to the GitHub API, previews use blob: URLs.
	# The bundle is self-hosted, but Sveltia lazy-loads some libraries (Immutable.js
	# for preview templates) and its locales from unpkg, its fonts from jsdelivr and
	# checks githubstatus.com; the logo is fetched as a data: URL.
	# Declared after the cache rules above so its Cache-Control wins.
	@admin path /admin /admin/*
	header @admin {
		{$CSP_HEADER:Content-Security-Policy} "default-src 'self'; script-src 'self' https://unpkg.com; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data: https:; media-src 'self' blob: https:; connect-src 'self' data: https://api.github.com https://raw.githubusercontent.com https://*.githubusercontent.com https://unpkg.com https://www.githubstatus.com; frame-src 'self' blob: about:; worker-src 'self' blob:; font-src 'self' https://cdn.jsdelivr.net; object-src 'none'; base-uri 'self'; form-action 'self'"
		Cache-Control "no-cache"
		X-Robots-Tag "noindex, nofollow"
	}

	encode gzip zstd
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} 308
}

# ── Old shop host: redirects only ────────────────────────────
shop.{$DOMAIN} {
	import legacy_shop https://{$DOMAIN}
	import security_headers SAMEORIGIN
	header X-Robots-Tag "{$ROBOTS_TAG:all}"
	encode gzip zstd
}

# ── Medusa Backend + Admin ───────────────────────────────────
api.{$DOMAIN} {
	reverse_proxy medusa:9000
	import security_headers DENY
	header X-Robots-Tag "noindex, nofollow"
	encode gzip zstd
}
